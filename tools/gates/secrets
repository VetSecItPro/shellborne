#!/usr/bin/env python3
"""Secrets gate: refuse credentials in staged files or in any commit of a range.

Usage:
    secrets staged <repo>            before a commit
    secrets commits <repo> <range>   before a push and in CI

Runs gitleaks at the pinned version with this folder's gitleaks.toml, never a config from the
scanned tree. Exit 0 clean, 1 refused, 2 broken. A missing or different gitleaks is broken, never a
pass. Each finding names the file and line, and the commit in history mode; secrets are never printed.
Plan-Step: P0.21.3
"""
import json
import os
import pathlib
import shutil
import subprocess
import sys
import tempfile

PINNED = "8.30.1"
CONFIG = pathlib.Path(__file__).resolve().parent / "gitleaks.toml"


def broken(message):
    print(f"secrets: broken: {message}", file=sys.stderr)
    return 2


def main(argv):
    if len(argv) == 2 and argv[0] == "staged":
        scan = ["git", argv[1], "--pre-commit", "--staged"]
    elif len(argv) == 3 and argv[0] == "commits":
        scan = ["git", argv[1], f"--log-opts={argv[2]}"]
    else:
        return broken("usage: secrets staged <repo> | secrets commits <repo> <range>")
    tool = shutil.which("gitleaks")
    if not tool:
        return broken(f"gitleaks is not installed; install gitleaks {PINNED} (brew install gitleaks). "
                      "This gate never passes without it.")
    version = subprocess.run([tool, "version"], capture_output=True, text=True).stdout.strip().lstrip("v")
    if version != PINNED:
        return broken(f"gitleaks {version or 'unknown'} found, {PINNED} pinned; install the pinned version or update the pin")
    with tempfile.TemporaryDirectory() as tmp:
        report = pathlib.Path(tmp) / "report.json"
        env = {k: v for k, v in os.environ.items() if not k.startswith("GITLEAKS_")}
        result = subprocess.run([tool, *scan, "--config", str(CONFIG), "--no-banner", "--redact",
                                 "--log-level", "error", "--report-format", "json",
                                 "--report-path", str(report), "--exit-code", "0"],
                                capture_output=True, text=True, env=env)
        if result.returncode != 0 or not report.exists():
            return broken(f"gitleaks failed: {result.stderr.strip()[:300]}")
        findings = json.loads(report.read_text() or "[]")
    for finding in findings:
        where = f"{finding.get('File', '?')}:{finding.get('StartLine', '?')}"
        if finding.get("Commit"):
            where += f" (commit {finding['Commit'][:12]})"
        print(f"secrets: refused secret {where} ({finding.get('RuleID', 'rule')})", file=sys.stderr)
    return 1 if findings else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
