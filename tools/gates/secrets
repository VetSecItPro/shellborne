#!/usr/bin/env python3
"""Secrets gate: refuse credentials in staged files, in any commit of a range, or in test fixtures.

Usage:
    secrets staged <repo>            before a commit
    secrets commits <repo> <range>   before a push and in CI
    secrets fixtures <repo>          every tracked file under a fixtures or replays folder

Runs gitleaks at the pinned version with this folder's gitleaks.toml, never a config from the
scanned tree. Exit 0 clean, 1 refused, 2 broken. A missing or different gitleaks is broken, never a
pass. Each finding names the file and line, and the commit in history mode; secrets are never printed.

Fixtures mode copies each fixture into a folder outside the tree and scans the copy, so the tree is
never written. An asciicast (*.cast) is scanned twice: as raw text, and as the decoded text of its
output events joined in order. Every run also scans a control copy holding a freshly generated
canary shaped like a GitHub token, and prints only the canary's sha256. The control cast holds the
canary split across two events with a JSON escape, so it is caught only if decoding works, and the
catch must be in the decoded view of that cast; a canary the scanner misses, or a decoder that fails
to reveal it, makes the run broken. Limit: a secret split by an escape sequence inside one event passes.
Plan-Step: P0.21.3, P0.11.11
"""
import hashlib
import json
import os
import pathlib
import secrets
import shutil
import stat
import string
import subprocess
import sys
import tempfile

PINNED = "8.30.1"
CONFIG = pathlib.Path(__file__).resolve().parent / "gitleaks.toml"
FIXTURE_FOLDERS = {"fixtures", "replays"}
MAX_FIXTURE_BYTES = 16 * 1024 * 1024
MAX_FIXTURE_FILES = 20000
MAX_FINDINGS = 200
RAW = "raw"
DECODED = "decoded"


def broken(message):
    print(f"secrets: broken: {message}", file=sys.stderr)
    return 2


def find_gitleaks():
    tool = shutil.which("gitleaks")
    if not tool:
        return None, broken(f"gitleaks is not installed; install gitleaks {PINNED} (brew install gitleaks). "
                            "This gate never passes without it.")
    version = subprocess.run([tool, "version"], capture_output=True, text=True).stdout.strip().lstrip("v")
    if version != PINNED:
        return None, broken(f"gitleaks {version or 'unknown'} found, {PINNED} pinned; "
                            "install the pinned version or update the pin")
    return tool, 0


def run_gitleaks(tool, scan):
    """Returns the findings list, or None when gitleaks failed."""
    with tempfile.TemporaryDirectory() as tmp:
        report = pathlib.Path(tmp) / "report.json"
        env = {k: v for k, v in os.environ.items() if not k.startswith("GITLEAKS_")}
        result = subprocess.run([tool, *scan, "--config", str(CONFIG), "--no-banner", "--redact",
                                 "--log-level", "error", "--report-format", "json",
                                 "--report-path", str(report), "--exit-code", "0"],
                                capture_output=True, text=True, env=env)
        if result.returncode != 0 or not report.exists():
            print(f"secrets: broken: gitleaks failed: {result.stderr.strip()[:300]}", file=sys.stderr)
            return None
        try:
            findings = json.loads(report.read_text() or "[]")
        except json.JSONDecodeError:
            print("secrets: broken: gitleaks wrote a report that is not JSON", file=sys.stderr)
            return None
    if not isinstance(findings, list):
        print("secrets: broken: gitleaks wrote a report that is not a list", file=sys.stderr)
        return None
    return findings


def history_or_staged(argv):
    if len(argv) == 2 and argv[0] == "staged":
        scan = ["git", argv[1], "--pre-commit", "--staged"]
    else:
        scan = ["git", argv[1], f"--log-opts={argv[2]}"]
    tool, status = find_gitleaks()
    if not tool:
        return status
    findings = run_gitleaks(tool, scan)
    if findings is None:
        return 2
    for finding in findings:
        where = f"{finding.get('File', '?')}:{finding.get('StartLine', '?')}"
        if finding.get("Commit"):
            where += f" (commit {finding['Commit'][:12]})"
        print(f"secrets: refused secret {where} ({finding.get('RuleID', 'rule')})", file=sys.stderr)
    return 1 if findings else 0


REGULAR_MODES = {"100644", "100755"}


def tracked_fixtures(repo):
    """(name, git mode) for each tracked file under a fixtures or replays folder, or None when git cannot list."""
    try:
        listed = subprocess.run(["git", "-C", str(repo), "ls-files", "-s", "-z"], capture_output=True, timeout=120)
    except (OSError, subprocess.TimeoutExpired):
        return None
    if listed.returncode != 0:
        return None
    found = []
    for entry in listed.stdout.split(b"\0"):
        if not entry:
            continue
        head, tab, raw = entry.partition(b"\t")
        mode = head.split(b" ", 1)[0].decode("ascii", "replace")
        name = raw.decode("utf-8", "surrogateescape")
        if tab and FIXTURE_FOLDERS & set(pathlib.PurePosixPath(name).parts[:-1]):
            found.append((name, mode))
    return found


def decode_asciicast(data):
    """The output events' text joined in order. Lines that are not output events are skipped here; the raw scan
    still covers them."""
    pieces = []
    for line in data.decode("utf-8", "replace").splitlines():
        try:
            event = json.loads(line)
        except json.JSONDecodeError:
            continue
        if isinstance(event, list) and len(event) == 3 and event[1] == "o" and isinstance(event[2], str):
            pieces.append(event[2])
    return "".join(pieces)


def stage_fixtures(repo, names, root):
    """Copies each regular tracked fixture under root/raw, and each asciicast's decoded text under root/decoded.
    Returns an error message, or None."""
    for name, mode in names:
        if mode not in REGULAR_MODES:
            return (f"{name} is tracked as a link, submodule or other non-regular entry (mode {mode}), "
                    "so it cannot be scanned")
        source = repo / name
        try:
            info = os.lstat(source)
        except FileNotFoundError:
            continue
        if not stat.S_ISREG(info.st_mode):
            return f"{name} is not a regular file in the working tree, so it cannot be scanned"
        if info.st_size > MAX_FIXTURE_BYTES:
            return f"{name} is over the {MAX_FIXTURE_BYTES} byte fixture cap, so it cannot be scanned"
        with open(source, "rb") as handle:
            data = handle.read(MAX_FIXTURE_BYTES + 1)
        if len(data) > MAX_FIXTURE_BYTES:
            return f"{name} grew past the {MAX_FIXTURE_BYTES} byte fixture cap while it was read"
        raw = root / RAW / name
        raw.parent.mkdir(parents=True, exist_ok=True)
        raw.write_bytes(data)
        if name.endswith(".cast"):
            decoded = root / DECODED / name
            decoded.parent.mkdir(parents=True, exist_ok=True)
            decoded.write_text(decode_asciicast(data), encoding="utf-8", errors="surrogateescape")
    return None


def where_in_copy(root, finding):
    """Maps a finding in the scanned copy back to (fixture path, how it was seen, line)."""
    found = pathlib.Path(str(finding.get("File", "")))
    if not found.is_absolute():
        found = root / found
    try:
        relative = found.resolve().relative_to(root.resolve())
    except ValueError:
        return str(finding.get("File", "?")), RAW, finding.get("StartLine", "?")
    parts = relative.parts
    if len(parts) < 2 or parts[0] not in (RAW, DECODED):
        return str(relative), RAW, finding.get("StartLine", "?")
    return "/".join(parts[1:]), parts[0], finding.get("StartLine", "?")


def control_canary(tool):
    """Scans a control copy holding a fresh canary in a plain file and in a cast. The cast holds it split across two
    output events with its first letter written as a JSON escape, so only decoding can reveal it. Returns
    (sha256, failed): the digest only when the plain file was caught in its raw view, the decoded cast was caught
    in its decoded view, and the raw view of the cast was not (which shows the catch came from decoding)."""
    alphabet = string.ascii_letters + string.digits
    canary = "ghp_" + "".join(secrets.choice(alphabet) for _ in range(36))
    digest = hashlib.sha256(canary.encode()).hexdigest()
    with tempfile.TemporaryDirectory(prefix="secrets-control-") as tmp:
        root = pathlib.Path(tmp)
        (root / RAW).mkdir()
        (root / DECODED).mkdir()
        (root / RAW / "control.txt").write_text(f"export GITHUB_TOKEN={canary}\n")
        cast = "\n".join([
            json.dumps({"version": 2, "width": 80, "height": 24}),
            '[0.1, "o", "\\u0067' + canary[1:20] + '"]',
            json.dumps([0.2, "o", canary[20:] + "\r\n"]),
        ]) + "\n"
        data = cast.encode()
        (root / RAW / "control.cast").write_bytes(data)
        (root / DECODED / "control.cast").write_text(decode_asciicast(data), encoding="utf-8",
                                                    errors="surrogateescape")
        findings = run_gitleaks(tool, ["dir", str(root)])
        seen = {where_in_copy(root, finding)[:2] for finding in findings or []}
    del canary, cast, data
    if findings is None:
        return None, True
    caught = ("control.txt", RAW) in seen and ("control.cast", DECODED) in seen and ("control.cast", RAW) not in seen
    return (digest if caught else None), False


def fixtures(repo_arg):
    repo = pathlib.Path(repo_arg)
    tool, status = find_gitleaks()
    if not tool:
        return status
    digest, failed = control_canary(tool)
    if failed:
        return 2
    if not digest:
        return broken("the control canary was not caught in both its raw and its decoded view, so the scanner or the decoder is blind and no fixture result counts")
    names = tracked_fixtures(repo)
    if names is None:
        return broken(f"cannot list tracked files in {repo_arg}")
    if len(names) > MAX_FIXTURE_FILES:
        return broken(f"{len(names)} fixture files, over the {MAX_FIXTURE_FILES} file cap")
    with tempfile.TemporaryDirectory(prefix="secrets-fixtures-") as tmp:
        root = pathlib.Path(tmp)
        (root / RAW).mkdir()
        (root / DECODED).mkdir()
        error = stage_fixtures(repo, names, root)
        if error:
            return broken(error)
        findings = run_gitleaks(tool, ["dir", str(root)])
        if findings is None:
            return 2
        located = [where_in_copy(root, finding) + (finding.get("RuleID", "rule"),) for finding in findings]
    print(f"secrets: control canary sha256:{digest} caught", file=sys.stderr)
    seen = set()
    for name, view, line, rule in located:
        where = f"{name}:{line}" if view == RAW else f"{name} (decoded output)"
        if (where, rule) in seen:
            continue
        seen.add((where, rule))
        if len(seen) > MAX_FINDINGS:
            print(f"secrets: refused: more than {MAX_FINDINGS} findings; the rest are not listed", file=sys.stderr)
            break
        print(f"secrets: refused secret {where} ({rule})", file=sys.stderr)
    return 1 if located else 0


def main(argv):
    if (len(argv) == 2 and argv[0] == "staged") or (len(argv) == 3 and argv[0] == "commits"):
        return history_or_staged(argv)
    if len(argv) == 2 and argv[0] == "fixtures":
        return fixtures(argv[1])
    return broken("usage: secrets staged <repo> | secrets commits <repo> <range> | secrets fixtures <repo>")


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
