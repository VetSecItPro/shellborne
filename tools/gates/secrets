#!/usr/bin/env python3
"""Secrets gate: refuse credentials in staged files, in any commit of a range, or in test fixtures.

Usage:
    secrets [--tables-from <ref>] staged <repo>            before a commit
    secrets [--tables-from <ref>] commits <repo> <range>   before a push and in CI
    secrets [--tables-from <ref>] fixtures <repo>          every tracked file under a fixtures or replays folder

Runs gitleaks at the pinned version with a gitleaks.toml that is never read from the tree under test: the
one beside this file, or with --tables-from the one at tools/gates/gitleaks.toml at that commit of the
repository (git cat-file blob <ref>:tools/gates/gitleaks.toml), so a branch cannot add an allowlist to its own
rules. The ref must be a plain commit name; the table is capped at 256 KiB and an empty or malformed table is
broken. The config is copied to a temp file before use.

A change cannot switch off its own findings: gitleaks runs with --ignore-gitleaks-allow, so a gitleaks:allow
comment suppresses nothing; with --gitleaks-ignore-path pointing at an empty temp folder, so no .gitleaksignore
is read; and with its working directory in a temp folder, never the caller's or the scanned tree's. Every
gitleaks call has a timeout (version check and scan), and a timeout is broken.
A .gitleaksignore at the top of the repository is refused in staged and commits modes (exit 1), because gitleaks
reads it from the scanned folder whatever the ignore path says.

Exit 0 clean, 1 refused, 2 broken. A missing or different gitleaks is broken, never a
pass. Each finding names the file and line, and the commit in history mode; secrets are never printed.

Fixtures mode copies each fixture into a folder outside the tree and scans the copy, so the tree is
never written. An asciicast (*.cast) is scanned twice: as raw text, and as the decoded text of its
output events joined in order. Every run also scans a control copy holding a freshly generated
canary shaped like a GitHub token, and prints only the canary's sha256. The control cast holds the
canary split across two events with a JSON escape, so it is caught only if decoding works, and the
catch must be in the decoded view of that cast; a canary the scanner misses, or a decoder that fails
to reveal it, makes the run broken. Limit: a secret split by an escape sequence inside one event passes.
A tracked fixture that cannot be read, or that is missing from the working tree, makes the run broken and names
the path.
Plan-Step: P0.21.3, P0.11.11
"""
import errno
import hashlib
import json
import os
import pathlib
import re
import secrets
import shutil
import stat
import string
import subprocess
import sys
import tempfile

def read_capped(path, cap):
    """The whole of a regular file, opened no-follow and non-blocking, of at most cap bytes. Inline rather than the
    shared bounded-read helper: CI runs this gate as one file extracted from the base commit, with nothing beside
    it."""
    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    try:
        if not stat.S_ISREG(os.fstat(fd).st_mode):
            raise OSError(errno.EINVAL, f"{path} is not a regular file")
        data = bytearray()
        while len(data) <= cap:
            chunk = os.read(fd, cap + 1 - len(data))
            if not chunk:
                return bytes(data)
            data += chunk
        raise OSError(errno.EFBIG, f"{path} is larger than {cap} bytes")
    finally:
        os.close(fd)

PINNED = "8.30.1"
HERE = pathlib.Path(__file__).resolve().parent
CONFIG = HERE / "gitleaks.toml"
CONFIG_NAME = "gitleaks.toml"
IGNORE_NAME = ".gitleaksignore"
REF = re.compile(r"[A-Za-z0-9._/@^~{}-]+")
MAX_CONFIG_BYTES = 256 * 1024
VERSION_TIMEOUT = 30
SCAN_TIMEOUT = 900
FIXTURE_FOLDERS = {"fixtures", "replays"}
MAX_FIXTURE_BYTES = 16 * 1024 * 1024
MAX_FIXTURE_FILES = 20000
MAX_FINDINGS = 200
RAW = "raw"
DECODED = "decoded"


def broken(message):
    print(f"secrets: broken: {message}", file=sys.stderr)
    return 2


def find_gitleaks():
    tool = shutil.which("gitleaks")
    if not tool:
        return None, broken(f"gitleaks is not installed; install gitleaks {PINNED} with Homebrew. "
                            "This gate never passes without it.")
    try:
        with tempfile.TemporaryDirectory(prefix="secrets-version-") as work:
            done = subprocess.run([tool, "version"], capture_output=True, text=True, cwd=work,
                                  stdin=subprocess.DEVNULL, timeout=VERSION_TIMEOUT)
    except subprocess.TimeoutExpired:
        return None, broken(f"gitleaks version did not answer within {VERSION_TIMEOUT} seconds")
    except OSError as error:
        return None, broken(f"gitleaks could not be run: {error.strerror}")
    version = done.stdout.strip().lstrip("v")
    if version != PINNED:
        return None, broken(f"gitleaks {version or 'unknown'} found, {PINNED} pinned; "
                            "install the pinned version or update the pin")
    return tool, 0


def config_bytes(repo, ref):
    """The gitleaks config's bytes, from beside this file or, with a ref, from that commit. Returns (bytes, error)."""
    if ref is None:
        try:
            raw = read_capped(CONFIG, MAX_CONFIG_BYTES)
        except OSError as error:
            return None, f"cannot read {CONFIG_NAME}: {error.strerror or error}"
    else:
        if not REF.fullmatch(ref) or ref.startswith("-"):
            return None, "--tables-from needs a plain commit name"
        try:
            done = subprocess.run(["git", "-C", str(repo), "cat-file", "blob", f"{ref}:tools/gates/{CONFIG_NAME}"],
                                  capture_output=True, stdin=subprocess.DEVNULL, timeout=60)
        except (OSError, subprocess.TimeoutExpired):
            return None, f"git could not read {CONFIG_NAME} from the ref"
        if done.returncode != 0:
            return None, f"the ref has no readable tools/gates/{CONFIG_NAME}"
        raw = done.stdout
    if len(raw) > MAX_CONFIG_BYTES:
        return None, f"{CONFIG_NAME} is over the {MAX_CONFIG_BYTES}-byte cap"
    try:
        import tomllib  # Python 3.11 or newer; imported here so a missing gitleaks is still reported first
    except ImportError:
        return None, f"cannot check {CONFIG_NAME}: this Python has no tomllib (3.11 or newer needed)"
    try:
        data = tomllib.loads(raw.decode("utf-8"))
    except (UnicodeDecodeError, tomllib.TOMLDecodeError):
        return None, f"{CONFIG_NAME} is malformed"
    if not data:
        return None, f"{CONFIG_NAME} is empty"
    return raw, None


def run_gitleaks(tool, scan, config):
    """Returns the findings list, or None when gitleaks failed. Runs in an empty temp folder, with gitleaks:allow
    comments ignored and the ignore path set to another empty temp folder."""
    with tempfile.TemporaryDirectory() as tmp:
        report = pathlib.Path(tmp) / "report.json"
        work = pathlib.Path(tmp) / "work"
        no_ignore = pathlib.Path(tmp) / "no-ignore"
        work.mkdir()
        no_ignore.mkdir()
        env = {k: v for k, v in os.environ.items() if not k.startswith("GITLEAKS_")}
        try:
            result = subprocess.run([tool, *scan, "--config", str(config), "--no-banner", "--redact",
                                     "--ignore-gitleaks-allow", "--gitleaks-ignore-path", str(no_ignore),
                                     "--log-level", "error", "--report-format", "json",
                                     "--report-path", str(report), "--exit-code", "0"],
                                    capture_output=True, text=True, env=env, cwd=work, stdin=subprocess.DEVNULL,
                                    timeout=SCAN_TIMEOUT)
        except subprocess.TimeoutExpired:
            print(f"secrets: broken: gitleaks did not finish within {SCAN_TIMEOUT} seconds", file=sys.stderr)
            return None
        except OSError as error:
            print(f"secrets: broken: gitleaks could not be run: {error.strerror}", file=sys.stderr)
            return None
        if result.returncode != 0 or not report.exists():
            print(f"secrets: broken: gitleaks failed: {result.stderr.strip()[:300]}", file=sys.stderr)
            return None
        try:
            findings = json.loads(report.read_text() or "[]")
        except json.JSONDecodeError:
            print("secrets: broken: gitleaks wrote a report that is not JSON", file=sys.stderr)
            return None
    if not isinstance(findings, list):
        print("secrets: broken: gitleaks wrote a report that is not a list", file=sys.stderr)
        return None
    return findings


def history_or_staged(argv, tool, config):
    repo = str(pathlib.Path(argv[1]).resolve())  # gitleaks runs in a temp folder, so the path must not be relative
    if len(argv) == 2 and argv[0] == "staged":
        scan = ["git", repo, "--pre-commit", "--staged"]
    else:
        scan = ["git", repo, f"--log-opts={argv[2]}"]
    if os.path.lexists(pathlib.Path(repo) / IGNORE_NAME):
        # gitleaks reads this file from the scanned folder whatever --gitleaks-ignore-path says, so a change
        # could list its own findings in it; the gate refuses the file instead of honoring it
        print(f"secrets: refused {IGNORE_NAME} in the repository: it can hide findings and this gate never reads it",
              file=sys.stderr)
        return 1
    findings = run_gitleaks(tool, scan, config)
    if findings is None:
        return 2
    for finding in findings:
        where = f"{finding.get('File', '?')}:{finding.get('StartLine', '?')}"
        if finding.get("Commit"):
            where += f" (commit {finding['Commit'][:12]})"
        print(f"secrets: refused secret {where} ({finding.get('RuleID', 'rule')})", file=sys.stderr)
    return 1 if findings else 0


REGULAR_MODES = {"100644", "100755"}


def tracked_fixtures(repo):
    """(name, git mode) for each tracked file under a fixtures or replays folder, or None when git cannot list."""
    try:
        listed = subprocess.run(["git", "-C", str(repo), "ls-files", "-s", "-z"], capture_output=True, timeout=120)
    except (OSError, subprocess.TimeoutExpired):
        return None
    if listed.returncode != 0:
        return None
    found = []
    for entry in listed.stdout.split(b"\0"):
        if not entry:
            continue
        head, tab, raw = entry.partition(b"\t")
        mode = head.split(b" ", 1)[0].decode("ascii", "replace")
        name = raw.decode("utf-8", "surrogateescape")
        if tab and FIXTURE_FOLDERS & set(pathlib.PurePosixPath(name).parts[:-1]):
            found.append((name, mode))
    return found


def decode_asciicast(data):
    """The output events' text joined in order. Lines that are not output events are skipped here; the raw scan
    still covers them."""
    pieces = []
    for line in data.decode("utf-8", "replace").splitlines():
        try:
            event = json.loads(line)
        except json.JSONDecodeError:
            continue
        if isinstance(event, list) and len(event) == 3 and event[1] == "o" and isinstance(event[2], str):
            pieces.append(event[2])
    return "".join(pieces)


def stage_fixtures(repo, names, root):
    """Copies each regular tracked fixture under root/raw, and each asciicast's decoded text under root/decoded.
    Returns an error message, or None."""
    for name, mode in names:
        if mode not in REGULAR_MODES:
            return (f"{name} is tracked as a link, submodule or other non-regular entry (mode {mode}), "
                    "so it cannot be scanned")
        source = repo / name
        try:
            info = os.lstat(source)
        except FileNotFoundError:
            return f"{name} is tracked but missing from the working tree, so it cannot be scanned"
        except OSError as error:
            return f"{name} cannot be examined ({error.strerror}), so it cannot be scanned"
        if not stat.S_ISREG(info.st_mode):
            return f"{name} is not a regular file in the working tree, so it cannot be scanned"
        if info.st_size > MAX_FIXTURE_BYTES:
            return f"{name} is over the {MAX_FIXTURE_BYTES} byte fixture cap, so it cannot be scanned"
        try:
            try:
                data = read_capped(source, MAX_FIXTURE_BYTES)
            except OSError as error:
                return f"{name} cannot be read within the rules ({error.strerror or error}), so it cannot be scanned"
            raw = root / RAW / name
            raw.parent.mkdir(parents=True, exist_ok=True)
            raw.write_bytes(data)
            if name.endswith(".cast"):
                decoded = root / DECODED / name
                decoded.parent.mkdir(parents=True, exist_ok=True)
                decoded.write_text(decode_asciicast(data), encoding="utf-8", errors="surrogateescape")
        except OSError as error:
            return f"{name} cannot be read or copied ({error.strerror}), so it cannot be scanned"
    return None


def where_in_copy(root, finding):
    """Maps a finding in the scanned copy back to (fixture path, how it was seen, line)."""
    found = pathlib.Path(str(finding.get("File", "")))
    if not found.is_absolute():
        found = root / found
    try:
        relative = found.resolve().relative_to(root.resolve())
    except ValueError:
        return str(finding.get("File", "?")), RAW, finding.get("StartLine", "?")
    parts = relative.parts
    if len(parts) < 2 or parts[0] not in (RAW, DECODED):
        return str(relative), RAW, finding.get("StartLine", "?")
    return "/".join(parts[1:]), parts[0], finding.get("StartLine", "?")


def control_canary(tool, config):
    """Scans a control copy holding a fresh canary in a plain file and in a cast. The cast holds it split across two
    output events with its first letter written as a JSON escape, so only decoding can reveal it. Returns
    (sha256, failed): the digest only when the plain file was caught in its raw view, the decoded cast was caught
    in its decoded view, and the raw view of the cast was not (which shows the catch came from decoding)."""
    alphabet = string.ascii_letters + string.digits
    canary = "ghp_" + "".join(secrets.choice(alphabet) for _ in range(36))
    digest = hashlib.sha256(canary.encode()).hexdigest()
    with tempfile.TemporaryDirectory(prefix="secrets-control-") as tmp:
        root = pathlib.Path(tmp)
        (root / RAW).mkdir()
        (root / DECODED).mkdir()
        (root / RAW / "control.txt").write_text(f"export GITHUB_TOKEN={canary}\n")
        cast = "\n".join([
            json.dumps({"version": 2, "width": 80, "height": 24}),
            '[0.1, "o", "\\u0067' + canary[1:20] + '"]',
            json.dumps([0.2, "o", canary[20:] + "\r\n"]),
        ]) + "\n"
        data = cast.encode()
        (root / RAW / "control.cast").write_bytes(data)
        (root / DECODED / "control.cast").write_text(decode_asciicast(data), encoding="utf-8",
                                                    errors="surrogateescape")
        findings = run_gitleaks(tool, ["dir", str(root)], config)
        seen = {where_in_copy(root, finding)[:2] for finding in findings or []}
    del canary, cast, data
    if findings is None:
        return None, True
    caught = ("control.txt", RAW) in seen and ("control.cast", DECODED) in seen and ("control.cast", RAW) not in seen
    return (digest if caught else None), False


def fixtures(repo_arg, tool, config):
    repo = pathlib.Path(repo_arg)
    digest, failed = control_canary(tool, config)
    if failed:
        return 2
    if not digest:
        return broken("the control canary was not caught in both its raw and its decoded view, so the scanner or the decoder is blind and no fixture result counts")
    names = tracked_fixtures(repo)
    if names is None:
        return broken(f"cannot list tracked files in {repo_arg}")
    if len(names) > MAX_FIXTURE_FILES:
        return broken(f"{len(names)} fixture files, over the {MAX_FIXTURE_FILES} file cap")
    with tempfile.TemporaryDirectory(prefix="secrets-fixtures-") as tmp:
        root = pathlib.Path(tmp)
        (root / RAW).mkdir()
        (root / DECODED).mkdir()
        error = stage_fixtures(repo, names, root)
        if error:
            return broken(error)
        findings = run_gitleaks(tool, ["dir", str(root)], config)
        if findings is None:
            return 2
        located = [where_in_copy(root, finding) + (finding.get("RuleID", "rule"),) for finding in findings]
    print(f"secrets: control canary sha256:{digest} caught", file=sys.stderr)
    seen = set()
    for name, view, line, rule in located:
        where = f"{name}:{line}" if view == RAW else f"{name} (decoded output)"
        if (where, rule) in seen:
            continue
        seen.add((where, rule))
        if len(seen) > MAX_FINDINGS:
            print(f"secrets: refused: more than {MAX_FINDINGS} findings; the rest are not listed", file=sys.stderr)
            break
        print(f"secrets: refused secret {where} ({rule})", file=sys.stderr)
    return 1 if located else 0


def main(argv):
    usage = ("usage: secrets [--tables-from <ref>] staged <repo> | secrets [--tables-from <ref>] commits <repo> "
             "<range> | secrets [--tables-from <ref>] fixtures <repo>")
    args, ref = list(argv), None
    if args and args[0] == "--tables-from":
        if len(args) < 2:
            return broken(usage)
        ref, args = args[1], args[2:]
    if not ((len(args) == 2 and args[0] in ("staged", "fixtures")) or (len(args) == 3 and args[0] == "commits")):
        return broken(usage)
    tool, status = find_gitleaks()
    if not tool:
        return status
    raw, error = config_bytes(args[1], ref)
    if error:
        return broken(error)
    with tempfile.TemporaryDirectory(prefix="secrets-config-") as tmp:
        config = pathlib.Path(tmp) / CONFIG_NAME
        config.write_bytes(raw)
        if args[0] == "fixtures":
            return fixtures(args[1], tool, config)
        return history_or_staged(args, tool, config)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
