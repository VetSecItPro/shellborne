#!/usr/bin/env python3
"""CodeQL results gate: any finding in the SARIF output fails the check.

Usage: codeql-results <folder>

CodeQL on its own only reports alerts. This gate reads every .sarif file in <folder> and prints one
line per finding (rule, file and line). Every file must hold CodeQL runs that finished successfully and
carry a results list. Exit 0 no findings, 1 findings, 2 nothing usable, which is never treated as clean.
Plan-Step: P0.21.5
"""
import json
import pathlib
import sys


def findings(run):
    for result in run.get("results", []):
        rule = result.get("ruleId", "unknown-rule")
        where = "unknown location"
        locations = result.get("locations") or []
        if locations:
            physical = locations[0].get("physicalLocation", {})
            uri = physical.get("artifactLocation", {}).get("uri", "unknown file")
            line = physical.get("region", {}).get("startLine")
            where = f"{uri}:{line}" if line else uri
        yield f"{rule} {where}"


def main(argv):
    if len(argv) != 2:
        print("usage: codeql-results <folder>", file=sys.stderr)
        return 2
    files = sorted(pathlib.Path(argv[1]).glob("*.sarif")) if pathlib.Path(argv[1]).is_dir() else []
    if not files:
        print(f"codeql-results: broken: no SARIF files in {argv[1]}", file=sys.stderr)
        return 2
    found = []
    for path in files:
        try:
            data = json.loads(path.read_text())
        except (OSError, ValueError) as error:
            print(f"codeql-results: broken: cannot read {path.name}: {error}", file=sys.stderr)
            return 2
        runs = data.get("runs") if isinstance(data, dict) else None
        problem = "has no runs" if not runs else None
        for run in runs or []:
            if run.get("tool", {}).get("driver", {}).get("name") != "CodeQL":
                problem = "has a run that is not CodeQL"
            elif not isinstance(run.get("results"), list):
                problem = "has a run with no results list"
            elif not run.get("invocations") or not all(i.get("executionSuccessful") is True for i in run["invocations"]):
                problem = "has a run that did not finish successfully"
            else:
                found.extend(findings(run))
        if problem:
            print(f"codeql-results: broken: {path.name} {problem}", file=sys.stderr)
            return 2
    for line in found:
        print(f"codeql-results: finding {line}")
    return 1 if found else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
