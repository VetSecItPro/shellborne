#!/usr/bin/env python3
"""Link gate: no libghostty-vt symbol where the engine must not run (plan step P0.9.4).

Usage: link-check <binary folder>
       link-check --network <binary folder>   (plan step P0.9.6)

Reads the [link] table in repo-rules.toml beside this file and the symbol table (nm -P) of each named binary in
the folder. A daemon binary (supervisor, session host, attach client, CLI) with any engine symbol, defined or
referenced, is refused as engine-in-daemon; the GUI with an engine symbol outside the key-encoder prefixes is
refused as engine-in-gui. A folder with none of the named binaries is not run, and a missing daemon binary is
broken, so the gate never passes on what it did not read. With --network, every Mach-O in the folder except
the update module's binary is refused as network-in-binary for a getaddrinfo symbol or a link to CFNetwork or the
Network framework; a folder with no Mach-O is not run.

Both tables are typed exactly: a malformed, duplicate or unknown field is broken, never read loosely. Only regular
files are read: a named binary that is a symlink is broken, and the network scan never follows a symlink out of the
folder. Every scan is bounded: at most MAX_FILES files, MAX_BINARY_BYTES per binary, MAX_OUTPUT bytes from one nm or
otool run, MAX_SECONDS for the whole run, and at most MAX_FINDINGS refusals kept and listed, the rest counted; past any other cap the run is broken.
File names are printed with control and non-ASCII characters escaped. Exit 0 clean, 1 refused, 2 broken or not run.
"""
import os
import pathlib
import re
import selectors
import stat
import subprocess
import sys
import time
import tomllib

TABLE = pathlib.Path(__file__).resolve().parent / "repo-rules.toml"
MAX_FILES = 20000
MAX_BINARY_BYTES = 1024 * 1024 * 1024
MAX_OUTPUT = 256 * 1024 * 1024
MAX_SECONDS = 1800
MAX_FINDINGS = 1000
SYMBOL_PREFIX = re.compile(r"[A-Za-z_][A-Za-z0-9_]*")
BINARY_PATH = re.compile(r"[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*")
FRAMEWORK = re.compile(r"[A-Za-z0-9_]+\.framework")
START = time.monotonic()


class Broken(Exception):
    pass


class Collected:
    """The first MAX_FINDINGS refusals, kept; every refusal, counted."""
    def __init__(self):
        self.kept, self.total = [], 0

    def add(self, item):
        self.total += 1
        if len(self.kept) < MAX_FINDINGS:
            self.kept.append(item)


def shown(name):
    """A name safe to print: control, backslash and non-ASCII characters escaped, so a name cannot forge a line."""
    return "".join(c if " " <= c <= "~" and c != "\\" else c.encode("unicode_escape", "backslashreplace").decode("ascii")
                   for c in name)


def remaining():
    left = START + MAX_SECONDS - time.monotonic()
    if left <= 0:
        raise Broken(f"the run passed its cap of {MAX_SECONDS} seconds")
    return left


def strings(value, form):
    return (isinstance(value, list) and value and all(isinstance(v, str) and form.fullmatch(v) for v in value)
            and len(set(value)) == len(value)
            and not any(part in (".", "..") for v in value for part in v.split("/")))


SHAPES = {
    "link": {"enforces": lambda v: isinstance(v, str) and v.strip(),
             "engine_prefix": lambda v: isinstance(v, str) and SYMBOL_PREFIX.fullmatch(v),
             "daemon_binaries": lambda v: strings(v, BINARY_PATH),
             "gui_binaries": lambda v: strings(v, BINARY_PATH),
             "gui_allowed_prefixes": lambda v: strings(v, SYMBOL_PREFIX)},
    "network": {"enforces": lambda v: isinstance(v, str) and v.strip(),
                "update_binaries": lambda v: strings(v, BINARY_PATH),
                "forbidden_symbols": lambda v: strings(v, SYMBOL_PREFIX),
                "forbidden_frameworks": lambda v: strings(v, FRAMEWORK)},
}


def table(name):
    """The [link] or [network] table, every field present with its exact type and form, and nothing else."""
    try:
        data = tomllib.loads(TABLE.read_text(encoding="utf-8"))
    except (OSError, UnicodeDecodeError, tomllib.TOMLDecodeError) as error:
        raise Broken(f"cannot read {TABLE.name}: {error}")
    for section, shape in SHAPES.items():  # both tables are checked on every run, whichever mode reads one
        found = data.get(section)
        if not isinstance(found, dict) or set(found) != set(shape):
            raise Broken(f"{TABLE.name}: the [{section}] table lacks or adds fields")
        bad = [key for key, ok in shape.items() if not ok(found[key])]
        if bad:
            raise Broken(f"{TABLE.name}: the [{section}] table has a malformed {', '.join(bad)}")
    link = data["link"]
    if set(link["daemon_binaries"]) & set(link["gui_binaries"]):
        raise Broken(f"{TABLE.name}: a binary is named as both daemon and GUI")
    if any(not p.startswith(link["engine_prefix"]) for p in link["gui_allowed_prefixes"]):
        raise Broken(f"{TABLE.name}: a GUI allowed prefix is not an engine prefix")
    return data[name]


def regular(path):
    """A regular file under the cap, never a symlink."""
    try:
        info = os.lstat(path)
    except OSError as error:
        raise Broken(f"cannot read {shown(str(path))}: {error.strerror}")
    if not stat.S_ISREG(info.st_mode):
        raise Broken(f"{shown(path.name)} is not a regular file (a symlink is never followed)")
    if info.st_size > MAX_BINARY_BYTES:
        raise Broken(f"{shown(path.name)} is over the {MAX_BINARY_BYTES}-byte cap for a binary")
    return path


MACH_O = {b"\xfe\xed\xfa\xce", b"\xfe\xed\xfa\xcf", b"\xce\xfa\xed\xfe", b"\xcf\xfa\xed\xfe",  # thin, both byte orders
          b"\xca\xfe\xba\xbe", b"\xbe\xba\xfe\xca", b"\xca\xfe\xba\xbf", b"\xbf\xba\xfe\xca"}  # universal, 32 and 64-bit


def is_mach_o(path):
    try:
        handle = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
        try:
            return os.read(handle, 4) in MACH_O
        finally:
            os.close(handle)
    except OSError as error:
        raise Broken(f"cannot read {shown(path.name)}: {error.strerror}")  # an unreadable candidate is never skipped


def run(command):
    """Run a tool with its output capped at MAX_OUTPUT bytes and its time capped by the run's deadline."""
    try:
        child = subprocess.Popen(command, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, stdin=subprocess.DEVNULL)
    except OSError as error:
        raise Broken(f"{command[0]} could not run: {error.strerror}")
    chunks, size = [], 0
    try:
        with selectors.DefaultSelector() as selector:
            selector.register(child.stdout, selectors.EVENT_READ)
            while True:
                if not selector.select(timeout=min(remaining(), 120)):
                    raise Broken(f"{command[0]} did not finish in time")
                chunk = os.read(child.stdout.fileno(), 1024 * 1024)
                if not chunk:
                    break
                size += len(chunk)
                if size > MAX_OUTPUT:
                    raise Broken(f"{command[0]} printed over the {MAX_OUTPUT}-byte cap")
                chunks.append(chunk)
        code = child.wait(timeout=min(remaining(), 120))
    except subprocess.TimeoutExpired:
        raise Broken(f"{command[0]} did not finish in time")
    finally:
        if child.poll() is None:
            child.kill()
            child.wait()
        child.stdout.close()
    return code, b"".join(chunks).decode("utf-8", "replace")


def linked(path):
    code, out = run(["otool", "-L", str(path)])
    if code != 0:
        raise Broken(f"otool cannot read {shown(path.name)}")
    return out


def candidates(folder):
    """Every regular file under the folder, never through a symlink, at most MAX_FILES."""
    found = []
    for top, dirs, files in os.walk(folder, followlinks=False):
        remaining()
        for name in files:
            path = pathlib.Path(top) / name
            if os.path.islink(path):
                continue  # a symlink in a bundle points at a file the walk reaches directly, or out of the folder
            found.append(path)
            if len(found) > MAX_FILES:
                raise Broken(f"{shown(str(folder))} holds over the {MAX_FILES}-file cap")
    return sorted(found)


def network(folder):
    """P0.9.6: getaddrinfo or a network framework in any Mach-O outside the update module."""
    net = table("network")
    found, read = Collected(), 0
    for path in candidates(folder):
        if not stat.S_ISREG(os.lstat(path).st_mode) or not is_mach_o(path):
            continue
        regular(path)
        read += 1
        rel = path.relative_to(folder).as_posix()
        if rel in net["update_binaries"]:  # the update module only at its exact path, never by a name found elsewhere
            continue
        for s in sorted(symbols(path)):
            if s in net["forbidden_symbols"]:
                found.add(("network-in-binary", f"{shown(rel)} {s}"))
        libraries = linked(path)
        for f in net["forbidden_frameworks"]:
            if f"/{f}/" in libraries:
                found.add(("network-in-binary", f"{shown(rel)} {f}"))
    if not read:
        raise Broken(f"not run: no Mach-O in {shown(str(folder))}")
    return found.kept, found.total


def symbols(path):
    code, out = run(["nm", "-P", str(path)])
    if code != 0:
        raise Broken(f"nm cannot read {shown(path.name)}")
    names = set()
    for line in out.splitlines():
        name = line.split(" ", 1)[0].split(":")[-1]
        names.add(name[1:] if name.startswith("_") else name)
    return names


def exists(path):
    return os.path.lexists(path)


def main(argv):
    try:
        remaining()
        if len(argv) == 3 and argv[1] == "--network":
            return report(*network(pathlib.Path(argv[2])))
        if len(argv) != 2:
            raise Broken("usage: link-check [--network] <binary folder>")
        link, folder = table("link"), pathlib.Path(argv[1])
        present = [n for n in link["daemon_binaries"] + link["gui_binaries"] if exists(folder / n)]
        if not present:
            raise Broken(f"not run: none of the named binaries is in {shown(str(folder))}")
        missing = [n for n in link["daemon_binaries"] if not exists(folder / n)]
        if missing:
            raise Broken(f"daemon binaries missing from {shown(str(folder))}: {', '.join(missing)}")
        found = Collected()
        for name in present:
            engine = sorted(s for s in symbols(regular(folder / name)) if s.startswith(link["engine_prefix"]))
            if name in link["daemon_binaries"]:
                for s in engine:
                    found.add(("engine-in-daemon", f"{name} {s}"))
            else:
                for s in engine:
                    if not s.startswith(tuple(link["gui_allowed_prefixes"])):
                        found.add(("engine-in-gui", f"{name} {s}"))
    except Broken as error:
        print(f"link-check: broken: {error}", file=sys.stderr)
        return 2
    return report(found.kept, found.total)


def report(kept, total):
    for reason, where in kept:
        print(f"link-check: refused {reason}: {where}")
    if total > len(kept):
        print(f"link-check: refused: {total - len(kept)} more refusals not listed")
    return 1 if total else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
