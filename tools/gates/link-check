#!/usr/bin/env python3
"""Link gate: no libghostty-vt symbol where the engine must not run (plan step P0.9.4).

Usage: link-check <binary folder>
       link-check --network <binary folder>   (plan step P0.9.6)

Reads the [link] table in repo-rules.toml beside this file and the symbol table (nm -P) of each named binary in
the folder. Every tool runs once per slice of a universal binary with -arch, since Apple's tools otherwise read only
the host's slice; a refusal for a universal binary names the slice's architecture. A daemon binary (supervisor, session host, attach client, CLI) with any engine symbol, defined or
referenced, is refused as engine-in-daemon; the GUI with an engine symbol outside the key-encoder prefixes is
refused as engine-in-gui. Every Mach-O a named binary loads from inside the folder, at any depth, is judged the
same way as the binary, and a daemon binary that loads a library named for the engine is refused even with no
engine symbol in use. A folder with none of the named binaries is not run, and a missing daemon binary is
broken, so the gate never passes on what it did not read. With --network, every Mach-O in the folder except
the update module's binary is refused as network-in-binary for a getaddrinfo symbol or a link to CFNetwork or the
Network framework; a folder with no Mach-O is not run.

Both tables are typed exactly: a malformed, duplicate or unknown field is broken, never read loosely. Only regular
files are read: a named binary that is a symlink is broken, and the network scan never follows a symlink out of the
folder. Every scan is bounded: at most MAX_FILES files, MAX_BINARY_BYTES per binary, MAX_OUTPUT bytes from one nm or
otool run, MAX_SECONDS for the whole run, and at most MAX_FINDINGS refusals kept and listed, the rest counted; past any other cap the run is broken.
File names are printed with control and non-ASCII characters escaped. Exit 0 clean, 1 refused, 2 broken or not run.
The Mach-O reader, the walk and the bounded tool runner live in mach-o-reader beside this file, shared with lipo
(plan step P0.12.3); the caps stay here and are handed to it.
"""
import importlib.machinery
import importlib.util
import os
import pathlib
import re
import stat
import sys
import tomllib

HERE = pathlib.Path(__file__).resolve().parent
TABLE = HERE / "repo-rules.toml"
SHARED = HERE / "mach-o-reader"  # the Mach-O reader and walker this gate shares with lipo, so the two cannot drift
MAX_FILES = 20000
MAX_BINARY_BYTES = 1024 * 1024 * 1024
MAX_OUTPUT = 256 * 1024 * 1024
MAX_SECONDS = 1800
MAX_FINDINGS = 1000
MAX_TABLE_BYTES = 256 * 1024
SYMBOL_PREFIX = re.compile(r"[A-Za-z_][A-Za-z0-9_]*")
BINARY_PATH = re.compile(r"[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*")
FRAMEWORK = re.compile(r"[A-Za-z0-9_]+\.framework")


def shared_reader():
    """The shared Mach-O reader, loaded from the file beside this one without writing bytecode next to it."""
    sys.dont_write_bytecode = True
    try:
        loader = importlib.machinery.SourceFileLoader("mach_o_reader", str(SHARED))
        module = importlib.util.module_from_spec(importlib.util.spec_from_loader(loader.name, loader))
        loader.exec_module(module)
    except (OSError, SyntaxError) as error:
        print(f"link-check: broken: cannot load {SHARED.name}: {error}", file=sys.stderr)
        sys.exit(2)
    return module


MO = shared_reader()
Broken, shown = MO.Broken, MO.shown
READ = MO.Reader(MAX_FILES, MAX_BINARY_BYTES, MAX_OUTPUT, MAX_SECONDS, place="build folder")
remaining, regular, is_mach_o, run, candidates = READ.remaining, READ.regular, READ.is_mach_o, READ.run, READ.candidates


def collected():
    """The first MAX_FINDINGS refusals, kept; every refusal, counted. The cap is read when a run starts."""
    return MO.Collected(MAX_FINDINGS)


def strings(value, form):
    return (isinstance(value, list) and value and all(isinstance(v, str) and form.fullmatch(v) for v in value)
            and len(set(value)) == len(value)
            and not any(part in (".", "..") for v in value for part in v.split("/")))


SHAPES = {
    "link": {"enforces": lambda v: isinstance(v, str) and v.strip(),
             "engine_prefix": lambda v: isinstance(v, str) and SYMBOL_PREFIX.fullmatch(v),
             "daemon_binaries": lambda v: strings(v, BINARY_PATH),
             "gui_binaries": lambda v: strings(v, BINARY_PATH),
             "gui_allowed_prefixes": lambda v: strings(v, SYMBOL_PREFIX),
             "engine_libraries": lambda v: strings(v, BINARY_PATH) and not any("/" in x for x in v)},
    "network": {"enforces": lambda v: isinstance(v, str) and v.strip(),
                "update_binaries": lambda v: strings(v, BINARY_PATH),
                "forbidden_symbols": lambda v: strings(v, SYMBOL_PREFIX),
                "forbidden_frameworks": lambda v: strings(v, FRAMEWORK)},
}


def table(name):
    """The [link] or [network] table, every field present with its exact type and form, and nothing else."""
    try:
        with open(TABLE, "rb") as handle:
            raw = handle.read(MAX_TABLE_BYTES + 1)
        if len(raw) > MAX_TABLE_BYTES:
            raise Broken(f"{TABLE.name} is over the {MAX_TABLE_BYTES}-byte cap for the rule table")
        data = tomllib.loads(raw.decode("utf-8"))
    except (OSError, UnicodeDecodeError, tomllib.TOMLDecodeError) as error:
        raise Broken(f"cannot read {TABLE.name}: {error}")
    for section, shape in SHAPES.items():  # both tables are checked on every run, whichever mode reads one
        found = data.get(section)
        if not isinstance(found, dict) or set(found) != set(shape):
            raise Broken(f"{TABLE.name}: the [{section}] table lacks or adds fields")
        bad = [key for key, ok in shape.items() if not ok(found[key])]
        if bad:
            raise Broken(f"{TABLE.name}: the [{section}] table has a malformed {', '.join(bad)}")
    link = data["link"]
    if set(link["daemon_binaries"]) & set(link["gui_binaries"]):
        raise Broken(f"{TABLE.name}: a binary is named as both daemon and GUI")
    if any(not p.startswith(link["engine_prefix"]) for p in link["gui_allowed_prefixes"]):
        raise Broken(f"{TABLE.name}: a GUI allowed prefix is not an engine prefix")
    return data[name]


def slices(path):
    """The architectures a Mach-O holds, and the label a refusal carries: the architecture name for a universal
    binary, so the bad slice is named, and nothing for a thin one. Each tool is run once per slice with -arch, since
    Apple's tools read only the host's slice of a universal binary when none is named."""
    found = READ.archs(path)
    return found, len(found) > 1


def tagged(text, arch, universal):
    return f"{text} ({arch})" if universal else text


def linked(path, arch):
    code, out = run(["otool", "-arch", arch, "-L", str(path)])
    if code != 0:
        raise Broken(f"otool cannot read the {arch} slice of {shown(path.name)}")
    return out


def network(folder):
    """P0.9.6: getaddrinfo or a network framework in any Mach-O outside the update module."""
    net = table("network")
    found, read = collected(), 0
    for path in candidates(folder):
        if not stat.S_ISREG(os.lstat(path).st_mode) or not is_mach_o(path):
            continue
        regular(path)
        rel = path.relative_to(folder).as_posix()
        if rel in net["update_binaries"]:  # the update module only at its exact path, never by a name found elsewhere
            continue
        read += 1  # only a binary the scan judges counts, so an update binary alone is not a clean scan
        archs, universal = slices(path)
        for arch in archs:
            for s in sorted(symbols(path, arch)):
                if s in net["forbidden_symbols"]:
                    found.add(("network-in-binary", tagged(f"{shown(rel)} {s}", arch, universal)))
            libraries = linked(path, arch)
            for f in net["forbidden_frameworks"]:
                if f"/{f}/" in libraries:
                    found.add(("network-in-binary", tagged(f"{shown(rel)} {f}", arch, universal)))
    if not read:
        raise Broken(f"not run: no Mach-O outside the update module in {shown(str(folder))}")
    return found.kept, found.total


def load_commands(path):
    """The libraries a Mach-O loads (otool -L, the first line is the file itself) and its run paths (otool -l), read
    from every slice. Returns the loads as (name, label) pairs, one per slice that loads the name, and the run paths
    of all slices, so a library only one slice reaches is still found and judged."""
    archs, universal = slices(path)
    names, rpaths = [], []
    for arch in archs:
        for line in linked(path, arch).splitlines()[1:]:
            if line.strip():
                names.append((line.strip().split(" (")[0], arch if universal else None))
        code, out = run(["otool", "-arch", arch, "-l", str(path)])
        if code != 0:
            raise Broken(f"otool cannot read the load commands of the {arch} slice of {shown(path.name)}")
        lines = out.splitlines()
        for at, line in enumerate(lines):
            if line.strip() == "cmd LC_RPATH":
                for following in lines[at + 1:at + 4]:
                    parts = following.strip().split(" ", 1)
                    if parts[0] == "path" and len(parts) == 2:
                        rpath = parts[1].split(" (offset")[0]
                        if rpath not in rpaths:
                            rpaths.append(rpath)
    return names, rpaths


def resolve(name, loader, executable, run_paths, folder, names_in_folder):
    """Where the loader would find a library, the way dyld does: an @rpath name against the run paths of the loading
    image and then of every image above it, each @loader_path taken from the image that declared it. Returns the
    path inside the build folder, or None for a library outside it (the system's). A library the folder holds under
    that name but no run path reaches is broken: matching by name alone could scan a clean copy the loader skips."""
    root = folder.resolve()

    def expand(text, owner):
        return text.replace("@executable_path", str(executable.parent)).replace("@loader_path", str(owner.parent))

    if name.startswith("@rpath/"):
        rest = name[len("@rpath/"):]
        tries = [pathlib.Path(expand(r, owner)) / rest for r, owner in run_paths]
    elif name.startswith(("@executable_path/", "@loader_path/")):
        tries = [pathlib.Path(expand(name, loader))]
    else:
        tries = [pathlib.Path(name)]
    for candidate in tries:
        lexical = pathlib.Path(os.path.normpath(os.path.abspath(candidate)))
        if lexical.is_relative_to(root) or lexical.is_relative_to(folder.absolute()):
            base_root = root if lexical.is_relative_to(root) else folder.absolute()
            step = base_root
            for part in lexical.relative_to(base_root).parts:  # a link the loader would follow, judged where it is
                step = step / part
                if step.is_symlink():
                    raise Broken(f"{shown(loader.name)} loads {shown(name)} through a symlink in the build folder "
                                 f"({shown(str(step.relative_to(base_root)))}); a link is never followed")
        try:
            real = candidate.resolve()
        except OSError:
            continue
        if real.is_file():
            return real if real.is_relative_to(root) else None
    base = pathlib.PurePosixPath(name).name
    if base in names_in_folder:
        raise Broken(f"{shown(loader.name)} loads {shown(name)}, which no run path reaches although the build folder "
                     f"holds a {shown(base)}")
    return None


def process_images(binary, folder, engine_names):
    """The binary and every Mach-O it loads from inside the build folder, at any depth, plus each load of a library
    named for the engine. Every image meets the byte cap. Yields ("image", path) and ("engine-load", name)."""
    names_in_folder = {path.name for path in candidates(folder) if stat.S_ISREG(os.lstat(path).st_mode)}
    queue, seen = [(binary.resolve(), [])], set()
    while queue:
        image, inherited = queue.pop()
        if image in seen:
            continue
        seen.add(image)
        if len(seen) > MAX_FILES:
            raise Broken(f"{shown(binary.name)} loads over the {MAX_FILES}-image cap")
        regular(image)
        yield "image", image
        names, rpaths = load_commands(image)
        run_paths = [(r, image) for r in rpaths] + inherited  # the image's own run paths first, then its loaders'
        for name, label in names:
            base = pathlib.PurePosixPath(name).name.lower()
            if any(base.startswith(e) for e in engine_names):
                yield "engine-load", (name, label)
            found = resolve(name, image, binary, run_paths, folder, names_in_folder)
            if found and found not in seen and is_mach_o(found):
                queue.append((found, run_paths))


def symbols(path, arch):
    code, out = run(["nm", "-arch", arch, "-P", str(path)])
    if code != 0:
        raise Broken(f"nm cannot read the {arch} slice of {shown(path.name)}")
    names = set()
    for line in out.splitlines():
        name = line.split(" ", 1)[0].split(":")[-1]
        names.add(name[1:] if name.startswith("_") else name)
    return names


def exists(path):
    return os.path.lexists(path)


def main(argv):
    try:
        remaining()
        if len(argv) == 3 and argv[1] == "--network":
            return report(*network(pathlib.Path(argv[2])))
        if len(argv) != 2:
            raise Broken("usage: link-check [--network] <binary folder>")
        link, folder = table("link"), pathlib.Path(argv[1])
        present = [n for n in link["daemon_binaries"] + link["gui_binaries"] if exists(folder / n)]
        if not present:
            raise Broken(f"not run: none of the named binaries is in {shown(str(folder))}")
        missing = [n for n in link["daemon_binaries"] if not exists(folder / n)]
        if missing:
            raise Broken(f"daemon binaries missing from {shown(str(folder))}: {', '.join(missing)}")
        found = collected()
        engine_names = ("lib" + link["engine_prefix"].rstrip("_").lower(), link["engine_prefix"].rstrip("_").lower())
        for name in present:
            root = regular(folder / name).resolve()
            daemon = name in link["daemon_binaries"]
            for kind, item in process_images(root, folder, engine_names):
                if kind == "engine-load":
                    if daemon:  # the GUI loads the engine library for its key encoder; a daemon never loads it
                        loaded, label = item
                        text = f"{name} loads {shown(pathlib.PurePosixPath(loaded).name)}"
                        found.add(("engine-in-daemon", f"{text} ({label})" if label else text))
                    continue
                if not daemon and item.name in link["engine_libraries"]:
                    continue  # the engine library itself, by exact name; what the GUI's own images use from it is judged
                where = name if item == root else f"{name} via {shown(item.relative_to(folder.resolve()).as_posix())}"
                archs, universal = slices(item)
                for arch in archs:
                    for s in sorted(s for s in symbols(item, arch) if s.startswith(link["engine_prefix"])):
                        if daemon:
                            found.add(("engine-in-daemon", tagged(f"{where} {s}", arch, universal)))
                        elif not s.startswith(tuple(link["gui_allowed_prefixes"])):
                            found.add(("engine-in-gui", tagged(f"{where} {s}", arch, universal)))
    except Broken as error:
        print(f"link-check: broken: {error}", file=sys.stderr)
        return 2
    return report(found.kept, found.total)


def report(kept, total):
    for reason, where in kept:
        print(f"link-check: refused {reason}: {where}")
    if total > len(kept):
        print(f"link-check: refused: {total - len(kept)} more refusals not listed")
    return 1 if total else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
