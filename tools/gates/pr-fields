#!/usr/bin/env python3
"""PR-fields gate: a pull request body carries the four public fields (plan steps P0.6.4 and P0.6.7).

Usage: PR_BODY=<pull request body> pr-fields [--clone <dir> --range <base>..<head>]

The fields are a Plan-Step line, an AI tool used line with a value, a Verified by running line with
something under it or after it, and a Tier line of 1, 2 or 3. With the clone and range, the paths of every
commit in the range are read against tier1-paths.txt beside this gate: a change touching a listed path is
Tier 1 work, so a Tier line of 2 or 3 is refused as tier-understated. Exit 0 clean, 1 refused, 2 broken.
"""
import json
import os
import pathlib
import re
import subprocess
import sys
import threading
import unicodedata

LIST_NAME = "tier1-paths.txt"
MAX_PATHS = 100000  # the changed-path list is capped (build rule 10); an environment value can only lower it
MAX_BYTES = 64 * 1024 * 1024
MAX_LIST_BYTES = 64 * 1024  # the Tier 1 list itself is capped too (build rule 10): bytes, then rules
MAX_RULES = 1000
LIST_SELF = "tools/gates/" + LIST_NAME
RULE = re.compile(r"^(?:\*\.[A-Za-z0-9_-]+|[A-Za-z0-9._/-]+)$")


class Broken(Exception):
    pass


def tier1_rules(text):
    """The rules of a Tier 1 list, or Broken when the list is malformed: a wildcard other than a leading
    *.ext, a leading /, a . or .. or empty part, a space inside a rule, no rules at all, or a list that does
    not cover itself."""
    rules = []
    for number, line in enumerate(text.split("\n"), 1):  # only a newline ends a rule; any other break is malformed
        if any(char != " " and (char.isspace() or unicodedata.category(char) in ("Cc", "Cf")) for char in line):
            raise Broken(f"{LIST_NAME} line {number} holds a control or whitespace character other than a space")
        if not line.strip(" ") or line.lstrip(" ").startswith("#"):  # a comment line: '#' at column zero or after spaces
            continue
        rule, comment, _ = line.partition(" #")  # a comment starts at column zero or after a space, nowhere else
        rule = rule.rstrip(" ") if comment else rule  # any other whitespace, or a '#' inside, fails the pattern
        parts = (rule[:-1] if rule.endswith("/") else rule).split("/")  # one trailing slash, never two
        if not RULE.match(rule) or rule.startswith("/") or ".." in parts or "." in parts or "" in parts:
            raise Broken(f"{LIST_NAME} line {number} is not a rule: {line.strip()}")
        rules.append(rule)
        if len(rules) > MAX_RULES:
            raise Broken(f"{LIST_NAME} is over its cap of {MAX_RULES} rules")
    if not rules:
        raise Broken(f"{LIST_NAME} has no rules")
    if not is_tier1(LIST_SELF, rules):
        raise Broken(f"{LIST_NAME} does not cover itself ({LIST_SELF})")
    return tuple(rules)


def is_tier1(path, rules):
    for rule in rules:
        if rule.startswith("*."):
            if path.endswith(rule[1:]):
                return True
        elif rule.endswith("/"):
            if path.startswith(rule) or path == rule[:-1]:  # the bare path too: a submodule, symlink or file there
                return True
        elif path == rule:
            return True
    return False


def read_list(path):
    """The rules of the Tier 1 list at path, read with a byte cap. Shared with sb-plan, so both read the list
    the same bounded way; missing, unreadable, not UTF-8, over the cap or malformed, it is Broken."""
    try:
        with open(path, "rb") as handle:
            data = handle.read(MAX_LIST_BYTES + 1)
    except OSError as error:
        raise Broken(f"cannot read {LIST_NAME}: {error}")
    if len(data) > MAX_LIST_BYTES:
        raise Broken(f"{LIST_NAME} is over its cap of {MAX_LIST_BYTES} bytes")
    try:
        return tier1_rules(data.decode("utf-8"))
    except UnicodeDecodeError as error:
        raise Broken(f"{LIST_NAME} is not UTF-8: {error}")


def read_rules(folder):
    return read_list(folder / LIST_NAME)


def path_cap():
    """MAX_PATHS, or a lower number from PR_FIELDS_MAX_PATHS; never higher."""
    try:
        return max(1, min(MAX_PATHS, int(os.environ.get("PR_FIELDS_MAX_PATHS", MAX_PATHS))))
    except ValueError:
        return MAX_PATHS


def range_paths(clone, spec):
    """Every path any commit in the range changed, a merge's own resolution included, renames read as a delete and
    an add. NUL-separated, so a name with an accent, a tab or a newline is read exactly as git stores it. Read with
    a byte cap and a path cap; over either, the check is broken."""
    data = capped_output(["git", "-C", str(clone), "log", "--no-renames", "--diff-merges=separate", "--format=",
                          "--name-only", "-z", spec], spec)
    entries = [os.fsdecode(name) for name in data.split(b"\0") if name]  # exact names, byte for byte
    if len(entries) > path_cap():  # every entry counts, before any de-duplication
        raise Broken(f"the changed-path list for {spec} is over its cap of {path_cap()} paths")
    return sorted(set(entries))


def capped_output(command, what, max_bytes=MAX_BYTES, seconds=120):
    """A command's standard output, read up to max_bytes; over the cap, past the time limit, unable to start or
    failing, it is Broken. Shared with sb-plan, so both read changed paths the same bounded way."""
    try:
        proc = subprocess.Popen(command, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
    except OSError as error:
        raise Broken(f"cannot run git over {what}: {error}")
    timer = threading.Timer(seconds, proc.kill)
    timer.start()
    try:
        data = proc.stdout.read(max_bytes + 1)
        if len(data) > max_bytes:
            proc.kill()
            proc.wait()
            raise Broken(f"the changed-path list for {what} is over its cap of {max_bytes} bytes")
        code = proc.wait()
    finally:
        timer.cancel()
    if code != 0:
        raise Broken(f"cannot read the commits in {what} (git exit {code})")
    return data

PLAN_STEP = re.compile(r"^Plan-Step: \S+$", re.MULTILINE)
AI_TOOL = re.compile(r"^AI tool used:[ \t]*(.*)$", re.MULTILINE)
TIER_LINE = re.compile(r"^Tier:", re.MULTILINE)
COMMENT = re.compile(r"<!--.*?-->", re.DOTALL)
VERIFIED = re.compile(r"^Verified by running:[ \t]*(.*)$", re.MULTILINE)
TIER = re.compile(r"^Tier:[ \t]*([123])[ \t]*$", re.MULTILINE)


FIELD = re.compile(r"^(Plan-Step|AI tool used|Verified by running|Tier):")


def verified_has_content(body):
    """True when the Verified by running line, or a list item under it, says something."""
    found = VERIFIED.search(body)
    if not found:
        return False
    if meaningful(found.group(1)):
        return True
    for line in body[found.end():].split("\n"):
        if FIELD.match(line):
            return False
        if meaningful(line.strip().lstrip("-*")):
            return True
    return False


def meaningful(text):
    """A real answer: something other than a comment, punctuation or a template placeholder."""
    text = COMMENT.sub("", text).strip()
    if re.search(r"<[^<>\n]*>", text) or re.search(r"\b(TBD|TODO|FIXME)\b", text, re.IGNORECASE):
        return False
    return bool(re.search(r"[A-Za-z0-9]", text))


def problems(body, paths=(), rules=()):
    body = COMMENT.sub("", body)
    found = []
    if not PLAN_STEP.search(body):
        found.append("Plan-Step: no line names a plan step")
    tool = AI_TOOL.search(body)
    if not tool or not meaningful(tool.group(1)):
        found.append("AI tool used: the line is missing or empty")
    if not verified_has_content(body):
        found.append("Verified by running: the line is missing or nothing was listed")
    if len(TIER_LINE.findall(body)) != 1 or not TIER.search(body):
        found.append("Tier: there must be exactly one Tier line, of 1, 2 or 3")
    else:
        touched = [p for p in paths if is_tier1(p, rules)]
        if touched and TIER.search(body).group(1) != "1":
            shown = ", ".join(escaped(p) for p in touched[:5]) + (f" and {len(touched) - 5} more" if len(touched) > 5 else "")
            found.append(f"Tier: the change touches Tier 1 paths ({shown}), so the Tier line must be 1"
                         " (tier-understated)")
    return found


def escaped(path):
    """A changed path as printed: control bytes, newlines and non-ASCII escaped, so a name cannot forge a log line
    or a workflow annotation. Matching always uses the raw name."""
    return json.dumps(path, ensure_ascii=True)[1:-1]


def options(argv):
    """{} or {"--clone": ..., "--range": ...}; anything else is Broken."""
    if not argv:
        return {}
    if len(argv) != 4 or sorted(argv[0::2]) != ["--clone", "--range"]:
        raise Broken("pass both --clone <dir> and --range <base>..<head>, or neither")
    return dict(zip(argv[0::2], argv[1::2]))


def main():
    if "PR_BODY" not in os.environ:
        print("pr-fields: broken: PR_BODY is not set", file=sys.stderr)
        return 2
    body = os.environ["PR_BODY"].replace("\r\n", "\n")
    try:
        args = options(sys.argv[1:])
        paths = range_paths(args["--clone"], args["--range"]) if args else []
        rules = read_rules(pathlib.Path(__file__).resolve().parent) if args else ()  # an empty range still reads it
    except Broken as error:
        print(f"pr-fields: broken: {error}", file=sys.stderr)
        return 2
    found = problems(body, paths, rules)
    for line in found:
        print(f"pr-fields: refused: {line}")
    return 1 if found else 0


if __name__ == "__main__":
    sys.exit(main())
