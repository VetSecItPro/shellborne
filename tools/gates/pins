#!/usr/bin/env python3
"""Pin gate: every dependency, engine and image is pinned by exact revision or hash, and nothing is fetched at
build time without a checksum check (plan step P0.11.5).

Usage: pins [--tables-from <ref>] <repo>

Reads the tracked files of <repo> and refuses:
  - cargo-git-rev: a Cargo git dependency, in any dependency, workspace, target, patch or replace table, without a
    rev of exactly 40 lowercase hex characters; the patch tables of every tracked .cargo/config(.toml) count too;
  - cargo-source: a [source.*] table with replace-with, or a top-level paths override, in a tracked
    .cargo/config(.toml); a [source.*] git entry needs a 40-hex rev too (cargo-git-rev);
  - swiftpm-requirement: a remote .package( requirement in a Package.swift other than exact or a revision of exactly 40 lowercase hex characters, judged with string contents blanked;
  - missing-lockfile: a Cargo workspace root, or a crate outside any workspace that no other manifest names as a
    path dependency, with no tracked Cargo.lock beside it; a Package.swift with a remote dependency and no
    tracked Package.resolved beside it;
  - unlocked-build: a cargo command that resolves dependencies, in a workflow, a local action or a build script,
    without a locked flag;
  - (a download or cargo word inside a quoted argument of echo or printf is printed, not run, and is skipped; one in
    a quoted string a shell runs, sh -c or eval, is judged)
  - unverified-download: a download in a workflow, a local action or a build script that no checksum
    verification follows later in the same file. A checksum counts only when its pipeline holds a literal
    64-hex SHA-256 digest written in the file, so a digest file made from the download does not count. It counts only as a command: one inside a comment, a
    quoted string or an argument to another command (echo, printf, an assignment) does not. For a curl or wget,
    or any download word that is not git, the checksum's pipeline must also name the downloaded file: the -o,
    --output, -O or > target, else the URL's last path part, so a checksum of another file does not count. A
    git clone or fetch has no single file, so any later checksum command counts for it. A git fetch from the
    repository's own origin is not a download, whatever it fetches;
  - download-used-before-check: a downloaded file that any command names between its download and its first
    verifying checksum (it was extracted, run or copied unverified), or a download piped straight into another
    command (curl ... | sh), which no checksum can come before; reported on the download's line. A name inside a
    comment, the download's own command or a verifying checksum's pipeline is not a use. A git clone or fetch names
    no single file, so this rule does not judge what reads its tree (a stated limit);
  - ghostty-pin: a Ghostty pin (a PIN.toml under a ghostty folder) whose commit is not 40 lowercase hex;
  - zig-hash: a build.zig.zon dependency that is not a path inside the tree and has no hash;
  - docker-digest: a Dockerfile FROM, or a workflow container or service image, not pinned by sha256 digest.
The download, checksum and build words live in pins.toml beside this file; --tables-from <ref> reads it from
tools/gates/ at that commit of the repository instead, so in CI a pull request cannot drop a word. Each run first
proves every word refuses its own seeded line and passes its own verified or locked line; a word that cannot go red
breaks the run.

A build script is a tracked .sh, .bash, .zsh or .mk file, a Makefile or justfile, or a file with a shell shebang.
Workflow commands are read from run: values only: a literal block line by line, a folded block or a plain scalar
continued on deeper lines joined with spaces the way YAML joins them, and a run value inside a flow mapping.
A cargo command is judged on its masked text (no
comment, no quoted string) cut at the first bare --, so a flag in a comment or in a binary's own arguments is not a
locked flag; cargo global options and a +toolchain may stand before the subcommand. A tracked .cargo/config or
.cargo/config.toml is read like a manifest: a patch table needs a 40-hex rev, and a [source.*] table with
replace-with is refused (cargo-source). This gate reads text; it never builds, runs repository code or
uses the network, and it does not read a dependency's own build script. Files are listed and read through the
repo-rules reader, with its caps: tracked regular files only, never through a link, 2 MiB each. A refusal names the
rule and file:line, never the source. Exit 0 clean, 1 refused, 2 broken; a missing, malformed or empty table, a
manifest that does not parse, or an unreadable file is broken, never a pass.
"""
import importlib.machinery
import importlib.util
import pathlib
import posixpath
import re
import sys
import tomllib

HERE = pathlib.Path(__file__).resolve().parent
TABLE = "pins.toml"
MAX_FINDINGS = 1000
HEX_DIGEST = re.compile(r"(?<![0-9A-Fa-f])[0-9A-Fa-f]{64}(?![0-9A-Fa-f])")
REVISION = re.compile(r"^[0-9a-f]{40}$")
DIGEST = re.compile(r"@sha256:[0-9a-f]{64}$")
SCRIPT_SUFFIXES = (".sh", ".bash", ".zsh", ".mk")
SCRIPT_NAMES = ("Makefile", "makefile", "GNUmakefile", "justfile")
SHELL_SHEBANG = re.compile(r"^#!\s*\S*(?:/|\benv\s+)(?:ba|z|da|k)?sh\b")
DEPENDENCY_KEYS = ("dependencies", "dev-dependencies", "build-dependencies", "dev_dependencies", "build_dependencies")
SEPARATOR = re.compile(r"&&|\|\||;|\|")
PIPELINE_END = re.compile(r"&&|\|\||;")
SINGLE_PIPE = re.compile(r"(?<!\|)\|(?!\|)")
# Words that may stand before a command and still leave it in command position.
COMMAND_PREFIXES = {"if", "then", "do", "else", "elif", "while", "until", "!", "{", "(", "time", "sudo", "command",
                    "exec"}
CURL_OUTPUT = {"-o", "--output"}
WGET_OUTPUT = {"-O", "--output-document"}
# git fetch and pull options that take their value as the next word, so it is not read as the remote.
FETCH_VALUE_OPTIONS = {"-s", "--strategy", "-X", "--strategy-option", "--depth", "--deepen", "--shallow-since",
                       "--shallow-exclude", "--negotiation-tip", "--refmap", "-o", "--server-option", "-j", "--jobs", "--upload-pack", "--recurse-submodules-default"}
# A path that may lead a command word: absolute, home or relative with a dot, never a bare URL part.
PATH_PREFIX = r"(?:(?:\.{1,2}|~)?/[^\s;&|()\"'`]*)?"
# A +toolchain or an option, with an optional value, between a command and its subcommand.
OPTIONS = r"(?:\s+(?:\+\S+|--?[A-Za-z][\w-]*(?:=[^\s;&|]+)?(?:\s+(?!-)[^\s;&|]+)?))*"
CONTROL_URL = "https://example.invalid/control.tgz"
CONTROL_FILE = "control.tgz"
CONTROL_HASH = "0" * 64


def load(name, path):
    """A sibling gate, loaded as a module without writing bytecode next to it."""
    sys.dont_write_bytecode = True
    loader = importlib.machinery.SourceFileLoader(name, str(path))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


class Broken(Exception):
    pass


def word_pattern(command):
    """A command phrase as whole words, any run of white space between them. A path may lead the first word
    (/usr/bin/curl), and a toolchain or any number of options with an optional value may stand between the first
    word and the rest (git -C dir fetch is git fetch; cargo -v build is cargo build)."""
    words = command.split()
    between = OPTIONS if len(words) > 1 else ""
    body = re.escape(words[0]) + between + "".join(r"\s+" + re.escape(word) for word in words[1:])
    return re.compile(r"(?<![\w./:-])" + PATH_PREFIX + body + r"(?![\w.-])")


def load_rules(text):
    try:
        data = tomllib.loads(text)
    except tomllib.TOMLDecodeError as error:
        raise Broken(f"{TABLE} is malformed: {error}")
    shape = {"downloads": {"commands"}, "checksums": {"commands"}, "builds": {"commands", "locked"}}
    if set(data) != set(shape) or any(not isinstance(data[key], dict) or set(data[key]) != fields
                                      for key, fields in shape.items()):
        raise Broken(f"{TABLE} must hold exactly [downloads], [checksums] and [builds] with their word lists, "
                     "so no rule is left without words")
    rules = {}
    for key, fields in shape.items():
        for field in fields:
            values = data[key][field]
            if (not isinstance(values, list) or not values or len(values) > 200
                    or not all(isinstance(v, str) and v.strip() and len(v) <= 100 for v in values)):
                raise Broken(f"{TABLE}: [{key}] {field} must be a list of words, and an empty list cannot fail")
            rules[(key, field)] = [" ".join(v.split()) for v in values]
    return {
        "downloads": [(word, word_pattern(word)) for word in rules[("downloads", "commands")]],
        "checksums": [word_pattern(word) for word in rules[("checksums", "commands")]],
        "builds": [word_pattern(word) for word in rules[("builds", "commands")]],
        "locked": rules[("builds", "locked")],
        "words": rules,
    }


def logical_lines(numbered):
    """(first line number, text) with backslash continuations joined and comment lines dropped."""
    pending, start = None, None
    for number, line in numbered:
        if pending is None:
            if line.strip().startswith("#"):
                continue
            pending, start = "", number
        if line.rstrip().endswith("\\"):
            pending += line.rstrip()[:-1] + " "
            continue
        yield start, pending + line
        pending = None
    if pending is not None:
        yield start, pending


def segment_after(text, index):
    """The command from index to the next shell separator."""
    found = SEPARATOR.search(text, index)
    return text[index:found.start() if found else len(text)]


def shell_mask(text):
    """(masked, code) for one logical shell line, both the length of text. masked has every quoted string, quotes
    included, and the comment blanked; code has only the comment blanked. A comment starts at a # that begins a
    word outside quotes."""
    masked, code, index, quote = list(text), list(text), 0, None
    while index < len(text):
        char = text[index]
        if quote:
            if quote == '"' and char == "\\" and index + 1 < len(text):
                masked[index] = masked[index + 1] = " "
                index += 2
                continue
            if char == quote:
                quote = None
            masked[index] = " "
        elif char == "\\" and index + 1 < len(text):
            index += 2
            continue
        elif char in "'\"":
            quote = char
            masked[index] = " "
        elif char == "#" and (index == 0 or text[index - 1].isspace() or text[index - 1] in ";&|("):
            for at in range(index, len(text)):
                masked[at] = code[at] = " "
            break
        index += 1
    return "".join(masked), "".join(code)


def in_command_position(masked, start):
    """True when only command prefix words stand between the last shell separator and start."""
    head = masked[:start]
    last = 0
    for found in SEPARATOR.finditer(head):
        last = found.end()
    return all(word in COMMAND_PREFIXES for word in head[last:].split())


def download_name(word, arguments):
    """The file a download writes, or None when it names no single file (a git clone or fetch)."""
    tool = word.split()[0]
    if tool == "git":
        return None
    words = [part.strip("\"'") for part in arguments.split()]
    outputs = CURL_OUTPUT if tool == "curl" else WGET_OUTPUT if tool == "wget" else set()
    url = None
    index = 0
    while index < len(words):
        part = words[index]
        if part == ">" and index + 1 < len(words):
            return words[index + 1]
        if part.startswith(">") and len(part) > 1:
            return part.lstrip(">")
        if part in outputs and index + 1 < len(words):
            if words[index + 1] != "-":
                return words[index + 1]
            index += 2
            continue
        option = next((flag for flag in outputs if flag.startswith("--") and part.startswith(flag + "=")), None)
        if option:
            return part.split("=", 1)[1]
        short = next((flag for flag in outputs if not flag.startswith("--")), None)
        if short and part.startswith("-") and not part.startswith("--") and short[1] in part[1:]:
            rest = part[part.index(short[1], 1) + 1:]
            if rest:
                return rest
            if index + 1 < len(words) and words[index + 1] != "-":
                return words[index + 1]
            index += 2
            continue
        if url is None and not part.startswith("-"):
            url = part
        index += 1
    if url is None:
        return None
    last = url.split("?", 1)[0].split("#", 1)[0].rstrip("/").rsplit("/", 1)[-1]
    return last or None


def names_file(text, name):
    return bool(re.search(r"(?<![\w./-])" + re.escape(name) + r"(?![\w-])", text))


def fetch_from_origin(arguments):
    """True when a git fetch names no remote, or the repository's own origin."""
    words = [word.strip("\"'") for word in arguments.split()]
    index = 0
    while index < len(words):
        word = words[index]
        if word in ("--all", "--multiple"):
            return False
        if word.startswith("-"):
            index += 2 if word in FETCH_VALUE_OPTIONS else 1
            continue
        return word == "origin"
    return True


def pipeline_span(masked, start):
    """(begin, end) of the pipeline holding start, bounded by ;, && and ||, never a single |."""
    begin = 0
    for found in PIPELINE_END.finditer(masked[:start]):
        begin = found.end()
    end = PIPELINE_END.search(masked, start)
    return begin, end.start() if end else len(masked)


PRINTERS = ("echo", "printf")  # print their arguments and run nothing


def printed(text, masked, start):
    """True when start is inside a quoted argument of echo or printf, which only print it; a quoted
    string a shell runs (sh -c, bash -c, eval) is not printed, so it is still judged."""
    if masked[start] == text[start]:
        return False
    if "$(" in text or "`" in text:  # a command substitution runs inside a printed string
        return False
    head = masked[:start]
    last = 0
    for found in SEPARATOR.finditer(head):
        last = found.end()
    words = [word for word in head[last:].split() if word not in COMMAND_PREFIXES]
    return bool(words) and words[0].rsplit("/", 1)[-1] in PRINTERS


def mentions(code, name):
    """Each start index where a command line names the file, also through a path (./tool.tgz, "$DIR/tool.tgz"): a use
    is matched by the file's own name after a slash too, which fails closed."""
    base = posixpath.basename(name.rstrip("/")) or name
    return [found.start() for found in re.finditer(r"(?<![\w.-])" + re.escape(base) + r"(?![\w-])", code)]


def command_findings(lines, rules):
    """(rule, line number) for each unlocked build and unverified download in a file's command lines."""
    found, downloads, checks, codes = [], [], [], {}
    for number, text in lines:
        masked, code = shell_mask(text)
        codes[number] = code
        for pattern in rules["builds"]:
            for match in pattern.finditer(text):
                if printed(text, masked, match.start()):
                    continue
                source = masked if masked[match.start()] == text[match.start()] else code  # a quoted command
                rest = segment_after(source, match.end()).split()
                rest = rest[:rest.index("--")] if "--" in rest else rest  # after -- the words are the binary's
                rest = [word.strip("\"'") for word in rest]
                if not any(word == flag or word.startswith(flag + "=") for word in rest for flag in rules["locked"]):
                    found.append(("unlocked-build", number))
        for word, pattern in rules["downloads"]:
            for match in pattern.finditer(text):
                if printed(text, masked, match.start()):
                    continue
                if word in ("git fetch", "git pull") and fetch_from_origin(segment_after(text, match.end())):
                    continue
                _, until = pipeline_span(masked, match.end())
                piped = bool(SINGLE_PIPE.search(masked, match.end(), until))  # curl ... | sh
                downloads.append((number, match.start(), match.end(), until,
                                  download_name(word, segment_after(code, match.end())), piped))
        for pattern in rules["checksums"]:
            for match in pattern.finditer(masked):
                if in_command_position(masked, match.start()):
                    begin, end = pipeline_span(masked, match.start())
                    pipeline = code[begin:end]
                    if HEX_DIGEST.search(pipeline):  # a digest file made from the download proves nothing
                        checks.append((number, match.start(), pipeline, begin, end))
    for number, start, end, until, name, piped in downloads:
        verifying = [(check_number, at, begin, stop) for check_number, at, pipeline, begin, stop in checks
                     if (check_number, at) > (number, end) and (name is None or names_file(pipeline, name))]
        if not verifying:
            found.append(("unverified-download", number))
            continue
        if piped:
            found.append(("download-used-before-check", number))
            continue
        if name is None:
            continue
        first_number, _, first_begin, _ = min(verifying)

        def excused(line, index):
            """The download's own command, or any verifying checksum's pipeline, names the file without using it."""
            if line == number and start <= index < until:
                return True
            return any(line == check_line and begin <= index < stop
                       for check_line, _, begin, stop in verifying)
        used = any((number, end) < (line, index) < (first_number, first_begin) and not excused(line, index)
                   for line, code in codes.items() for index in mentions(code, name))
        if used:
            found.append(("download-used-before-check", number))
    return found


def prove_controls(rules):
    """Every word must refuse its own seeded line and pass its own verified or locked line."""
    first_check = rules["words"][("checksums", "commands")][0]
    for check in rules["words"][("checksums", "commands")]:
        made = [(1, f"{rules['downloads'][0][0]} {CONTROL_URL}"), (2, f"{check} {CONTROL_FILE}.sha256")]
        if ("unverified-download", 1) not in command_findings(made, rules):
            raise Broken("a checksum of a digest file made from the download counts as a check")
    verified = f'echo "{CONTROL_HASH}  {CONTROL_FILE}" | {{check}} -'
    for word, _ in rules["downloads"]:
        bad = command_findings([(1, f"{word} {CONTROL_URL}")], rules)
        good = command_findings([(1, f"{word} {CONTROL_URL}"), (2, verified.format(check=first_check))], rules)
        if ("unverified-download", 1) not in bad or good:
            raise Broken("a download word does not refuse its own seeded download")
    first_download = rules["downloads"][0][0]
    unchecked = [f"true # {{check}} {CONTROL_FILE}.sha256", f'echo "{{check}} {CONTROL_FILE}.sha256"',
                 f"echo '{{check}} {CONTROL_FILE}.sha256'"]
    for check in rules["words"][("checksums", "commands")]:
        if command_findings([(1, f"{first_download} {CONTROL_URL}"), (2, verified.format(check=check))], rules):
            raise Broken("a checksum word does not pass its own verified download")
        for line in unchecked:
            if ("unverified-download", 1) not in command_findings(
                    [(1, f"{first_download} {CONTROL_URL}"), (2, line.format(check=check))], rules):
                raise Broken("a checksum named in a comment or a quoted string counts as a check")
    for word, _ in rules["downloads"]:
        if word.split()[0] == "git":
            continue
        other = f'echo "{CONTROL_HASH}  other-{CONTROL_FILE}" | {first_check} -'
        if ("unverified-download", 1) not in command_findings([(1, f"{word} {CONTROL_URL}"), (2, other)], rules):
            raise Broken("a checksum of another file counts for a download")
    for word, _ in rules["downloads"]:  # verification comes before the first use
        if word.split()[0] == "git":
            continue
        used = [(1, f"{word} {CONTROL_URL}"), (2, f"tar -xzf {CONTROL_FILE}"), (3, verified.format(check=first_check))]
        if ("download-used-before-check", 1) not in command_findings(used, rules):
            raise Broken("a download used before its checksum passes")
        if ("download-used-before-check", 1) not in command_findings(
                [(1, f"{word} {CONTROL_URL} | sh"), (2, verified.format(check=first_check))], rules):
            raise Broken("a download piped into a command passes")
        if command_findings([(1, f"{word} {CONTROL_URL}"), (2, verified.format(check=first_check)),
                             (3, f"tar -xzf {CONTROL_FILE}")], rules):
            raise Broken("a download verified before its first use is refused")
    for word in rules["words"][("builds", "commands")]:
        if ("unlocked-build", 1) not in command_findings([(1, word)], rules):
            raise Broken("a build word does not refuse its own seeded build")
        if command_findings([(1, f"{word} {rules['locked'][0]}")], rules):
            raise Broken("a build word does not pass its own locked build")


FLOW_RUN = re.compile(r"[{,]\s*(?:run|\"run\"|'run')\s*:\s*(\"(?:[^\"\\]|\\.)*\"|'(?:[^']|'')*'|[^,}]*)")
KEY_LINE = re.compile(r"^\s*(?:-\s+)?[A-Za-z_][\w-]*\s*:(?:\s|$)")


YAML_ESCAPES = {"0": "\0", "a": "\a", "b": "\b", "t": "\t", "\t": "\t", "n": "\n", "v": "\v", "f": "\f",
                "r": "\r", "e": "\x1b", " ": " ", '"': '"', "/": "/", "\\": "\\", "N": "\x85", "_": "\xa0",
                "L": "\u2028", "P": "\u2029"}
YAML_HEX = {"x": 2, "u": 4, "U": 8}


def yaml_double(body):
    """A double-quoted YAML scalar's escapes decoded as YAML defines them, so the gate reads the command GitHub runs;
    an escape YAML does not define is kept as written."""
    out, index = [], 0
    while index < len(body):
        char = body[index]
        if char != "\\" or index + 1 >= len(body):
            out.append(char)
            index += 1
            continue
        code = body[index + 1]
        if code in YAML_ESCAPES:
            out.append(YAML_ESCAPES[code])
            index += 2
        elif code in YAML_HEX and re.fullmatch(r"[0-9A-Fa-f]+", body[index + 2:index + 2 + YAML_HEX[code]] or "x") \
                and len(body[index + 2:index + 2 + YAML_HEX[code]]) == YAML_HEX[code]:
            out.append(chr(int(body[index + 2:index + 2 + YAML_HEX[code]], 16)))
            index += 2 + YAML_HEX[code]
        else:
            out.append(char)
            index += 1
    return "".join(out)


def yaml_scalar(value):
    """A whole single- or double-quoted YAML scalar without its quotes; any other value as it is."""
    if len(value) >= 2 and value[0] == value[-1] == '"':
        return yaml_double(value[1:-1])
    if len(value) >= 2 and value[0] == value[-1] == "'":
        return value[1:-1].replace("''", "'")
    return value


def indent_of(line):
    return len(line) - len(line.lstrip())


def run_lines(lines):
    """(line number, text) of every command inside a workflow or action run: value, in every YAML form:
    a literal block line by line; a folded block or a plain scalar continued on deeper lines joined with spaces, as
    YAML joins them, at the first line; and a run value inside a flow mapping."""
    index = 0
    while index < len(lines):
        match = re.match(r"^(\s*(?:-\s+)?)(?:run|\"run\"|'run')\s*:\s*(.*)$", lines[index])
        if not match:
            for flow in FLOW_RUN.finditer(lines[index]):
                value = yaml_scalar(flow.group(1).strip())
                if value:
                    yield index + 1, value
            index += 1
            continue
        indent = len(match.group(1))  # the column of the run key; a block value sits deeper
        value = match.group(2).strip()
        if value[:1] in ("|", ">"):
            folded = value[:1] == ">"
            index += 1
            block = []
            while index < len(lines) and (not lines[index].strip() or indent_of(lines[index]) > indent):
                block.append((index + 1, lines[index]))
                index += 1
            if not folded:
                yield from block
                continue
            paragraph, first = [], None
            for number, text in block + [(None, "")]:
                if text.strip():
                    first = first or number
                    paragraph.append(text.strip())
                elif paragraph:
                    yield first, " ".join(paragraph)
                    paragraph, first = [], None
            continue
        first = index + 1
        index += 1
        if not value or value.startswith("#"):
            continue
        parts = [value]
        while (index < len(lines) and lines[index].strip() and indent_of(lines[index]) > indent
               and not KEY_LINE.match(lines[index])):
            parts.append(lines[index].strip())
            index += 1
        yield first, yaml_scalar(" ".join(parts)) if len(parts) > 1 or value[:1] in "\"'" else value


def is_script(rr, repo, name):
    path = pathlib.PurePosixPath(name)
    if path.suffix.lower() in SCRIPT_SUFFIXES or path.name in SCRIPT_NAMES:
        return True
    if path.suffix or not rr.starts_with_shebang(repo, name):
        return False
    first = rr.read_source(repo, name).split("\n", 1)[0]
    return bool(SHELL_SHEBANG.match(first))


def is_dockerfile(name):
    base = pathlib.PurePosixPath(name).name
    return base in ("Dockerfile", "Containerfile") or base.startswith("Dockerfile.") or base.lower().endswith(".dockerfile")


def toml_keys(text):
    """Yield (1-based line, key path) for each table header and each key line, so a finding names the line."""
    current = ()
    for number, line in enumerate(text.splitlines(), 1):
        header = re.match(r"^\s*\[\s*([^\[\]]+?)\s*\]\s*(?:#.*)?$", line)
        if header:
            current = dotted(header.group(1))
            yield number, current
            continue
        key = re.match(r"^\s*((?:\"[^\"]*\"|'[^']*'|[\w-]+)(?:\s*\.\s*(?:\"[^\"]*\"|'[^']*'|[\w-]+))*)\s*=", line)
        if key:
            yield number, current + dotted(key.group(1))


def dotted(text):
    return tuple(a or b or c for a, b, c in re.findall(r"\"([^\"]*)\"|'([^']*)'|([\w-]+)", text))


def locate(text, path):
    for number, keys in toml_keys(text):
        if keys[:len(path)] == path:
            return number
    return 1


def dependency_tables(data):
    """(key path, table) for every table of dependencies a Cargo manifest can hold."""
    for key in DEPENDENCY_KEYS:
        yield (key,), data.get(key)
    targets = data.get("target")
    for target, body in (targets.items() if isinstance(targets, dict) else []):
        for key in DEPENDENCY_KEYS:
            yield ("target", target, key), body.get(key) if isinstance(body, dict) else None
    workspace = data.get("workspace")
    yield ("workspace", "dependencies"), workspace.get("dependencies") if isinstance(workspace, dict) else None
    patches = data.get("patch")
    for registry, body in (patches.items() if isinstance(patches, dict) else []):
        yield ("patch", registry), body
    yield ("replace",), data.get("replace")


def is_cargo_config(name):
    path = pathlib.PurePosixPath(name)
    return path.name in ("config", "config.toml") and path.parent.name == ".cargo"


def check_cargo_config(rr, repo, names, findings):
    """A tracked .cargo/config(.toml): its patch tables are judged like a manifest's, and a source replacement is
    refused, because it changes where every dependency comes from."""
    for name in filter(is_cargo_config, names):
        text = rr.read_source(repo, name)
        try:
            data = tomllib.loads(text)
        except tomllib.TOMLDecodeError:
            raise Broken(f"{rr.shown(name)} is not valid TOML")
        patches = data.get("patch")
        for registry, table in (patches.items() if isinstance(patches, dict) else []):
            for dependency, spec in (table.items() if isinstance(table, dict) else []):
                if isinstance(spec, dict) and "git" in spec and not REVISION.match(str(spec.get("rev", ""))):
                    where = ("patch", registry, dependency)
                    findings.append(("cargo-git-rev", f"{rr.shown(name)}:{locate(text, where)}"))
        sources = data.get("source")
        for source, table in (sources.items() if isinstance(sources, dict) else []):
            if isinstance(table, dict) and "replace-with" in table:
                findings.append(("cargo-source", f"{rr.shown(name)}:{locate(text, ('source', source, 'replace-with'))} "
                                                 "(a source replacement)"))
            if isinstance(table, dict) and "git" in table and not REVISION.match(str(table.get("rev", ""))):
                findings.append(("cargo-git-rev", f"{rr.shown(name)}:{locate(text, ('source', source, 'git'))}"))
        if "paths" in data:  # a paths override puts local folders in place of crates
            findings.append(("cargo-source", f"{rr.shown(name)}:{locate(text, ('paths',))} (a paths override)"))


def check_cargo(rr, repo, names, findings):
    check_cargo_config(rr, repo, names, findings)
    tracked = set(names)
    manifests = {}
    for name in names:
        if pathlib.PurePosixPath(name).name == "Cargo.toml":
            text = rr.read_source(repo, name)
            try:
                manifests[name] = (text, tomllib.loads(text))
            except tomllib.TOMLDecodeError:
                raise Broken(f"{rr.shown(name)} is not valid TOML")
    path_targets = set()
    for name, (text, data) in manifests.items():
        folder = posixpath.dirname(name)
        for where, table in dependency_tables(data):
            for dependency, spec in (table.items() if isinstance(table, dict) else []):
                if not isinstance(spec, dict):
                    continue
                if "path" in spec and isinstance(spec["path"], str):
                    path_targets.add(posixpath.normpath(posixpath.join(folder, spec["path"])))
                if "git" in spec and not REVISION.match(str(spec.get("rev", ""))):
                    findings.append(("cargo-git-rev", f"{rr.shown(name)}:{locate(text, where + (dependency,))}"))
    roots = {posixpath.dirname(name) for name, (_, data) in manifests.items() if "workspace" in data}
    for name, (_, data) in manifests.items():
        folder = posixpath.dirname(name)
        lock = posixpath.join(folder, "Cargo.lock") if folder else "Cargo.lock"
        if "workspace" in data:
            needs = True
        else:
            member = any(root == "" or folder.startswith(root + "/") for root in roots if root != folder)
            needs = "package" in data and not member and posixpath.normpath(folder or ".") not in path_targets
        if needs and lock not in tracked:
            findings.append(("missing-lockfile", f"{rr.shown(name)} (no tracked Cargo.lock beside it)"))


def swift_blank(text):
    """The text with // and /* */ comments blanked outside strings, newlines kept."""
    out, index, quote = [], 0, False
    while index < len(text):
        char = text[index]
        if quote:
            if char == "\\" and index + 1 < len(text):
                out.append(text[index:index + 2])
                index += 2
                continue
            if char in '"\n':
                quote = False
            out.append(char)
        elif char == '"':
            quote = True
            out.append(char)
        elif text.startswith("//", index) or text.startswith("/*", index):
            end = text.find("\n", index) if text[index + 1] == "/" else text.find("*/", index + 2) + 2
            end = len(text) if end < index + 2 else end
            out.append("".join("\n" if c == "\n" else " " for c in text[index:end]))
            index = end
            continue
        else:
            out.append(char)
        index += 1
    return "".join(out)


def blank_strings(text):
    """The text with the inside of every string literal blanked, quotes and length kept."""
    out, index, quote = [], 0, False
    while index < len(text):
        char = text[index]
        if quote and char == "\\" and index + 1 < len(text):
            out.append("  ")
            index += 2
            continue
        if char == '"':
            quote = not quote
            out.append(char)
        else:
            out.append(" " if quote and char != "\n" else char)
        index += 1
    return "".join(out)


def revision_problem(arguments, blanked):
    """True when a revision requirement in the call holds anything but a literal of 40 lowercase hex characters;
    the form is found in the blanked text and the value read from the original."""
    forms = list(re.finditer(r"\brevision\s*:|\.revision\s*\(", blanked))
    if not forms:
        return False
    for form in forms:
        value = re.match(r"\s*\"([^\"]*)\"", arguments[form.end():])
        if value and REVISION.match(value.group(1)):
            return False
    return True


def package_calls(text):
    """(1-based line, argument text) of each .package( call; raises ValueError when one never closes."""
    clean = swift_blank(text)
    for match in re.finditer(r"\.package\s*\(", clean):
        depth, index, quote = 1, match.end(), False
        while index < len(clean) and depth:
            char = clean[index]
            if quote:
                if char == "\\":
                    index += 1
                elif char == '"':
                    quote = False
            elif char == '"':
                quote = True
            else:
                depth += {"(": 1, ")": -1}.get(char, 0)
            index += 1
        if depth:
            raise ValueError("a .package( call never closes")
        yield clean.count("\n", 0, match.start()) + 1, clean[match.end():index - 1]


def check_swift(rr, repo, names, findings):
    tracked = set(names)
    for name in names:
        if pathlib.PurePosixPath(name).name != "Package.swift":
            continue
        try:
            calls = list(package_calls(rr.read_source(repo, name)))
        except ValueError as error:
            raise Broken(f"cannot read {rr.shown(name)}: {error}")
        remote = False
        for number, arguments in calls:
            blanked = blank_strings(arguments)
            if re.search(r"\bpath\s*:", blanked) and not re.search(r"\burl\s*:", blanked):
                continue  # a package inside the tree
            remote = True
            if not re.search(r"\bexact\s*:|\.exact\s*\(", blanked) and (
                    not re.search(r"\brevision\s*:|\.revision\s*\(", blanked) or revision_problem(arguments, blanked)):
                findings.append(("swiftpm-requirement",
                                 f"{rr.shown(name)}:{number} (neither exact nor a 40-hex revision)"))
        folder = posixpath.dirname(name)
        resolved = posixpath.join(folder, "Package.resolved") if folder else "Package.resolved"
        if remote and resolved not in tracked:
            findings.append(("missing-lockfile", f"{rr.shown(name)} (no tracked Package.resolved beside it)"))


def check_ghostty(rr, deps, repo, names, findings):
    for name in filter(deps.ghostty_pin, names):
        text = rr.read_source(repo, name)
        try:
            commit = tomllib.loads(text).get("commit", "")
        except tomllib.TOMLDecodeError:
            raise Broken(f"{rr.shown(name)} is not valid TOML")
        if not REVISION.match(str(commit)):
            number = deps.line_holding(text, r"^\s*commit\s*=")
            findings.append(("ghostty-pin", f"{rr.shown(name)}:{number} (not a 40-hex commit)"))


def check_zig(rr, deps, repo, names, findings):
    for name in names:
        if pathlib.PurePosixPath(name).name != "build.zig.zon":
            continue
        try:
            entries = deps.zon_dependencies(rr.read_source(repo, name))
        except ValueError as error:
            raise Broken(f"cannot read {rr.shown(name)}: {error}")
        for _, number, fields in entries:
            if not fields.get("hash") and not ("path" in fields and "url" not in fields):
                findings.append(("zig-hash", f"{rr.shown(name)}:{number} (a dependency with no hash)"))


def image_pinned(image, stages):
    return image == "scratch" or image.lower() in stages or bool(DIGEST.search(image))


def docker_findings(text):
    stages, found = set(), []
    for number, line in logical_lines(enumerate(text.splitlines(), 1)):
        match = re.match(r"^\s*FROM\s+(?:--\S+\s+)*(\S+)(?:\s+AS\s+(\S+))?", line, re.IGNORECASE)
        if match:
            if not image_pinned(match.group(1), stages):
                found.append(number)
            if match.group(2):
                stages.add(match.group(2).lower())
    return found


def workflow_image_findings(lines, action):
    found = []
    for number, line in enumerate(lines, 1):
        match = re.match(r"^\s*(?:-\s+)?(container|image)\s*:\s*(.*)$", line)
        if not match:
            continue
        value = match.group(2).split(" #", 1)[0].strip().strip("\"'")
        if not value or value.startswith("#"):
            continue  # a mapping follows; its image: line is judged on its own
        local = action and match.group(1) == "image" and ":" not in value and value.endswith("Dockerfile")
        if not local and not DIGEST.search(value):
            found.append(number)
    return found


def main(argv):
    ref = None
    if len(argv) == 3 and argv[0] == "--tables-from":
        ref, argv = argv[1], argv[2:]
    if len(argv) != 1 or argv[0].startswith("-"):
        print("pins: broken: usage: pins [--tables-from <ref>] <repo>", file=sys.stderr)
        return 2
    repo = pathlib.Path(argv[0])
    try:
        rr = load("repo_rules", HERE / "repo-rules")
        deps = load("deps_gate", HERE / "deps")
    except Exception as error:  # a reader that cannot load is a broken check, never a pass
        print(f"pins: broken: cannot load the repo-rules reader: {type(error).__name__}", file=sys.stderr)
        return 2
    findings = []
    try:
        rules = load_rules(deps.table_text(repo, ref, TABLE))
        prove_controls(rules)
        names = rr.tracked(repo)
        check_cargo(rr, repo, names, findings)
        check_swift(rr, repo, names, findings)
        check_ghostty(rr, deps, repo, names, findings)
        check_zig(rr, deps, repo, names, findings)
        for name in names:
            workflow = name.startswith(".github/workflows/") and name.endswith((".yml", ".yaml"))
            action = name.startswith(".github/actions/") and pathlib.PurePosixPath(name).name in ("action.yml", "action.yaml")
            if workflow or action:
                lines = rr.read_source(repo, name).splitlines()
                commands = list(logical_lines(run_lines(lines)))
                images = workflow_image_findings(lines, action)
            elif is_dockerfile(name):
                commands, images = [], docker_findings(rr.read_source(repo, name))
            elif is_script(rr, repo, name):
                commands = list(logical_lines(enumerate(rr.read_source(repo, name).splitlines(), 1)))
                images = []
            else:
                continue
            for rule, number in command_findings(commands, rules):
                findings.append((rule, f"{rr.shown(name)}:{number}"))
            for number in images:
                findings.append(("docker-digest", f"{rr.shown(name)}:{number} (an image with no sha256 digest)"))
    except (Broken, deps.Broken, rr.Broken) as error:
        print(f"pins: broken: {error}", file=sys.stderr)
        return 2
    except Exception as error:  # an unexpected failure is a broken check, never a refusal and never a pass
        print(f"pins: broken: unexpected {type(error).__name__}", file=sys.stderr)
        return 2
    for kind, where in findings[:MAX_FINDINGS]:
        print(f"pins: refused {kind} {where}", file=sys.stderr)
    if len(findings) > MAX_FINDINGS:
        print(f"pins: refused: {len(findings) - MAX_FINDINGS} more refusals not listed", file=sys.stderr)
    return 1 if findings else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
