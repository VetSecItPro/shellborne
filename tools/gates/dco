#!/usr/bin/env python3
"""DCO gate: every commit carries a Developer Certificate of Origin sign-off by its author.

Usage: dco <repo> <range>     <range> is anything git rev-list accepts: HEAD, base..head

A commit passes when the trailers git parses from its message (git interpret-trailers) include a
`Signed-off-by:` trailer whose own value names the commit author's email. A sign-off in the body,
or an empty sign-off followed by another line, does not count. Merge commits are checked like any other.
Exit 0 clean, 1 refused, 2 broken. One line per refused commit, naming its short hash.
Plan-Step: P0.2.4
"""
import re
import subprocess
import sys

SIGN_OFF = re.compile(r"^Signed-off-by:[ \t]*[^<\n]*\S[^<\n]*<([^<>\s]+@[^<>\s]+)>[ \t]*$", re.IGNORECASE)


def git(repo, *args, stdin=None):
    return subprocess.run(["git", "-C", repo, *args], capture_output=True, text=True, timeout=120, input=stdin)


def trailers(repo, body):
    parsed = git(repo, "interpret-trailers", "--parse", "--no-divider", stdin=body)
    if parsed.returncode != 0:
        return None
    return parsed.stdout.splitlines()


def main(argv):
    if len(argv) != 3:
        print("usage: dco <repo> <range>", file=sys.stderr)
        return 2
    repo, spec = argv[1], argv[2]
    listed = git(repo, "rev-list", spec)
    if listed.returncode != 0:
        print(f"dco: cannot list commits for {spec}: {listed.stderr.strip()}", file=sys.stderr)
        return 2
    refused = 0
    for sha in listed.stdout.split():
        shown = git(repo, "show", "-s", "--format=%ae%x00%B", sha)
        if shown.returncode != 0 or "\x00" not in shown.stdout:
            print(f"dco: cannot read commit {sha[:12]}", file=sys.stderr)
            return 2
        email, body = shown.stdout.split("\x00", 1)
        lines = trailers(repo, body)
        if lines is None:
            print(f"dco: cannot parse the trailers of {sha[:12]}", file=sys.stderr)
            return 2
        signers = {m.group(1).lower() for m in map(SIGN_OFF.match, lines) if m}
        if email.strip().lower() not in signers:
            print(f"dco: {sha[:12]}: no Signed-off-by line for the commit author (use git commit -s)")
            refused += 1
    return 1 if refused else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
