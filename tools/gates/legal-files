#!/usr/bin/env python3
"""Legal-files gate: the files every public commit must carry.

Usage: legal-files <repo>

Checks LICENSE is byte-for-byte the canonical Apache License 2.0, NOTICE is not empty, SECURITY.md
names a contact with a GitHub handle or email and a private reporting path, TRADEMARKS.md reserves the name and the logo, and CONTRIBUTING.md
asks for DCO sign-off and states there is no CLA.
Exit 0 clean, 1 refused, 2 broken. One line per finding, naming the file.
Keyword checks cannot catch a contrary rewording of the trademark policy or contributor guide;
those files are owned by the maintainer in CODEOWNERS, so a change to them needs that review.
Plan-Step: P0.2.2
"""
import hashlib
import pathlib
import re
import sys

# sha256 of the canonical text at https://www.apache.org/licenses/LICENSE-2.0.txt
APACHE_2_SHA256 = "cfc7749b96f63bd31c3c42b5c471bf756814053e847c10f3eb003417bc523d30"

CHECKS = {
    "NOTICE": [(r"\S", "is empty")],
    "SECURITY.md": [(r"(?im)^\s*(?:[-*]\s+)?\**contact\**\s*:\**[^\n]*(?:@[A-Za-z0-9][A-Za-z0-9-]*|[\w.+-]+@[\w-]+\.[\w.-]+)",
                     "names no contact with a GitHub handle or email (a 'Contact:' line)"),
                    (r"(?i)private vulnerability report|security advisor", "gives no private reporting path")],
    "TRADEMARKS.md": [(r"(?i)\bname\b", "does not reserve the name"), (r"(?i)\blogo\b", "does not reserve the logo")],
    "CONTRIBUTING.md": [(r"Signed-off-by", "does not ask for DCO sign-off"),
                        (r"(?i)\bno (CLA|contributor license agreement)\b", "does not state there is no CLA")],
}


def main(argv):
    if len(argv) != 2:
        print("usage: legal-files <repo>", file=sys.stderr)
        return 2
    repo = pathlib.Path(argv[1])
    if not repo.is_dir():
        print(f"legal-files: {repo} is not a folder", file=sys.stderr)
        return 2
    findings = []
    license_path = repo / "LICENSE"
    if not license_path.is_file():
        findings.append("LICENSE: missing")
    elif hashlib.sha256(license_path.read_bytes()).hexdigest() != APACHE_2_SHA256:
        findings.append("LICENSE: is not the canonical Apache License 2.0 text")
    for name, rules in CHECKS.items():
        path = repo / name
        if not path.is_file():
            findings.append(f"{name}: missing")
            continue
        text = path.read_text(errors="replace")
        findings.extend(f"{name}: {why}" for pattern, why in rules if not re.search(pattern, text))
    for line in findings:
        print(f"legal-files: {line}")
    return 1 if findings else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
