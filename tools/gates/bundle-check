#!/usr/bin/env python3
"""Bundle gate: no built bundle registers a URL scheme or an executing document type (plan step P0.11.7).

Usage: bundle-check <built-folder> [--tables-from <ref> --repo <repo>]

Reads every regular file named Info.plist under the built folder: the app, the daemon and every nested helper. It
refuses:
  - url-scheme: any CFBundleURLTypes key, even an empty one;
  - document-type: a CFBundleDocumentTypes entry whose LSItemContentTypes are not all on the allowlist, or that
    names none (an entry known only by extension is refused);
  - exported-type: a UTExportedTypeDeclarations entry whose UTTypeIdentifier is not on the allowlist.
The allowlist is bundle-check.toml beside this file: [[allow]] entries, each with a kind (document or exported),
one exact identifier with no wildcard and a real reason. It starts empty. With --tables-from the table is read
from tools/gates/ at that commit of the repository named by --repo instead, so a branch cannot allow its own type.

Each plist is read with a plist parser, XML or binary, at most 2 MiB, opened without following a link; a symlinked
or special Info.plist breaks the run and is never followed, and so does a plist that does not parse. The walk never
follows a symlinked folder and stops at a file cap. A folder with no Info.plist is not run, never clean. A refusal
names the rule and the plist's path under the built folder and never prints its contents. Each run first proves the
gate refuses its own seeded plist with a scheme; if it does not, the gate is broken. Limit: it checks the declared
plist, not a registration made at run time by other means. Exit 0 clean, 1 refused, 2 broken or not run.
"""
import importlib.machinery
import importlib.util
import os
import pathlib
import plistlib
import re
import stat
import subprocess
import sys
import tomllib

# Known-bad control: an app plist that registers a URL scheme.
CONTROL = ('<?xml version="1.0" encoding="UTF-8"?>\n<plist version="1.0"><dict>'
           '<key>CFBundleIdentifier</key><string>dev.shellborne.control</string>'
           '<key>CFBundleURLTypes</key><array><dict><key>CFBundleURLSchemes</key>'
           '<array><string>shellborne</string></array></dict></array></dict></plist>\n')

HERE = pathlib.Path(__file__).resolve().parent
READER = HERE / "repo-rules"
TABLE_NAME = "bundle-check.toml"
GATE = "bundle-check"
MAX_TABLE_BYTES = 256 * 1024
MAX_PLIST_BYTES = 2 * 1024 * 1024
MAX_WALKED = 200000
MAX_ALLOW = 200
REF = re.compile(r"[A-Za-z0-9._/@^~{}-]+")
IDENTIFIER = re.compile(r"[A-Za-z0-9](?:[A-Za-z0-9.-]*[A-Za-z0-9])?")
KINDS = ("document", "exported")


def reader():
    """The repo-rules module, loaded from the file beside this one without writing bytecode next to it."""
    sys.dont_write_bytecode = True
    loader = importlib.machinery.SourceFileLoader("repo_rules", str(READER))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


def table_bytes(rr, repo, ref):
    """The table's bytes, from beside this file or, with a ref, from that commit."""
    if ref is None:
        try:
            with open(HERE / TABLE_NAME, "rb") as handle:
                raw = handle.read(MAX_TABLE_BYTES + 1)
        except OSError as error:
            raise rr.Broken(f"cannot read {TABLE_NAME}: {error.strerror}")
    else:
        if not REF.fullmatch(ref) or ref.startswith("-"):
            raise rr.Broken(f"--tables-from needs a plain commit name, not {rr.shown(ref)}")
        try:
            done = subprocess.run(["git", "-C", str(repo), "cat-file", "blob", f"{ref}:tools/gates/{TABLE_NAME}"],
                                  capture_output=True, stdin=subprocess.DEVNULL, timeout=60)
        except (OSError, subprocess.TimeoutExpired):
            raise rr.Broken(f"git could not read {TABLE_NAME} from {rr.shown(ref)}")
        if done.returncode != 0:
            raise rr.Broken(f"{rr.shown(ref)} has no readable tools/gates/{TABLE_NAME}")
        raw = done.stdout
    if len(raw) > MAX_TABLE_BYTES:
        raise rr.Broken(f"{TABLE_NAME} is over the {MAX_TABLE_BYTES}-byte cap")
    return raw


def real_reason(rr, text):
    """Some words, none of them a placeholder, by the test repo-rules applies to its reason markers."""
    words = re.findall(r"[A-Za-z]{2,}", text) if isinstance(text, str) else []
    return bool(words) and not any(word.lower() in rr.PLACEHOLDERS for word in words)


def load_table(rr, raw):
    """The allowlist as {kind: set of identifiers}; every entry exact, with a kind and a real reason."""
    try:
        data = tomllib.loads(raw.decode("utf-8"))
    except (UnicodeDecodeError, tomllib.TOMLDecodeError) as error:
        raise rr.Broken(f"{TABLE_NAME} is malformed: {type(error).__name__}")
    if set(data) - {"allow"}:
        raise rr.Broken(f"{TABLE_NAME} holds a key other than [[allow]]")
    entries = data.get("allow", [])
    if not isinstance(entries, list) or len(entries) > MAX_ALLOW:
        raise rr.Broken(f"{TABLE_NAME}: allow must be a list of at most {MAX_ALLOW} [[allow]] entries")
    allowed = {kind: set() for kind in KINDS}
    for entry in entries:
        if (not isinstance(entry, dict) or set(entry) != {"kind", "identifier", "reason"}
                or entry["kind"] not in KINDS or not isinstance(entry["identifier"], str)
                or not IDENTIFIER.fullmatch(entry["identifier"]) or not real_reason(rr, entry["reason"])):
            raise rr.Broken(f"{TABLE_NAME}: an [[allow]] entry needs exactly a kind (document or exported), one exact "
                            "identifier with no wildcard, and a real reason")
        allowed[entry["kind"]].add(entry["identifier"])
    return allowed


def judge(data, allowed):
    """The rules one parsed Info.plist breaks."""
    rules = []
    if not isinstance(data, dict):
        return ["url-scheme", "document-type", "exported-type"]  # a plist that is not a dictionary is never clean
    if "CFBundleURLTypes" in data:
        rules.append("url-scheme")
    if "CFBundleDocumentTypes" in data:
        entries = data["CFBundleDocumentTypes"]
        for entry in entries if isinstance(entries, list) else [None]:
            types = entry.get("LSItemContentTypes") if isinstance(entry, dict) else None
            if (not isinstance(types, list) or not types
                    or not all(isinstance(t, str) and t in allowed["document"] for t in types)):
                rules.append("document-type")
                break
    if "UTExportedTypeDeclarations" in data:
        entries = data["UTExportedTypeDeclarations"]
        for entry in entries if isinstance(entries, list) else [None]:
            identifier = entry.get("UTTypeIdentifier") if isinstance(entry, dict) else None
            if not isinstance(identifier, str) or identifier not in allowed["exported"]:
                rules.append("exported-type")
                break
    return rules


def parse(rr, raw, where):
    try:
        return plistlib.loads(raw)
    except Exception as error:  # plistlib raises several kinds; any of them is a plist the gate cannot read
        raise rr.Broken(f"{rr.shown(where)} does not parse as a property list ({type(error).__name__})")


def read_plist(rr, path, where):
    """One Info.plist's bytes: a regular file only, opened without following a link, under the byte cap."""
    try:
        info = os.lstat(path)
        if not stat.S_ISREG(info.st_mode):
            raise rr.Broken(f"{rr.shown(where)} is not a regular file (a symlink or special file is never followed)")
        if info.st_size > MAX_PLIST_BYTES:
            raise rr.Broken(f"{rr.shown(where)} is over the {MAX_PLIST_BYTES}-byte cap for a plist")
        handle = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
        try:
            if not stat.S_ISREG(os.fstat(handle).st_mode):
                raise rr.Broken(f"{rr.shown(where)} is not a regular file")
            chunks, size = [], 0
            while size <= MAX_PLIST_BYTES:
                chunk = os.read(handle, MAX_PLIST_BYTES + 1 - size)
                if not chunk:
                    break
                chunks.append(chunk)
                size += len(chunk)
        finally:
            os.close(handle)
    except OSError as error:
        raise rr.Broken(f"cannot read {rr.shown(where)}: {error.strerror}")
    if size > MAX_PLIST_BYTES:
        raise rr.Broken(f"{rr.shown(where)} is over the {MAX_PLIST_BYTES}-byte cap for a plist")
    return b"".join(chunks)


def plists(rr, built):
    """Every entry named Info.plist under the folder, as (path, shown name), walked without following a link."""
    try:
        if not stat.S_ISDIR(os.lstat(built).st_mode):
            raise rr.Broken(f"{rr.shown(str(built))} is not a folder")
    except OSError as error:
        raise rr.Broken(f"cannot read the built folder {rr.shown(str(built))}: {error.strerror}")
    found, walked = [], 0

    def failed(error):
        raise rr.Broken(f"cannot read a folder under the built folder: {error.strerror}")

    for folder, dirs, files in os.walk(built, onerror=failed, followlinks=False):
        dirs.sort()
        walked += len(dirs) + len(files)
        if walked > MAX_WALKED:
            raise rr.Broken(f"the built folder holds over the cap of {MAX_WALKED} entries")
        for name in sorted(files + [d for d in dirs if d == "Info.plist"]):
            if name == "Info.plist":
                path = pathlib.Path(folder) / name
                found.append((path, path.relative_to(built).as_posix()))
    return found


def prove_controls(rr, allowed):
    """The seeded plist with a scheme must be refused, or the gate cannot fail and is broken."""
    if not isinstance(CONTROL, str):
        raise rr.Broken("the seeded control is not a plist, so this gate cannot fail")
    if "url-scheme" not in judge(parse(rr, CONTROL.encode("utf-8"), "the seeded control"), allowed):
        raise rr.Broken("the seeded url-scheme control was not refused, so this gate cannot fail")
    print(f"{GATE}: control url-scheme refused as expected")


def arguments(rr, argv):
    built, ref, repo, args = None, None, None, list(argv)
    while args:
        arg = args.pop(0)
        if arg in ("--tables-from", "--repo"):
            if not args or (arg == "--tables-from" and ref is not None) or (arg == "--repo" and repo is not None):
                raise rr.Broken(f"{arg} is given once, with a value")
            value = args.pop(0)
            ref, repo = (value, repo) if arg == "--tables-from" else (ref, value)
        elif arg.startswith("-") or built is not None:
            raise rr.Broken(f"usage: {GATE} <built-folder> [--tables-from <ref> --repo <repo>]")
        else:
            built = arg
    if built is None or (ref is None) != (repo is None):
        raise rr.Broken(f"usage: {GATE} <built-folder> [--tables-from <ref> --repo <repo>]")
    return pathlib.Path(built), ref, repo


def main(argv):
    try:
        rr = reader()
    except Exception as error:  # a reader that cannot load is a broken check, never a pass
        print(f"{GATE}: broken: cannot load the repo-rules reader: {type(error).__name__}", file=sys.stderr)
        return 2
    try:
        built, ref, repo = arguments(rr, argv)
        allowed = load_table(rr, table_bytes(rr, repo, ref))
        prove_controls(rr, allowed)
        found = rr.Collected()
        listed = plists(rr, built)
        for path, where in listed:
            for rule in judge(parse(rr, read_plist(rr, path, where), where), allowed):
                found.add(f"{rule}: {rr.shown(where)}")
    except rr.Broken as error:
        print(f"{GATE}: broken: {error}", file=sys.stderr)
        return 2
    if not listed:
        print(f"{GATE}: not run: no Info.plist under the built folder, so nothing was judged", file=sys.stderr)
        return 2
    for where in found.kept:
        print(f"{GATE}: refused {where}")
    if found.total > len(found.kept):
        print(f"{GATE}: refused: {found.total - len(found.kept)} more refusals not listed")
    return 1 if found.total else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
