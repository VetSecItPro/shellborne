#!/usr/bin/env python3
"""Source gate: each rule that reading the source can decide fails the build (plan steps P0.9.1 and P0.9.2).

Usage: repo-rules <repo>        check the tracked source of <repo>
       repo-rules --list        list each rule with the build rule it enforces

Reads repo-rules.toml beside this file. A rule names the patterns it matches, the file suffixes it reads, the
path prefixes where a match is allowed, the build rule it enforces and a known-bad control line; every run first
checks that each rule's patterns match its own control, so a rule that cannot fail stops the check. A rule with a
reason marker allows a match whose line, or the line above it, carries that marker followed by a reason.

Only tracked files are read (git ls-files), as text, at most 20000 of them and 2 MiB each; the gate never imports,
builds or runs repository code and never uses the network. A refusal names the rule and file:line, never the
source. An unreadable or non-UTF-8 file, a file over the cap, a malformed table or a failed git is broken.
Exit 0 clean, 1 refused, 2 broken.
"""
import pathlib
import re
import subprocess
import sys
import tomllib

TABLE = pathlib.Path(__file__).resolve().parent / "repo-rules.toml"
FIELDS = {"id", "enforces", "suffixes", "patterns", "allowed", "control"}
MAX_FILES = 20000
MAX_BYTES = 2 * 1024 * 1024


class Broken(Exception):
    pass


def load_rules(path=TABLE):
    try:
        data = tomllib.loads(path.read_text(encoding="utf-8"))
    except (OSError, UnicodeDecodeError, tomllib.TOMLDecodeError) as error:
        raise Broken(f"cannot read {path.name}: {error}")
    rules = data.get("rule")
    if not isinstance(rules, list) or not rules:
        raise Broken(f"{path.name} has no rules")
    out = []
    for rule in rules:
        if not isinstance(rule, dict) or not FIELDS <= set(rule) or set(rule) - FIELDS - {"reason"}:
            raise Broken(f"{path.name}: a rule lacks or adds fields: {rule.get('id') if isinstance(rule, dict) else rule}")
        try:
            compiled = [re.compile(p) for p in rule["patterns"]]
        except (re.error, TypeError) as error:
            raise Broken(f"{path.name}: rule {rule['id']} has a bad pattern: {error}")
        if not compiled or not any(p.search(rule["control"]) for p in compiled):
            raise Broken(f"{path.name}: rule {rule['id']}: its patterns do not match its own control, so it cannot fail")
        out.append(dict(rule, compiled=compiled))
    return out


def tracked(repo):
    listed = subprocess.run(["git", "-C", str(repo), "ls-files", "-z"], capture_output=True, timeout=120)
    if listed.returncode != 0:
        raise Broken(f"git cannot list the tree at {repo}")
    names = [n.decode("utf-8", "surrogateescape") for n in listed.stdout.split(b"\0") if n]
    if len(names) > MAX_FILES:
        raise Broken(f"the tree lists {len(names)} files, over the cap of {MAX_FILES}")
    return names


def reason_given(lines, index, marker):
    for line in lines[max(0, index - 1):index + 1]:
        at = line.find(marker)
        if at >= 0 and line[at + len(marker):].strip():
            return True
    return False


def findings(repo, rules):
    found = []
    suffixes = tuple({s for rule in rules for s in rule["suffixes"]})
    for name in tracked(repo):
        if not name.endswith(suffixes):
            continue
        path = pathlib.Path(repo) / name
        try:
            if path.stat().st_size > MAX_BYTES:
                raise Broken(f"{name} is over the {MAX_BYTES}-byte cap for a source file")
            lines = path.read_bytes().decode("utf-8").splitlines()
        except UnicodeDecodeError:
            raise Broken(f"{name} is not UTF-8")
        except OSError as error:
            raise Broken(f"cannot read {name}: {error}")
        for rule in rules:
            if not name.endswith(tuple(rule["suffixes"])) or name.startswith(tuple(rule["allowed"])):
                continue
            for index, line in enumerate(lines):
                if any(p.search(line) for p in rule["compiled"]):
                    if "reason" in rule and reason_given(lines, index, rule["reason"]):
                        continue
                    found.append((rule["id"], f"{name}:{index + 1}"))
    return found


def main(argv):
    try:
        rules = load_rules()
        if argv[1:] == ["--list"]:
            for rule in rules:
                print(f"{rule['id']}  {rule['enforces']}")
            return 0
        if len(argv) != 2:
            raise Broken("usage: repo-rules <repo> | repo-rules --list")
        found = findings(argv[1], rules)
    except Broken as error:
        print(f"repo-rules: broken: {error}", file=sys.stderr)
        return 2
    for rule, where in found:
        print(f"repo-rules: refused {rule}: {where}")
    return 1 if found else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
