#!/usr/bin/env python3
"""Source gate: each rule that reading the source can decide fails the build (plan steps P0.9.1 and P0.9.2).

Usage: repo-rules <repo>        check the tracked source of <repo>
       repo-rules --list        list each rule, and the language rule, with the build rule each enforces

Reads repo-rules.toml beside this file. A rule names the patterns it matches line by line, optional spanning
patterns matched across lines of the whole file, the file suffixes it reads, the paths where a match is allowed (a
folder ends in /, anything else is one exact file), the build rule it enforces and known-bad controls; every run
first checks that each rule's patterns match its own controls, so a rule that cannot fail stops the check. A rule
with a reason marker allows a match whose line, or the line above it, carries that marker inside a // or /*
comment followed by a real reason, never a placeholder.

Suffixes are compared without case. The [languages] table names native languages the rules cannot read; a tracked
file in one is refused as source-language-unread outside the paths that table allows, so no rule is passed by
changing language.

Only tracked regular files are read (git ls-files), as text, at most 20000 of them and 2 MiB each, opened without
following a symlink; a tracked symlink or special file is broken, never followed. The gate never imports, builds or
runs repository code and never uses the network. A refusal names the rule and file:line, never the source, with
control and non-ASCII characters in the name escaped, and at most 1000 refusals are listed. An unreadable or
non-UTF-8 file, a file over the cap, a malformed table or a failed git is broken. Exit 0 clean, 1 refused, 2 broken.
"""
import os
import pathlib
import re
import stat
import subprocess
import sys
import tomllib

TABLE = pathlib.Path(__file__).resolve().parent / "repo-rules.toml"
FIELDS = {"id", "enforces", "suffixes", "patterns", "allowed", "control"}
OPTIONAL = {"reason", "spanning", "spanning_control"}
SUFFIX = re.compile(r"\.[A-Za-z0-9]+")
PREFIX = re.compile(r"(?:[A-Za-z0-9._-]+/)*[A-Za-z0-9._-]+/?")
MAX_FILES = 20000
MAX_BYTES = 2 * 1024 * 1024
MAX_FINDINGS = 1000
PLACEHOLDERS = {"placeholder", "todo", "tbd", "fixme", "xxx", "wip", "na"}  # a reason may not start with one


class Broken(Exception):
    pass


LANGUAGE_RULE = "source-language-unread"


def load_table(path=TABLE):
    try:
        data = tomllib.loads(path.read_text(encoding="utf-8"))
    except (OSError, UnicodeDecodeError, tomllib.TOMLDecodeError) as error:
        raise Broken(f"cannot read {path.name}: {error}")
    rules = load_rules(path, data)
    return rules, load_languages(path, data, rules)


def load_languages(path, data, rules):
    """The [languages] table: native suffixes the rules cannot read, each refused outside its allowed paths."""
    languages = data.get("languages")
    if not isinstance(languages, dict) or set(languages) != {"enforces", "unread", "allowed"}:
        raise Broken(f"{path.name}: the [languages] table lacks or adds fields")
    unread, allowed = languages["unread"], languages["allowed"]
    ok = (isinstance(languages["enforces"], str) and languages["enforces"].strip()
          and isinstance(unread, list) and unread and all(isinstance(v, str) and SUFFIX.fullmatch(v) for v in unread)
          and isinstance(allowed, list) and all(isinstance(v, str) and PREFIX.fullmatch(v) for v in allowed)
          and not any(".." in v.split("/") for v in allowed))
    if not ok:
        raise Broken(f"{path.name}: the [languages] table is malformed")
    lowered = [v.lower() for v in unread]
    read = {s.lower() for rule in rules for s in rule["suffixes"]}
    if len(set(lowered)) != len(lowered) or read & set(lowered):
        raise Broken(f"{path.name}: a [languages] suffix repeats or is one a rule already reads")
    return {"enforces": languages["enforces"], "unread": tuple(lowered), "allowed": allowed}


def load_rules(path, data):
    rules = data.get("rule")
    if not isinstance(rules, list) or not rules:
        raise Broken(f"{path.name} has no rules")
    out, seen = [], set()
    for rule in rules:
        if not isinstance(rule, dict) or not FIELDS <= set(rule) or set(rule) - FIELDS - OPTIONAL:
            raise Broken(f"{path.name}: a rule lacks or adds fields: {rule.get('id') if isinstance(rule, dict) else rule}")
        typed(path, rule)
        if rule["id"] in seen:
            raise Broken(f"{path.name}: rule id {rule['id']} appears twice")
        seen.add(rule["id"])
        try:
            compiled = [re.compile(p) for p in rule["patterns"]]
            spanning = [re.compile(p, re.MULTILINE) for p in rule.get("spanning", [])]
        except (re.error, TypeError) as error:
            raise Broken(f"{path.name}: rule {rule['id']} has a bad pattern: {error}")
        if not compiled or not any(p.search(rule["control"]) for p in compiled):
            raise Broken(f"{path.name}: rule {rule['id']}: its patterns do not match its own control, so it cannot fail")
        if spanning and not all(p.search(rule["spanning_control"]) for p in spanning):
            raise Broken(f"{path.name}: rule {rule['id']}: a spanning pattern does not match its own control, so it cannot fail")
        out.append(dict(rule, compiled=compiled, spanning_compiled=spanning,
                        suffixes=[s.lower() for s in rule["suffixes"]]))
    return out


def typed(path, rule):
    """Every field has its exact type and form, so a malformed table is broken, never read loosely."""
    def strings(value, pattern=None, empty=False):
        return (isinstance(value, list) and (empty or value) and all(isinstance(v, str) and v for v in value)
                and all(pattern.fullmatch(v) for v in value) if pattern else isinstance(value, list) and (empty or value)
                and all(isinstance(v, str) and v for v in value))
    problems = [name for name, ok in (
        ("id", isinstance(rule["id"], str) and re.fullmatch(r"[a-z0-9]+(?:-[a-z0-9]+)*", rule["id"])),
        ("enforces", isinstance(rule["enforces"], str) and rule["enforces"].strip()),
        ("control", isinstance(rule["control"], str) and rule["control"].strip()),
        ("suffixes", strings(rule["suffixes"], SUFFIX)),
        ("patterns", strings(rule["patterns"])),
        ("allowed", strings(rule["allowed"], PREFIX, empty=True) and not any(".." in v.split("/") for v in rule["allowed"])),
        ("reason", "reason" not in rule or (isinstance(rule["reason"], str) and rule["reason"].strip())),
        ("spanning", "spanning" not in rule or (strings(rule["spanning"]) and "reason" not in rule
                                                and isinstance(rule.get("spanning_control"), str)
                                                and "\n" in rule["spanning_control"])),
        ("spanning_control", "spanning_control" not in rule or "spanning" in rule),
    ) if not ok]
    if problems:
        raise Broken(f"{path.name}: rule {rule.get('id')!r} has a malformed {', '.join(problems)}")


def tracked(repo):
    try:
        listed = subprocess.run(["git", "-C", str(repo), "ls-files", "-z"], capture_output=True, timeout=120)
    except (OSError, subprocess.TimeoutExpired) as error:
        raise Broken(f"git could not list the tree: {error}")
    if listed.returncode != 0:
        raise Broken(f"git cannot list the tree at {repo}")
    names = [n.decode("utf-8", "surrogateescape") for n in listed.stdout.split(b"\0") if n]
    if len(names) > MAX_FILES:
        raise Broken(f"the tree lists {len(names)} files, over the cap of {MAX_FILES}")
    return names


def comment_start(line):
    """Where a // or /* comment starts on the line, outside any double-quoted string, or -1. A quote the scan
    cannot pair hides the rest of the line, so a doubtful marker never exempts (fail closed)."""
    quote, index = None, 0
    while index < len(line):
        char = line[index]
        if quote:
            if char == "\\":
                index += 1
            elif char == quote:
                quote = None
        elif char == '"':
            quote = char
        elif line.startswith(("//", "/*"), index):
            return index
        index += 1
    return -1


def reason_given(lines, index, marker):
    """The marker sits in a comment on the matched line or the line above, followed by a real reason."""
    for line in lines[max(0, index - 1):index + 1]:
        start = comment_start(line)
        at = line.find(marker, start) if start >= 0 else -1
        if at < 0:
            continue
        reason = line[at + len(marker):]
        if line.startswith("/*", start):
            reason = reason.split("*/", 1)[0]  # a block comment's reason ends where the comment does
        words = re.findall(r"[A-Za-z]{2,}", reason)
        if words and words[0].lower() not in PLACEHOLDERS:
            return True
    return False


def allowed_at(name, allowed):
    """A folder entry (ending in /) allows everything under it; any other entry allows that one file only."""
    return any(name.startswith(entry) if entry.endswith("/") else name == entry for entry in allowed)


def read_source(repo, name):
    """One tracked source as text: a regular file only, opened without following a symlink, at most MAX_BYTES."""
    path = pathlib.Path(repo) / name
    try:
        info = os.lstat(path)
        if not stat.S_ISREG(info.st_mode):
            raise Broken(f"{shown(name)} is not a regular file (a symlink or special file is never read)")
        if info.st_size > MAX_BYTES:
            raise Broken(f"{shown(name)} is over the {MAX_BYTES}-byte cap for a source file")
        handle = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
        try:
            if not stat.S_ISREG(os.fstat(handle).st_mode):
                raise Broken(f"{shown(name)} is not a regular file (a symlink or special file is never read)")
            chunks, size = [], 0
            while size <= MAX_BYTES:  # os.read may return fewer bytes than asked; read to the end or past the cap
                chunk = os.read(handle, MAX_BYTES + 1 - size)
                if not chunk:
                    break
                chunks.append(chunk)
                size += len(chunk)
            data = b"".join(chunks)
        finally:
            os.close(handle)
    except OSError as error:
        raise Broken(f"cannot read {shown(name)}: {error.strerror}")
    if len(data) > MAX_BYTES:
        raise Broken(f"{shown(name)} is over the {MAX_BYTES}-byte cap for a source file")
    try:
        return data.decode("utf-8")
    except UnicodeDecodeError:
        raise Broken(f"{shown(name)} is not UTF-8")


def shown(name):
    """A file name safe to print: control, backslash and non-ASCII characters escaped, so a name cannot forge a line."""
    return "".join(c if " " <= c <= "~" and c != "\\" else c.encode("unicode_escape", "backslashreplace").decode("ascii")
                   for c in name)


def findings(repo, rules, languages):
    found = []
    suffixes = tuple({s for rule in rules for s in rule["suffixes"]})
    for name in tracked(repo):
        lowered = name.lower()
        if lowered.endswith(languages["unread"]) and not allowed_at(name, languages["allowed"]):
            found.append((LANGUAGE_RULE, f"{shown(name)}:1"))
            continue
        if not lowered.endswith(suffixes):
            continue
        text = read_source(repo, name)
        lines = text.splitlines()
        for rule in rules:
            if not lowered.endswith(tuple(rule["suffixes"])) or allowed_at(name, rule["allowed"]):
                continue
            hits = set()
            for index, line in enumerate(lines):
                if any(p.search(line) for p in rule["compiled"]):
                    if "reason" in rule and reason_given(lines, index, rule["reason"]):
                        continue
                    hits.add(index + 1)
            for pattern in rule["spanning_compiled"]:
                hits.update(text.count("\n", 0, m.start()) + 1 for m in pattern.finditer(text))
            found += [(rule["id"], f"{shown(name)}:{line}") for line in sorted(hits)]
    return found


def main(argv):
    try:
        rules, languages = load_table()
        if argv[1:] == ["--list"]:
            for rule in rules:
                print(f"{rule['id']}  {rule['enforces']}")
            print(f"{LANGUAGE_RULE}  {languages['enforces']}")
            return 0
        if len(argv) != 2:
            raise Broken("usage: repo-rules <repo> | repo-rules --list")
        found = findings(argv[1], rules, languages)
    except Broken as error:
        print(f"repo-rules: broken: {error}", file=sys.stderr)
        return 2
    for rule, where in found[:MAX_FINDINGS]:
        print(f"repo-rules: refused {rule}: {where}")
    if len(found) > MAX_FINDINGS:
        print(f"repo-rules: refused: {len(found) - MAX_FINDINGS} more refusals not listed")
    return 1 if found else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
