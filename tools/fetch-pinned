#!/usr/bin/env python3
"""Fetch one file over https and place it only when its SHA-256 matches (plan step P0.11.5).

Usage: fetch-pinned <https-url> <sha256> <destination>

This is the one way a build brings a file in from the network; the pin gate refuses every other fetch in a file a
build runs. The file streams into a new temporary file beside the destination, hashed in this program as it is
written and capped in size, and is renamed onto the destination only when the digest matches. On any failure the
temporary file is removed and the destination is left as it was, so the destination name never holds an unverified
file and no later command can use one, whatever order a script runs in. A file already at the destination is
kept only when it already matches, with no fetch; any other file there is removed before the fetch. One deadline
(15 minutes) covers the whole request, connection, redirects and body.

Rules: the URL is https with a host and no user name or password, and a redirect is followed only to https; the
digest is 64 hex digits; the destination is inside the folder the helper runs in, its folder exists and resolves
inside that folder through real folders only (no link anywhere in the path, checked folder by folder and held
open through the write), and it is absent or a regular file (not a link, folder or special file). Exit 0 placed, 1 refused (fetch failed, too large, or digest
mismatch), 2 malformed arguments. Nothing is written for exit 1 or 2.
"""
import hashlib
import http.client
import os
import re
import secrets
import signal
import stat
import sys
import threading
import urllib.error
import urllib.parse
import urllib.request

MAX_BYTES = 512 * 1024 * 1024
TIMEOUT_SECONDS = 120
DEADLINE_SECONDS = 900
CHUNK = 1024 * 1024
HEX64 = re.compile(r"[0-9A-Fa-f]{64}")


class Refused(Exception):
    """The file was not placed."""


class Malformed(Refused):
    """The arguments are wrong; nothing was fetched."""


class TooLarge(Refused):
    """The bytes passed the cap."""


class HttpsOnlyRedirect(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, req, fp, code, msg, headers, newurl):
        try:
            check_url(newurl)  # the same rule as the first URL: https, a host, no user name or password
        except Malformed as error:
            raise Refused(f"a redirect target is not allowed: {error}") from None
        return super().redirect_request(req, fp, code, msg, headers, newurl)


def https_only_opener():
    return urllib.request.build_opener(HttpsOnlyRedirect)


def check_url(url):
    parts = urllib.parse.urlsplit(url)
    if parts.scheme.lower() != "https" or not parts.hostname:
        raise Malformed("the URL must be https with a host")
    if parts.username is not None or parts.password is not None:
        raise Malformed("the URL must not carry a user name or password")


FOLDER = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW


def open_destination(dest, root):
    """(folder handle, file name) for dest. The folder is reached from root one part at a time with links refused,
    and every later step works through that handle, so no link or swapped folder can move the file outside root
    between the check and the write. The destination itself must be absent or a regular file."""
    root = os.path.realpath(root)
    if not dest:
        raise Malformed("the destination must name a file")
    path = os.path.normpath(dest if os.path.isabs(dest) else os.path.join(root, dest))
    if not path.startswith(root + os.sep):
        raise Malformed("the destination is outside the folder the helper runs in")
    parts = path[len(root) + 1:].split(os.sep)
    if any(part in ("", ".", "..") for part in parts):
        raise Malformed("the destination must be a plain path to a file")
    try:
        folder = os.open(root, os.O_RDONLY | os.O_DIRECTORY)
    except OSError as error:
        raise Malformed(f"the folder the helper runs in cannot be opened: {error.strerror}") from None
    try:
        for part in parts[:-1]:
            try:
                inner = os.open(part, FOLDER, dir_fd=folder)
            except OSError:
                raise Malformed("every folder in the destination path must exist and be a real folder, not a link")
            os.close(folder)
            folder = inner
        try:
            info = os.stat(parts[-1], dir_fd=folder, follow_symlinks=False)
        except FileNotFoundError:
            return folder, parts[-1]
        if not stat.S_ISREG(info.st_mode):
            raise Malformed("the destination must be absent or a regular file, not a link, folder or special file")
        return folder, parts[-1]
    except BaseException:
        os.close(folder)
        raise


def expired(signum, frame):
    raise Refused("the fetch passed its deadline")


def fetch_pinned(url, digest, dest, open_url=None, root=None, max_bytes=MAX_BYTES, deadline_seconds=DEADLINE_SECONDS):
    """Place url's body at dest only when its SHA-256 is digest; raise Refused otherwise. A file already at dest
    is kept only when a copy of it, hashed as that copy, matches, with no fetch; any other file there is removed
    first, so whatever is at dest when this returns or raises has been verified. One deadline covers everything after the arguments are
    checked: reading a file already there, the connection, redirects and the body."""
    check_url(url)
    if not HEX64.fullmatch(digest or ""):
        raise Malformed("the digest must be 64 hex digits")
    if threading.current_thread() is not threading.main_thread():
        raise Malformed("the helper runs its deadline on the main thread only")
    folder, name = open_destination(dest, root if root is not None else os.getcwd())
    previous = signal.signal(signal.SIGALRM, expired)
    signal.setitimer(signal.ITIMER_REAL, deadline_seconds)
    try:
        place(url, digest.lower(), folder, name, open_url, max_bytes)
    finally:
        signal.setitimer(signal.ITIMER_REAL, 0)
        signal.signal(signal.SIGALRM, previous)
        os.close(folder)
    return dest


def remove(folder, name):
    try:
        os.unlink(name, dir_fd=folder)
    except FileNotFoundError:
        pass


def to_temporary(folder, name, read, max_bytes, pending):
    """Write what read() yields into a new temporary file beside the destination, hashing as it goes, under the
    cap; return (temporary name, SHA-256). The name joins pending before the file exists, so the caller's one
    cleanup removes it on any failure, however late."""
    temporary = f".{name}.{secrets.token_hex(8)}.part"
    pending.append(temporary)
    handle = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600, dir_fd=folder)
    hasher, size = hashlib.sha256(), 0
    with os.fdopen(handle, "wb") as out:
        while chunk := read(CHUNK):
            size += len(chunk)
            if size > max_bytes:
                raise TooLarge(f"the bytes pass the cap of {max_bytes}")
            hasher.update(chunk)
            out.write(chunk)
        out.flush()
        os.fsync(out.fileno())
        os.fchmod(out.fileno(), 0o644)
    return temporary, hasher.hexdigest()


def settle(folder, temporary, found, digest, name):
    """Rename the temporary file onto the destination only when its digest matches."""
    if found != digest:
        return False
    os.rename(temporary, name, src_dir_fd=folder, dst_dir_fd=folder)
    return True


def changed(folder, name):
    """The destination stopped being a regular file during the run: a link or special file there is removed
    through the held folder, so nothing unverified stays at the name; a folder is left, since it holds no
    fetched bytes and removing a tree is not this helper's to do."""
    try:
        info = os.stat(name, dir_fd=folder, follow_symlinks=False)
    except FileNotFoundError:
        return Refused("the destination changed during the run")
    if not stat.S_ISDIR(info.st_mode):
        remove(folder, name)
    return Refused("the destination changed during the run into something other than a regular file")


def place(url, digest, folder, name, open_url, max_bytes):
    """Everything here works through the folder handle, never through the path again. A file already at the
    destination is copied through a temporary file and hashed as that copy, so success never rests on an inode
    read from the name; the deadline stays armed until this returns; one cleanup owns every temporary file."""
    pending = []
    try:
        try:
            info = os.stat(name, dir_fd=folder, follow_symlinks=False)
        except FileNotFoundError:
            info = None
        if info is not None:
            if not stat.S_ISREG(info.st_mode):
                raise changed(folder, name)
            try:
                handle = os.open(name, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK, dir_fd=folder)
            except OSError:
                raise changed(folder, name) from None
            try:
                if not stat.S_ISREG(os.fstat(handle).st_mode):
                    raise changed(folder, name)
                try:
                    temporary, found = to_temporary(folder, name, lambda size: os.read(handle, size), max_bytes,
                                                    pending)
                except TooLarge:
                    temporary = None  # over the cap, so it is not the pinned file
            finally:
                os.close(handle)
            if temporary is not None and settle(folder, temporary, found, digest, name):
                return
            remove(folder, name)  # an unverified file never stays at the destination
        if open_url is None:
            opener = https_only_opener()

            def open_url(address):
                return opener.open(address, timeout=TIMEOUT_SECONDS)
        try:
            with open_url(url) as body:
                temporary, found = to_temporary(folder, name, body.read, max_bytes, pending)
        except (OSError, http.client.HTTPException, urllib.error.URLError, ValueError) as error:
            raise Refused(f"the fetch failed: {error}") from None
        if not settle(folder, temporary, found, digest, name):
            raise Refused(f"digest mismatch: expected {digest}, got {found}")
    finally:
        for temporary in pending:  # a renamed file is gone from this name, so only leftovers are removed
            remove(folder, temporary)


def main(argv):
    if len(argv) != 4:
        print("fetch-pinned: usage: fetch-pinned <https-url> <sha256> <destination>", file=sys.stderr)
        return 2
    try:
        fetch_pinned(argv[1], argv[2], argv[3])
    except Malformed as error:
        print(f"fetch-pinned: malformed: {error}", file=sys.stderr)
        return 2
    except Refused as error:
        print(f"fetch-pinned: refused: {error}", file=sys.stderr)
        return 1
    except OSError as error:  # any operating-system failure is a refusal; nothing unverified is left in place
        print(f"fetch-pinned: refused: {error.strerror or error}", file=sys.stderr)
        return 1
    print(f"fetch-pinned: placed {argv[3]}")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
