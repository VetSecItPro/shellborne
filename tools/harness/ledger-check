#!/usr/bin/env python3
"""ledger-check: every results row is one the recorder wrote and its evidence still matches (plan step P0.15.6).

Usage: ledger-check --ledger <ledger.jsonl> [--repo <repo>]

Each row is judged by results-common's row_problems, the same rule record-result applies before it writes: exactly
the fields tools/harness/results-schema.json requires (the concurrent-load field included), no more; machine, build,
test, concurrent_load, log_path, recorded_at and recorder each a non-blank string of at most 512 characters with no
control character; the recorder name the schema names; a result the schema allows; a refresh rate that is a finite
positive number; a commit that /usr/bin/git finds in --repo; a recorded_at of the form YYYY-MM-DD HH:MM CT; and a
log_path that is exactly logs/<log_sha256>.log, the recorder's own copy inside the ledger's folder, naming a regular
file (never through a link) whose SHA-256 equals the row's log_sha256. Refuses (exit 1) naming each row by its line
and reason; exit 0 every row holds, 2 broken (a ledger that is missing, not a regular file, reached through a link,
past its size cap, not UTF-8, not JSON on a line or holding a repeated key, or a schema that cannot load).
"""
import argparse
import importlib.machinery
import importlib.util
import os
import pathlib
import sys


def common():
    path = pathlib.Path(__file__).resolve().parent / "results-common"
    loader = importlib.machinery.SourceFileLoader("results_common", str(path))
    module = importlib.util.module_from_spec(importlib.util.spec_from_loader(loader.name, loader))
    loader.exec_module(module)
    return module


def main(argv):
    try:
        rc = common()
        schema = rc.load_schema()
    except Exception as error:  # a helper or schema that cannot load is broken, never a refusal or a traceback
        print(f"ledger-check: broken: {error}", file=sys.stderr)
        return 2
    parser = argparse.ArgumentParser(prog="ledger-check")
    parser.add_argument("--ledger", required=True)
    parser.add_argument("--repo", default=".")
    args = parser.parse_args(argv)
    ledger = pathlib.Path(os.path.abspath(args.ledger))
    folder = ledger.parent.resolve()
    try:
        rows = rc.ledger_rows(rc.read_bytes(folder / ledger.name, rc.MAX_LEDGER), ledger.name)
    except rc.Unusable as error:
        print(f"ledger-check: broken: {error}", file=sys.stderr)
        return 2
    refused = 0
    for number, row in rows:
        for problem in rc.row_problems(schema, row, folder, args.repo):
            print(f"ledger-check: refused: line {number}: {problem}")
            refused += 1
    if refused:
        return 1
    print(f"ledger-check: {len(rows)} rows hold")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
