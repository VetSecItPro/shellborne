#!/usr/bin/env python3
"""run-suite: starts a kill, soak or exhaustion suite only as the dedicated test account (plan step P0.14.2).

Usage: run-suite --kind kill|soak|exhaustion -- <command> [args...]

Destructive suites start through run-suite. It runs whoami-check --guard beside this file first, reading the guard's
answer through tools/gates/bounded-read's run_capped: at most 64 KiB of output within 60 seconds, the guard in a
session of its own whose whole group is ended past either limit. Only when the process runs as the dedicated test
account (exit 0) does it replace itself with the command; otherwise it relays whoami-check's refusal, naming the
account it runs as, and exits 1. A guard whose answer cannot be read (too much output, no answer in time, or a
guard that cannot run) or that answers anything but 0 or 1 is broken, exit 2, and the suite does not start.

Each run gets a session of its own: 16 bytes from the system's random source, written as 32 lowercase hex characters
and handed to the command as SHELLBORNE_SESSION, replacing any value run-suite inherited, so two runs never share
one. The suite passes it to record-result with --session for every row it records.

The instruments a suite runs, soak-check among them, do not check the account themselves: hosted CI runs soak-check
with no test account. The account check lives here, at the start of a destructive suite.
"""
import importlib.machinery
import importlib.util
import os
import pathlib
import secrets
import sys

KINDS = ("kill", "soak", "exhaustion")
HERE = pathlib.Path(__file__).resolve().parent
GUARD = HERE / "whoami-check"
BOUNDED_READ = HERE.parent / "gates" / "bounded-read"
GUARD_CAP = 64 * 1024
GUARD_SECONDS = 60


def bounded_reader():
    """The gates' bounded reader, loaded from tools/gates/bounded-read without writing bytecode beside it."""
    sys.dont_write_bytecode = True
    loader = importlib.machinery.SourceFileLoader("bounded_read", str(BOUNDED_READ))
    module = importlib.util.module_from_spec(importlib.util.spec_from_loader(loader.name, loader))
    loader.exec_module(module)
    return module


def main(argv):
    if len(argv) < 4 or argv[0] != "--kind" or argv[2] != "--":
        print("usage: run-suite --kind kill|soak|exhaustion -- <command> [args...]", file=sys.stderr)
        return 2
    kind, command = argv[1], argv[3:]
    if kind not in KINDS:
        print(f"run-suite: broken: unknown kind {kind!r}; destructive suites are {', '.join(KINDS)}", file=sys.stderr)
        return 2
    try:
        br = bounded_reader()
    except Exception as error:  # a reader that cannot load is broken, never a start or a traceback
        print(f"run-suite: broken: cannot load bounded-read: {error}", file=sys.stderr)
        return 2
    try:
        code, out = br.run_capped([sys.executable, "-I", str(GUARD), "--guard"], GUARD_CAP, GUARD_SECONDS)
    except br.Unreadable as error:
        print(f"run-suite: broken: the account guard's answer could not be read: {error}", file=sys.stderr)
        return 2
    said = out.decode("utf-8", "replace").strip()
    if code == 1:
        print(f"run-suite: refused: the {kind} suite starts only as the test account. {said}")
        return 1
    if code != 0:
        print(f"run-suite: broken: the account guard answered {code}: {said}", file=sys.stderr)
        return 2
    os.environ["SHELLBORNE_SESSION"] = secrets.token_hex(16)
    try:
        os.execvp(command[0], command)
    except OSError as error:
        print(f"run-suite: broken: the suite could not start: {error.strerror}", file=sys.stderr)
        return 2
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
