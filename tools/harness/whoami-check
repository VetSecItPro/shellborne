#!/usr/bin/env python3
"""whoami-check: is the dedicated macOS test account present and not an administrator?

Usage: whoami-check [--guard] [--name-file <path>] [--dscl <path>] [--dseditgroup <path>]

Destructive, soak and exhaustion suites run only under one standard macOS account, so a crash or a panic they cause
costs that account, never the person's own. This reads the account's name from tools/harness/test-user (one line:
a lowercase account name), looks the account up with `dscl . -read /Users/<name>` and its admin membership with
`dseditgroup -o checkmember -m <name> admin`, and needs no password.

Exit 0: the account exists and is not in the admin group. Exit 1: a named refusal (the account is missing, or it is
an admin). Exit 2: broken (the name file is missing, unreadable or malformed, or a lookup answered in a way this
tool does not know). The lookups' exit codes it knows: dscl 0 found, 56 not found; dseditgroup 0 member, 67 not a
member. --dscl and --dseditgroup name stand-ins for tests.

Without --guard this answers whether the account is ready, from any account, as setting it up needs. --guard, which
every destructive, soak or exhaustion suite calls before it starts, also refuses (exit 1) unless the process runs as
that account: the real and the effective uid must both be that account's, found in the user database.

An interrupt, a termination request or a hangup while a lookup runs ends that lookup's whole group, as its 30-second
limit does, and the check exits 2 naming the signal: a check that did not finish never answers 0 or 1.
"""
import argparse
import os
import pathlib
import pwd
import re
import signal
import stat
import subprocess
import sys

NAME = re.compile(r"[a-z_][a-z0-9_]{0,30}")
DEFAULT_NAMES = pathlib.Path(__file__).resolve().parent / "test-user"


def say(line):
    print(f"whoami-check: {line}", flush=True)


MAX_NAME_FILE = 64  # the longest name NAME allows is 31 characters, plus its newline


def account_name(path):
    """The one account name the file holds, read as at most MAX_NAME_FILE + 1 bytes, so a file that is longer, or a
    pipe that never ends, is refused without reading the rest."""
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NONBLOCK | os.O_NOFOLLOW)  # a pipe or a link never holds the check
        with os.fdopen(fd, "rb") as handle:
            if not stat.S_ISREG(os.fstat(handle.fileno()).st_mode):
                raise ValueError(f"the name file {path} is not a regular file")
            data = handle.read(MAX_NAME_FILE + 1)
    except OSError as error:
        raise ValueError(f"cannot read the name file {path}: {error.strerror}") from None
    if len(data) > MAX_NAME_FILE:
        raise ValueError(f"the name file {path} is longer than any account name")
    try:
        text = data.decode("utf-8")
    except UnicodeDecodeError as error:
        raise ValueError(f"cannot read the name file {path}: {error}") from None
    lines = text.split("\n")
    if len(lines) != 2 or lines[1] != "" or not NAME.fullmatch(lines[0]):
        raise ValueError(f"the name file {path} must hold one lowercase account name and a newline")
    return lines[0]


STOPS = (signal.SIGINT, signal.SIGTERM, signal.SIGHUP)


class Interrupted(Exception):
    """A stop signal arrived; the check did not finish."""


def on_stop(signum, _frame):
    raise Interrupted(signal.Signals(signum).name)


def leader_held(process):
    """True while the lookup's leader is still this process's to collect, running or exited; only then is its group
    id still its own. Asked without collecting it."""
    try:
        os.waitid(os.P_PID, process.pid, os.WEXITED | os.WNOHANG | os.WNOWAIT)
    except ChildProcessError:
        return False
    return True


def end(process):
    """Ends the lookup's whole group while its leader is held, then collects the leader, waiting at most 5 seconds."""
    if leader_held(process):
        try:
            os.killpg(process.pid, signal.SIGKILL)
        except (ProcessLookupError, PermissionError):
            try:
                process.kill()  # the group could not be signalled; the leader alone is better than nothing
            except OSError:
                pass
    try:
        process.wait(timeout=5)
    except subprocess.TimeoutExpired:
        pass  # the check is already broken; the caller says so


def run(argv):
    """The exit status of a lookup; only the status is read, so its output goes to /dev/null. The lookup runs in a
    session of its own. The stop signals are held from before it starts until the cleanup below is in place, and
    held again during that cleanup, so when it passes its 30 seconds or a stop signal arrives the whole group is
    ended, children it started included, while its leader is still uncollected; then it is collected."""
    before = signal.pthread_sigmask(signal.SIG_BLOCK, STOPS)
    try:
        process = subprocess.Popen(argv, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                                   stderr=subprocess.DEVNULL, start_new_session=True)
    except BaseException:
        signal.pthread_sigmask(signal.SIG_SETMASK, before)
        raise
    try:
        signal.pthread_sigmask(signal.SIG_SETMASK, before)
        return process.wait(timeout=30)
    except BaseException:
        signal.pthread_sigmask(signal.SIG_BLOCK, STOPS)
        try:
            end(process)
        finally:
            signal.pthread_sigmask(signal.SIG_SETMASK, before)
        raise


def main(argv):
    """Every stop signal, wherever it lands, ends as a broken run (exit 2): an escaping exception would exit 1, which
    reads as a refusal."""
    try:
        return check(argv)
    except Interrupted as stop:
        say(f"broken: interrupted by {stop} before the check finished")
        return 2


def check(argv):
    parser = argparse.ArgumentParser(prog="whoami-check")
    parser.add_argument("--guard", action="store_true")
    parser.add_argument("--name-file", default=str(DEFAULT_NAMES))
    parser.add_argument("--dscl", default="/usr/bin/dscl")
    parser.add_argument("--dseditgroup", default="/usr/sbin/dseditgroup")
    args = parser.parse_args(argv)
    signal.signal(signal.SIGCHLD, signal.SIG_DFL)  # an ignored SIGCHLD would let the kernel collect lookups early
    for signum in STOPS:
        signal.signal(signum, on_stop)
    try:
        name = account_name(pathlib.Path(args.name_file))
    except ValueError as error:
        say(f"broken: {error}")
        return 2
    try:
        found = run([args.dscl, ".", "-read", f"/Users/{name}", "UniqueID"])
        if found == 56:
            say(f"refused: the test account {name} does not exist")
            return 1
        if found != 0:
            say(f"broken: dscl answered {found} for {name}")
            return 2
        member = run([args.dseditgroup, "-o", "checkmember", "-m", name, "admin"])
    except (OSError, subprocess.TimeoutExpired) as error:
        say(f"broken: a lookup could not run: {error}")
        return 2
    if member == 0:
        say(f"refused: the test account {name} is an admin; destructive suites need a standard account")
        return 1
    if member != 67:
        say(f"broken: dseditgroup answered {member} for {name}")
        return 2
    if args.guard:
        try:
            current = pwd.getpwuid(os.getuid()).pw_name
            wanted = pwd.getpwnam(name).pw_uid
        except KeyError:
            say("broken: this process's uid, or the test account, has no entry in the user database")
            return 2
        if current != name:
            say(f"refused: this runs as {current}, not the test account {name}")
            return 1
        if os.geteuid() != wanted:
            say(f"refused: the effective uid {os.geteuid()} is not the test account's {wanted}; "
                "elevated runs are refused")
            return 1
        say(f"{name} exists, is a standard account, and is the account running this")
        return 0
    say(f"{name} exists and is a standard account")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
