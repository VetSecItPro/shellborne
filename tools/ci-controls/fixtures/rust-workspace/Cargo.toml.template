[workspace]
resolver = "3"
members = [
    "crates/sb-attach",
    "crates/sb-bounds",
    "crates/sb-cli",
    "crates/sb-core",
    "crates/sb-engine-vt",
    "crates/sb-host",
    "crates/sb-policy",
    "crates/sb-redact",
    "crates/sb-supervisor",
    "crates/sb-vt-worker",
    "crates/sb-wire",
]

[workspace.package]
version = "0.0.0"
edition = "2024"
license = "Apache-2.0"
publish = false

# The deny list lives here, where every build reads it; tools/gates/unsafe-code checks that it is still here
# (plan steps P0.10.1 and P0.10.2). crates/sb-engine-vt repeats this table with unsafe code allowed.
[workspace.lints.rust]
unsafe_code = "forbid"

[workspace.lints.clippy]
unwrap_used = "deny"
expect_used = "deny"
panic = "deny"
indexing_slicing = "deny"
arithmetic_side_effects = "deny"
disallowed_types = "deny"
disallowed_methods = "deny"

# Abort on panic, so nothing unwinds through foreign code. Test builds still unwind; there the lint list does
# the work.
[profile.dev]
panic = "abort"

[profile.release]
panic = "abort"
