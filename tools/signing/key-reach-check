#!/usr/bin/env python3
"""key-reach-check: show the builder account cannot read or sign with the release keys.

Usage:
    key-reach-check --keychain <path> --names <file> --signer <path> [--timeout <seconds>]

Run on this Mac from the builder account, never in CI. --names is a TOML list of what to probe, and
never key material:

    [[item]]      a Keychain generic password, looked up by service and account only
    [[eddsa]]     an EdDSA key account, probed by a signing attempt
    [[path]]      a named key path, checked with access(R_OK) and lstat, never opened

Lookups run /usr/bin/security against the --keychain path, never with -w, -g, -X, -p, an export
verb or dump-keychain, and keep only the exit status: 0 reachable, 44 unreachable, anything else
broken. The signer runs as `<signer> --account <account> <fixture>` on a copy of the fixture in a
temp folder that is deleted; its output is discarded unread. Exit 0 is reachable, exit 1 is
unreachable only when the control signed, and anything else (another code, a signal, a timeout, a
prompt that waits) is broken.

Codesigning identities in --keychain are listed with `security find-identity -p codesigning <keychain>`,
without -v, because codesign still signs with an identity that list would hide as untrusted. Each listed
identity makes a real codesign attempt, with /usr/bin/codesign, on a copy of the fixture in a temp folder:
`codesign --keychain <keychain> -s <hash> -f <copy>`, its output discarded unread. An identity whose name
starts with shellborne-keyreach-control- is the control, set up once by the owner in --keychain, and must
sign, or the run is broken; any other identity that signs is reachable. This tool never creates, imports or
deletes an identity. No control identity listed means the codesign probe is blind, and the run is broken,
never a pass; so is a control certificate with no usable private key. The user keychain search list is never
changed, and codesign sees an identity only when --keychain is already on that list, so a --keychain off the
list is broken too.

Before anything is written, security show-keychain-info must open --keychain, since security handed a
file that is not a keychain writes to the default one. Each run then deletes and plants a control item
and a control EdDSA account under the fixed names shellborne-keyreach-control-item and
shellborne-keyreach-control-eddsa in --keychain, probes them first, and removes them even on failure; a
run killed before its cleanup leaves them for the next run to delete, and two runs at once fail closed. A
control read as unreachable means a blind instrument: broken. Limit: the control EdDSA item is planted
by attributes only, so a real signer that looks keys up under its own service reads the control as
unreachable and the run is broken, never a pass.

Exit 0 nothing reachable, 1 something reachable, 2 broken. This tool never receives, prints, logs or
stores a byte of a key, of the signer's output or of a probed file. A program that cannot be started is
broken, and so is any unexpected error, so no fault can read as reachable.

security and codesign are named by absolute path and are never looked up on PATH, so a program placed earlier on
PATH cannot answer for them. The only stand-in is the module constants SECURITY and CODESIGN, which a test sets
after loading this file as a module; no environment variable or argument moves them. A named key path whose
folder the account cannot search (lstat fails with EACCES or EPERM) is unreachable. Once the first signal or the
end of the probes is reached, SIGINT, SIGTERM and SIGHUP are ignored until every planted control is removed.
Plan-Step: P0.11.12
"""
import argparse
import errno
import os
import pathlib
import re
import shutil
import signal
import subprocess
import sys
import tempfile
import tomllib

CONTROL_PREFIX = "shellborne-keyreach-control-"
# Fixed names, so every run removes what a killed run left before planting; a random name could never
# be found again, and a run killed before its cleanup left its controls in the login keychain.
CONTROL_ITEM = CONTROL_PREFIX + "item"
CONTROL_EDDSA = CONTROL_PREFIX + "eddsa"
SECURITY = "/usr/bin/security"
CODESIGN = "/usr/bin/codesign"
SIGNALS = (signal.SIGINT, signal.SIGTERM, signal.SIGHUP)
FIXTURE = pathlib.Path(__file__).resolve().parent / "sign-probe-fixture.txt"
NOT_FOUND = 44
DEFAULT_TIMEOUT = 30.0
MAX_NAMES_BYTES = 64 * 1024
MAX_ENTRIES = 200
MAX_FIELD = 512
MAX_INVENTORY_BYTES = 256 * 1024
MAX_IDENTITIES = 200
IDENTITY_LINE = re.compile(r'^\s*\d+\) ([0-9A-F]{40}) "(.*)"(?: \(.*\))?$')
COUNT_LINE = re.compile(r"^\s*(\d+) identities found$")
CERTIFICATE_HASH_LINE = re.compile(r"^SHA-1 hash: ([0-9A-F]{40})$")
FIELDS = {"item": ("service", "account"), "eddsa": ("account",), "path": ("path",)}


class Broken(Exception):
    pass


class Stopped(Exception):
    pass


def say(line):
    print(f"key-reach-check: {line}", flush=True)


def ignore_signals():
    for number in SIGNALS:
        signal.signal(number, signal.SIG_IGN)


def stop(signum, _frame):
    ignore_signals()  # a second signal while this one unwinds and the controls are removed changes nothing
    raise Stopped(f"stopped by signal {signum}")


def read_names(path):
    try:
        with open(path, "rb") as handle:
            data = handle.read(MAX_NAMES_BYTES + 1)
    except OSError as error:
        raise Broken(f"cannot read the names list: {error.strerror}") from None
    if len(data) > MAX_NAMES_BYTES:
        raise Broken(f"the names list is over {MAX_NAMES_BYTES} bytes")
    try:
        table = tomllib.loads(data.decode("utf-8"))
    except (UnicodeDecodeError, tomllib.TOMLDecodeError):
        raise Broken("the names list is not valid TOML") from None
    unknown = set(table) - set(FIELDS)
    if unknown:
        raise Broken(f"the names list has unknown tables: {', '.join(sorted(unknown))}")
    entries = {}
    for kind, fields in FIELDS.items():
        listed = table.get(kind, [])
        if not isinstance(listed, list) or not all(isinstance(entry, dict) for entry in listed):
            raise Broken(f"[[{kind}]] must be an array of tables")
        entries[kind] = []
        for entry in listed:
            if set(entry) != set(fields):
                raise Broken(f"each [[{kind}]] entry holds exactly: {', '.join(fields)}")
            for field in fields:
                value = entry[field]
                if not isinstance(value, str) or not value or len(value) > MAX_FIELD or "\0" in value:
                    raise Broken(f"[[{kind}]] {field} must be a non-empty string under {MAX_FIELD} characters")
                if value.startswith(CONTROL_PREFIX):
                    raise Broken(f"[[{kind}]] {field} uses the control prefix")
            entries[kind].append(tuple(entry[field] for field in fields))
    total = sum(len(listed) for listed in entries.values())
    if total == 0:
        raise Broken("the names list is empty, so nothing would be probed")
    if total > MAX_ENTRIES:
        raise Broken(f"the names list has {total} entries, over the {MAX_ENTRIES} cap")
    return entries


def launch(argv, stdout):
    """Starts argv in its own session with no input and stderr discarded. Raises Broken when it cannot start,
    because an exception left to escape would exit 1, which means reachable."""
    try:
        return subprocess.Popen(argv, stdin=subprocess.DEVNULL, stdout=stdout, stderr=subprocess.DEVNULL,
                                start_new_session=True)
    except OSError as error:
        raise Broken(f"could not start {os.path.basename(argv[0])}: {error.strerror}") from None


def run_quiet(argv, timeout):
    """Runs argv with no input and its output discarded unread. Returns the exit status, or None on a timeout.
    The whole process group is killed on a timeout, so nothing is left waiting at a prompt."""
    process = launch(argv, subprocess.DEVNULL)
    try:
        return process.wait(timeout=timeout)
    except subprocess.TimeoutExpired:
        return None
    finally:
        if process.poll() is None:
            try:
                os.killpg(process.pid, signal.SIGKILL)
            except (ProcessLookupError, PermissionError):
                process.kill()
            process.wait()


def run_listing(argv, timeout):
    """Runs argv with no input and stderr discarded, reading at most MAX_INVENTORY_BYTES of stdout.
    Returns (status, text). The status is None on a timeout or an over-cap listing."""
    with tempfile.TemporaryFile() as out:
        process = launch(argv, out)
        try:
            status = process.wait(timeout=timeout)
        except subprocess.TimeoutExpired:
            status = None
        finally:
            if process.poll() is None:
                try:
                    os.killpg(process.pid, signal.SIGKILL)
                except (ProcessLookupError, PermissionError):
                    process.kill()
                process.wait()
        out.seek(0)
        data = out.read(MAX_INVENTORY_BYTES + 1)
    if len(data) > MAX_INVENTORY_BYTES:
        return None, ""
    return status, data.decode("utf-8", errors="replace")


def parse_identities(text):
    """Reads the Matching identities section of find-identity output into (hash, name) pairs, one per hash.
    Raises Broken when the listed lines and the stated count disagree."""
    lines = text.splitlines()
    try:
        start = next(number for number, line in enumerate(lines) if line.strip() == "Matching identities")
    except StopIteration:
        raise Broken("the codesigning inventory has no Matching identities section") from None
    listed = []
    stated = None
    for line in lines[start + 1:]:
        counted = COUNT_LINE.match(line)
        if counted:
            stated = int(counted.group(1))
            break
        found = IDENTITY_LINE.match(line)
        if not found:
            raise Broken("the codesigning inventory has a line it cannot read")
        listed.append((found.group(1), found.group(2)))
    if stated is None or stated != len(listed):
        raise Broken("the codesigning inventory's count does not match its listed identities")
    if len(listed) > MAX_IDENTITIES:
        raise Broken(f"the codesigning inventory lists {len(listed)} identities, over the {MAX_IDENTITIES} cap")
    unique = {}
    for digest, name in listed:
        unique.setdefault(digest, name)
    return list(unique.items())


class Probe:
    def __init__(self, security, keychain, signer, codesign, timeout):
        self.security = security
        self.keychain = keychain
        self.signer = signer
        self.codesign = codesign
        self.timeout = timeout
        self.planted = []

    def security_status(self, *args):
        status = run_quiet([self.security, *args, self.keychain], self.timeout)
        if status is None:
            raise Broken(f"security {args[0]} did not finish within {self.timeout:g} s")
        return status

    def require_keychain(self):
        """Handed a file that is not a keychain, security writes to the default keychain, so nothing is
        written until security opens --keychain as one."""
        status = self.security_status("show-keychain-info")
        if status != 0:
            raise Broken(f"security cannot open --keychain as a keychain (exit {status}), and a write would land in the "
                         "default keychain")

    def clear(self, service, account):
        """Remove a control a killed run left: deleted, or already absent."""
        status = self.security_status("delete-generic-password", "-s", service, "-a", account)
        if status not in (0, NOT_FOUND):
            raise Broken(f"could not clear the control {service} before planting (security exit {status})")

    def plant(self, service, account):
        self.planted.append((service, account))
        status = self.security_status("add-generic-password", "-s", service, "-a", account)
        if status != 0:
            raise Broken(f"could not plant a control item (security exit {status})")

    def remove_planted(self):
        failures = []
        for service, account in self.planted:
            try:
                status = self.security_status("delete-generic-password", "-s", service, "-a", account)
            except (Broken, OSError) as error:
                failures.append(str(error) if isinstance(error, Broken) else "could not remove a control item")
                continue
            if status not in (0, NOT_FOUND):
                failures.append(f"could not remove the control {service} (security exit {status})")
        self.planted = []
        return failures

    def item_reachable(self, service, account):
        status = self.security_status("find-generic-password", "-s", service, "-a", account)
        if status == 0:
            return True
        if status == NOT_FOUND:
            return False
        if status < 0:
            raise Broken(f"security find-generic-password ended on signal {-status}")
        raise Broken(f"security find-generic-password exited {status}, neither found nor not found")

    def identities(self):
        argv = [self.security, "find-identity", "-p", "codesigning", self.keychain]
        status, text = run_listing(argv, self.timeout)
        if status is None:
            raise Broken(f"security find-identity did not finish within {self.timeout:g} s or listed too much")
        if status != 0:
            raise Broken(f"security find-identity exited {status}, so the codesigning inventory is unknown")
        return parse_identities(text)

    def control_certificates(self):
        """Returns the SHA-1 hashes of every certificate in the keychain whose name holds the control prefix.
        Only the hash lines of the listing are read; a certificate is public and holds no key."""
        # Without -a, find-certificate exits 44 when nothing matches; with -a it exits 0 either way.
        argv = [self.security, "find-certificate", "-a", "-Z", "-c", CONTROL_PREFIX, self.keychain]
        status, text = run_listing(argv, self.timeout)
        if status is None:
            raise Broken(f"security find-certificate did not finish within {self.timeout:g} s or listed too much")
        if status == NOT_FOUND:
            return set()
        if status != 0:
            raise Broken(f"security find-certificate exited {status}, neither found nor not found")
        hashes = set()
        for line in text.splitlines():
            found = CERTIFICATE_HASH_LINE.match(line.strip())
            if found:
                hashes.add(found.group(1))
        return hashes

    def codesigns(self, digest):
        with tempfile.TemporaryDirectory(prefix="key-reach-codesign-") as tmp:
            copy = pathlib.Path(tmp) / FIXTURE.name
            shutil.copyfile(FIXTURE, copy)
            status = run_quiet([self.codesign, "--keychain", self.keychain, "-s", digest, "-f", str(copy)],
                               self.timeout)
        if status is None:
            raise Broken(f"codesign did not finish within {self.timeout:g} s (a timeout or a prompt that waits)")
        if status < 0:
            raise Broken(f"codesign ended on signal {-status}")
        return status

    def signs(self, account):
        with tempfile.TemporaryDirectory(prefix="key-reach-sign-") as tmp:
            copy = pathlib.Path(tmp) / FIXTURE.name
            shutil.copyfile(FIXTURE, copy)
            status = run_quiet([self.signer, "--account", account, str(copy)], self.timeout)
        if status is None:
            raise Broken(f"the signer did not finish within {self.timeout:g} s (a timeout or a prompt that waits)")
        if status == 0:
            return True
        if status == 1:
            return False
        if status < 0:
            raise Broken(f"the signer ended on signal {-status}")
        raise Broken(f"the signer exited {status}, neither signed nor refused")


def path_reachable(path):
    try:
        os.lstat(path)
    except FileNotFoundError:
        return False
    except OSError as error:
        if error.errno in (errno.EACCES, errno.EPERM):  # a folder this account cannot search: the key is out of reach
            return False
        raise Broken(f"lstat failed on a named path: {error.strerror}") from None
    return os.access(path, os.R_OK)


def check_identities(probe):
    """Returns the reachable identity lines. Raises Broken when the codesign probe cannot be trusted."""
    listed = probe.identities()
    if probe.control_certificates() - {digest for digest, _name in listed}:
        raise Broken("a control certificate is in the keychain without a usable private key")
    controls = [(digest, name) for digest, name in listed if name.startswith(CONTROL_PREFIX)]
    others = [(digest, name) for digest, name in listed if not name.startswith(CONTROL_PREFIX)]
    if not controls:
        raise Broken(f"no {CONTROL_PREFIX} identity is listed, so the codesign probe is blind; the owner sets up "
                     "the control identity once in this keychain")
    for digest, _name in controls:
        status = probe.codesigns(digest)
        if status != 0:
            raise Broken(f"the control identity did not sign (codesign exit {status}), so the codesign probe is blind; "
                         "the owner sets up the control identity once in this keychain")
    found = []
    for digest, name in others:
        status = probe.codesigns(digest)
        if status == 0:
            found.append(f"reachable identity {digest} {name}")
        elif status != 1:
            raise Broken(f"codesign exited {status} for identity {digest}, neither signed nor refused")
    return found


def check(args, probe, entries):
    """Returns the reachable lines. Raises Broken when an instrument cannot be trusted."""
    probe.require_keychain()
    control_item = (CONTROL_ITEM, CONTROL_ITEM)
    control_eddsa = CONTROL_EDDSA
    for service, account in (control_item, (CONTROL_EDDSA, CONTROL_EDDSA)):
        probe.clear(service, account)  # what a killed run left, before this run plants its own
    probe.plant(*control_item)
    probe.plant(CONTROL_EDDSA, control_eddsa)
    if not probe.item_reachable(*control_item):
        raise Broken("the control item read as unreachable, so the lookup is blind")
    if not probe.signs(control_eddsa):
        raise Broken("the control EdDSA account did not sign, so the signing probe is blind")
    found = check_identities(probe)
    for service, account in entries["item"]:
        if probe.item_reachable(service, account):
            found.append(f"reachable item service {service} account {account}")
    for (account,) in entries["eddsa"]:
        if probe.signs(account):
            found.append(f"reachable eddsa account {account}")
    for (path,) in entries["path"]:
        if path_reachable(path):
            found.append(f"reachable path {path}")
    return found


def main(argv):
    try:
        return run(argv)
    except Exception as error:  # an uncaught exception exits 1, which this tool defines as "something reachable"
        say(f"broken: an unexpected {type(error).__name__} ended the run")
        return 2


def run(argv):
    parser = argparse.ArgumentParser(prog="key-reach-check", add_help=True)
    parser.add_argument("--keychain", required=True)
    parser.add_argument("--names", required=True)
    parser.add_argument("--signer", required=True)
    parser.add_argument("--timeout", type=float, default=DEFAULT_TIMEOUT)
    try:
        args = parser.parse_args(argv)
    except SystemExit:
        say("broken: usage: key-reach-check --keychain <path> --names <file> --signer <path> [--timeout <seconds>]")
        return 2
    if not args.timeout > 0:
        say("broken: --timeout must be a positive number of seconds")
        return 2
    try:
        entries = read_names(args.names)
    except Broken as error:
        say(f"broken: {error}")
        return 2
    if not os.access(SECURITY, os.X_OK):
        say("broken: /usr/bin/security is not an executable file")
        return 2
    if not os.access(args.signer, os.X_OK):
        say("broken: the signer is not an executable file")
        return 2
    if not os.access(CODESIGN, os.X_OK):
        say("broken: /usr/bin/codesign is not an executable file")
        return 2
    if not os.path.isfile(args.keychain):
        say("broken: the --keychain path is not a file, and security would list it as empty")
        return 2
    if not FIXTURE.is_file():
        say("broken: the signing fixture is missing")
        return 2
    probe = Probe(SECURITY, args.keychain, args.signer, CODESIGN, args.timeout)
    previous = {number: signal.signal(number, stop) for number in SIGNALS}
    problems = []
    found = []
    try:
        found = check(args, probe, entries)
    except (Broken, Stopped) as error:
        problems.append(str(error))
    except OSError as error:
        problems.append(f"an operating system call failed: {error.strerror}")
    except Exception as error:  # nothing unexpected may escape: an uncaught exception exits 1, which means reachable
        problems.append(f"an unexpected {type(error).__name__} ended the run")
    finally:
        ignore_signals()
        problems += probe.remove_planted()
        for number, handler in previous.items():
            signal.signal(number, handler)
    if problems:
        for problem in problems:
            say(f"broken: {problem}")
        return 2
    for line in found:
        say(line)
    return 1 if found else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
