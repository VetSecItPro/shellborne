#!/usr/bin/env python3
"""key-reach-check: show the builder account cannot read or sign with the release keys.

Usage:
    key-reach-check [--plant | --probe-only | --remove] --keychain <path> --names <file> --signer <path>
                    [--timeout <seconds>]

Run on this Mac from the builder account, never in CI. --names is a TOML list of what to probe, and
never key material:

    [[item]]      a Keychain generic password, looked up by service and account only
    [[eddsa]]     an EdDSA key account, probed by a signing attempt
    [[path]]      a named key path, checked with access(R_OK) and lstat, never opened
    [[identity]]  a codesigning identity to try by its 40-character SHA-1 hash, whatever its name

Lookups run /usr/bin/security against the --keychain path, never with -w, -g, -X, -p, an export
verb or dump-keychain, and keep only the exit status: 0 reachable, 44 unreachable, anything else
broken. The signer runs as `<signer> --account <account> <fixture>` on a copy of the fixture in a
temp folder that is deleted; its output is discarded unread. Exit 0 is reachable, exit 1 is
unreachable only when the control signed, and anything else (another code, a signal, a timeout, a
prompt that waits) is broken.

Codesigning identities in --keychain are listed with `security find-identity -p codesigning <keychain>`,
without -v, because codesign still signs with an identity that list would hide as untrusted. Three kinds get a
real codesign attempt: the control, anything named "Developer ID Application:" or "Developer ID Installer:" (the
identities that sign builds other people run, so leaving one out of --names never hides it), and anything --names
lists. A development identity, say, gets a "skipped identity" line and is never counted. Each attempt runs
/usr/bin/codesign on a copy of the fixture in a temp folder:
`codesign --keychain <keychain> -s <hash> -f <copy>`, its output discarded unread. An identity whose name
starts with shellborne-keyreach-control- is the control, set up once by the owner in --keychain, and must
sign, or the run is broken; any other identity that signs is reachable. This tool never creates, imports or
deletes an identity. No control identity listed means the codesign probe is blind, and the run is broken,
never a pass; so is a control certificate with no usable private key. The user keychain search list is never
changed, and codesign sees an identity only when --keychain is already on that list, so a --keychain off the
list is broken too.

Before anything is written, security show-keychain-info must open --keychain, since security handed a
file that is not a keychain writes to the default one. Each run then deletes and plants a control item
and a control EdDSA account under the fixed names shellborne-keyreach-control-item and
shellborne-keyreach-control-eddsa in --keychain, probes them first, and removes them even on failure; a
run killed before its cleanup leaves them for the next run to delete, and a run holds an exclusive lock for
its keychain, so a second run at once is broken. A
control read as unreachable means a blind instrument: broken. Limit: the control EdDSA item is planted
by attributes only, so a real signer that looks keys up under its own service reads the control as
unreachable and the run is broken, never a pass.

Exit 0 nothing reachable, 1 something reachable, 2 broken. This tool never receives, prints, logs or
stores a byte of a key, of the signer's output or of a probed file. A program that cannot be started is
broken, and so is any unexpected error, so no fault can read as reachable.

security and codesign are named by absolute path and are never looked up on PATH, so a program placed earlier on
PATH cannot answer for them. The only stand-in is the module constants SECURITY and CODESIGN, which a test sets
after loading this file as a module; no environment variable or argument moves them. A named key path whose
folder the account cannot search (lstat fails with EACCES or EPERM) is unreachable. Once the first signal or the
end of the probes is reached, SIGINT, SIGTERM and SIGHUP are ignored until every planted control is removed.

Inside a session that is denied the keychain, the default run can only ever say broken: its own controls are out
of reach there too. Three modes split the run for that case (P0.24.1); give at most one.
  --plant       outside the session. Checks --keychain opens, clears anything an interrupted run left, adds the
                two control items, confirms both answer, and exits 0 with them still there. If either stays silent
                it takes them out again and exits 2.
  --probe-only  inside the session, and outside it for comparison. Adds, deletes and locks nothing. It tries the
                two control items, each name in --names and each codesigning identity in --keychain, the control
                identity among them, and prints one line per success. Exit 0 when nothing answered, 1 when
                anything did, 2 broken. A silent control is a finding here, not a fault, because the comparison
                run outside must report both controls and the control identity. A --keychain this account is not
                even allowed to stat is treated as out of reach; one that does not exist is broken.
  --remove      outside the session. Checks --keychain opens, then deletes both control items; one already gone
                counts as deleted.
--plant and --remove take the same per-keychain lock and handle signals the same way as the default run.
Plan-Step: P0.11.12
Plan-Step: P0.24.1
"""
import argparse
import contextlib
import errno
import fcntl
import hashlib
import math
import os
import pathlib
import re
import select
import shutil
import signal
import stat
import subprocess
import sys
import tempfile
import time
import tomllib

CONTROL_PREFIX = "shellborne-keyreach-control-"
# Fixed names, so every run removes what a killed run left before planting; a random name could never
# be found again, and a run killed before its cleanup left its controls in the login keychain.
CONTROL_ITEM = CONTROL_PREFIX + "item"
CONTROL_EDDSA = CONTROL_PREFIX + "eddsa"
SECURITY = "/usr/bin/security"
CODESIGN = "/usr/bin/codesign"
SIGNALS = (signal.SIGINT, signal.SIGTERM, signal.SIGHUP)
FIXTURE = pathlib.Path(__file__).resolve().parent / "sign-probe-fixture.txt"
NOT_FOUND = 44
DEFAULT_TIMEOUT = 30.0
MAX_TIMEOUT = 600.0  # a deadline has to be one: --timeout is finite and no longer than this
MAX_NAMES_BYTES = 64 * 1024
MAX_ENTRIES = 200
MAX_FIELD = 512
MAX_INVENTORY_BYTES = 256 * 1024
MAX_IDENTITIES = 200
IDENTITY_LINE = re.compile(r'^\s*\d+\) ([0-9A-F]{40}) "(.*)"(?: \(.*\))?$')
COUNT_LINE = re.compile(r"^\s*(\d+) identities found$")
CERTIFICATE_HASH_LINE = re.compile(r"^SHA-1 hash: ([0-9A-F]{40})$")
FIELDS = {"item": ("service", "account"), "eddsa": ("account",), "path": ("path",), "identity": ("hash",)}
HASH = re.compile(r"[0-9A-Fa-f]{40}")
# Identities that can sign a build other people run: always tried, listed or not.
RELEASE_PREFIXES = ("Developer ID Application:", "Developer ID Installer:")


class Broken(Exception):
    pass


class Stopped(Exception):
    pass


def say(line):
    """Every line this tool prints, as one line of printable ASCII: anything else (a control character, a newline,
    non-ASCII text in an identity name the keychain returned) is shown as an escape, so no name can forge a line."""
    shown = "".join(ch if 32 <= ord(ch) < 127 and ch != "\\" else
                    ("\\\\" if ch == "\\" else f"\\x{ord(ch):02x}" if ord(ch) < 256 else
                     f"\\u{ord(ch):04x}" if ord(ch) < 0x10000 else f"\\U{ord(ch):08x}")
                    for ch in str(line))
    print(f"key-reach-check: {shown}", flush=True)


def ignore_signals():
    for number in SIGNALS:
        signal.signal(number, signal.SIG_IGN)


def stop(signum, _frame):
    ignore_signals()  # a second signal while this one unwinds and the controls are removed changes nothing
    raise Stopped(f"stopped by signal {signum}")


def read_names(path):
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NONBLOCK | os.O_NOFOLLOW)  # a pipe or a link never holds the run
        with os.fdopen(fd, "rb") as handle:
            if not stat.S_ISREG(os.fstat(handle.fileno()).st_mode):
                raise Broken("the names list is not a regular file")
            data = handle.read(MAX_NAMES_BYTES + 1)
    except OSError as error:
        raise Broken(f"cannot read the names list: {error.strerror}") from None
    if len(data) > MAX_NAMES_BYTES:
        raise Broken(f"the names list is over {MAX_NAMES_BYTES} bytes")
    try:
        table = tomllib.loads(data.decode("utf-8"))
    except (UnicodeDecodeError, tomllib.TOMLDecodeError):
        raise Broken("the names list is not valid TOML") from None
    unknown = set(table) - set(FIELDS)
    if unknown:
        raise Broken(f"the names list has unknown tables: {', '.join(sorted(unknown))}")
    entries = {}
    for kind, fields in FIELDS.items():
        listed = table.get(kind, [])
        if not isinstance(listed, list) or not all(isinstance(entry, dict) for entry in listed):
            raise Broken(f"[[{kind}]] must be an array of tables")
        entries[kind] = []
        for entry in listed:
            if set(entry) != set(fields):
                raise Broken(f"each [[{kind}]] entry holds exactly: {', '.join(fields)}")
            for field in fields:
                value = entry[field]
                if not isinstance(value, str) or not value or len(value) > MAX_FIELD or "\0" in value:
                    raise Broken(f"[[{kind}]] {field} must be a non-empty string under {MAX_FIELD} characters")
                if value.startswith(CONTROL_PREFIX):
                    raise Broken(f"[[{kind}]] {field} uses the control prefix")
                if kind == "identity" and not HASH.fullmatch(value):
                    raise Broken("[[identity]] hash must be the identity's 40-character SHA-1 hash")
            entries[kind].append(tuple(entry[field].upper() if kind == "identity" else entry[field]
                                       for field in fields))
    total = sum(len(listed) for listed in entries.values())
    if total == 0:
        raise Broken("the names list is empty, so nothing would be probed")
    if total > MAX_ENTRIES:
        raise Broken(f"the names list has {total} entries, over the {MAX_ENTRIES} cap")
    return entries


def launch(argv, stdout):
    """Starts argv in its own session with no input and stderr discarded. Raises Broken when it cannot start,
    because an exception left to escape would exit 1, which means reachable."""
    try:
        return subprocess.Popen(argv, stdin=subprocess.DEVNULL, stdout=stdout, stderr=subprocess.DEVNULL,
                                start_new_session=True)
    except OSError as error:
        raise Broken(f"could not start {os.path.basename(argv[0])}: {error.strerror}") from None


@contextlib.contextmanager
def signals_held():
    """Blocks the handled signals while a child's group is ended and the child reaped, so a stop cannot cut that
    short; one that arrives meanwhile is delivered when the block ends."""
    held = signal.pthread_sigmask(signal.SIG_BLOCK, SIGNALS)
    try:
        yield
    finally:
        signal.pthread_sigmask(signal.SIG_SETMASK, held)


def run_quiet(argv, timeout):
    """Runs argv with no input and its output discarded unread. Returns the exit status, or None on a timeout.
    The exit is seen without reaping (leader_exited); then the process group is ended whether the probe finished or
    ran out of time, so nothing it started outlives it, and the leader is reaped last, within a bound."""
    held = start_held()
    try:
        process = launch(argv, subprocess.DEVNULL)
    except BaseException:
        signal.pthread_sigmask(signal.SIG_SETMASK, held)
        raise
    finished = False
    collected = False
    deadline = time.monotonic() + timeout
    try:
        signal.pthread_sigmask(signal.SIG_SETMASK, held)  # first thing inside: a stop now lands where cleanup runs
        while True:
            if leader_exited(process):
                finished = True
                break
            if time.monotonic() >= deadline:
                break
            time.sleep(0.02)
    finally:
        with signals_held():
            end_group(process)
            collected = reap_bounded(process, 5)
    if not collected:
        raise Broken(f"{os.path.basename(argv[0])} could not be collected after it was stopped")
    if getattr(process, "lost", False):
        raise Broken(f"{os.path.basename(argv[0])}'s exit status was lost (is SIGCHLD ignored?)")
    return process.returncode if finished else None


def run_listing(argv, timeout):
    """Runs argv with no input and stderr discarded, reading its stdout from a pipe as it arrives and stopping its
    process group once more than MAX_INVENTORY_BYTES has come, so a listing never runs on past the cap.
    The listing's exit is seen without reaping it (leader_exited), its group is ended while it is still a zombie that
    holds its id, and it is reaped last, so no signal can reach a reused group id; a leftover child holding the pipe
    is ended at once. Returns (status, text). The status is None on a timeout or an over-cap listing."""
    held = start_held()
    try:
        process = launch(argv, subprocess.PIPE)
    except BaseException:
        signal.pthread_sigmask(signal.SIG_SETMASK, held)
        raise
    data = bytearray()
    over = False
    timed_out = False
    stopped = False
    deadline = time.monotonic() + timeout
    try:
        signal.pthread_sigmask(signal.SIG_SETMASK, held)  # first thing inside: a stop now lands where cleanup runs
        fd = process.stdout.fileno()
        while True:
            left = deadline - time.monotonic()
            if left <= 0:
                timed_out = True  # the pipe is still open: a timeout, whatever the listing itself returned
                break
            if not stopped and leader_exited(process):
                end_group(process)  # a child it left would keep the pipe open
                stopped = True
            ready, _, _ = select.select([fd], [], [], min(left, 0.25))
            if not ready:
                continue
            chunk = os.read(fd, 64 * 1024)
            if not chunk:
                break
            data += chunk
            if len(data) > MAX_INVENTORY_BYTES:
                over = True
                break
        if not (over or timed_out):
            while not leader_exited(process):  # the pipe ended; wait for the exit itself, still without reaping
                if time.monotonic() >= deadline:
                    timed_out = True
                    break
                time.sleep(0.02)
    finally:
        with signals_held():
            if not stopped:
                end_group(process)  # alive or a zombie, the leader is unreaped: its group id is still its own
            collected = reap_bounded(process, 5)  # reaped only after the last signal, and never waited on forever
            process.stdout.close()
    if not collected:
        raise Broken("the identity listing could not be collected after it was stopped")
    if getattr(process, "lost", False):
        raise Broken("the identity listing's exit status was lost (is SIGCHLD ignored?)")
    if over or timed_out:
        return None, ""
    return process.returncode, bytes(data).decode("utf-8", errors="replace")


def start_held():
    """SIGCHLD back to its default (a launcher that ignores it lets the kernel reap children and free their ids),
    then the handled signals blocked until the caller's cleanup block is in place. Returns the mask to restore."""
    try:
        signal.signal(signal.SIGCHLD, signal.SIG_DFL)
    except ValueError:
        pass  # not the main thread; leader_held still refuses to signal a group it does not hold
    return signal.pthread_sigmask(signal.SIG_BLOCK, SIGNALS)


def leader_held(process):
    """True while the process is still this one's child to collect, running or a zombie; only then are its ids
    still its own. False once something else reaped it, and its group is then never signalled."""
    try:
        os.waitid(os.P_PID, process.pid, os.WEXITED | os.WNOHANG | os.WNOWAIT)
    except ChildProcessError:
        process.lost = True
        return False
    return True


def reap_bounded(process, seconds):
    """Collects the leader once it has exited, waiting at most seconds; False when it cannot be collected, which the
    caller turns into a broken run rather than a wait without end."""
    end = time.monotonic() + seconds
    while not leader_exited(process):
        if time.monotonic() >= end:
            return False
        time.sleep(0.02)
    if not leader_held(process):
        return True  # something else collected it; the caller reports the lost status
    process.wait()  # it has exited, so this returns at once
    return True


def end_group(process):
    """SIGKILL to a child's process group, sent only while its leader is unreaped (alive or a zombie), so the group
    id is still the child's own. A refusal for the group falls back to the leader alone. Signals held."""
    with signals_held():
        if not leader_held(process):
            return  # something else reaped it, so its group id may already belong to someone else
        try:
            os.killpg(process.pid, signal.SIGKILL)
        except ProcessLookupError:
            pass
        except PermissionError:  # macOS refuses a group whose only member is the zombie leader
            try:
                os.kill(process.pid, signal.SIGKILL)  # never Popen.kill, which polls and so reaps the leader
            except (ProcessLookupError, PermissionError):
                pass


def leader_exited(process):
    """True once the process has exited, seen with waitid and WNOWAIT so it is not reaped and keeps its ids taken."""
    try:
        return os.waitid(os.P_PID, process.pid, os.WEXITED | os.WNOHANG | os.WNOWAIT) is not None
    except ChildProcessError:
        process.lost = True  # reaped by something else: its status is gone and its group is never signalled
        return True

def parse_identities(text):
    """Reads the Matching identities section of find-identity output into (hash, name) pairs, one per hash.
    Raises Broken when the listed lines and the stated count disagree."""
    lines = text.splitlines()
    try:
        start = next(number for number, line in enumerate(lines) if line.strip() == "Matching identities")
    except StopIteration:
        raise Broken("the codesigning inventory has no Matching identities section") from None
    listed = []
    stated = None
    for line in lines[start + 1:]:
        counted = COUNT_LINE.match(line)
        if counted:
            stated = int(counted.group(1))
            break
        found = IDENTITY_LINE.match(line)
        if not found:
            raise Broken("the codesigning inventory has a line it cannot read")
        listed.append((found.group(1), found.group(2)))
    if stated is None or stated != len(listed):
        raise Broken("the codesigning inventory's count does not match its listed identities")
    if len(listed) > MAX_IDENTITIES:
        raise Broken(f"the codesigning inventory lists {len(listed)} identities, over the {MAX_IDENTITIES} cap")
    unique = {}
    for digest, name in listed:
        unique.setdefault(digest, name)
    return list(unique.items())


def hold_keychain(keychain):
    """An exclusive lock for one keychain, held until the process exits, so two runs never share the fixed control
    names: a second run is broken, never a pass. Raises OSError when another run holds it."""
    digest = hashlib.sha256(os.path.realpath(keychain).encode()).hexdigest()[:16]
    handle = open(os.path.join(tempfile.gettempdir(), f"shellborne-keyreach-{digest}.lock"), "a")
    fcntl.flock(handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
    return handle


class Probe:
    def __init__(self, security, keychain, signer, codesign, timeout):
        self.security = security
        self.keychain = keychain
        self.signer = signer
        self.codesign = codesign
        self.timeout = timeout
        self.planted = []
        self.skipped = []

    def security_status(self, *args):
        status = run_quiet([self.security, *args, self.keychain], self.timeout)
        if status is None:
            raise Broken(f"security {args[0]} did not finish within {self.timeout:g} s")
        return status

    def require_keychain(self):
        """Handed a file that is not a keychain, security writes to the default keychain, so nothing is
        written until security opens --keychain as one."""
        status = self.security_status("show-keychain-info")
        if status != 0:
            raise Broken(f"security cannot open --keychain as a keychain (exit {status}), and a write would land "
                         "in the default keychain")

    def clear(self, service, account):
        """Remove a control a killed run left: deleted, or already absent."""
        status = self.security_status("delete-generic-password", "-s", service, "-a", account)
        if status not in (0, NOT_FOUND):
            raise Broken(f"could not clear the control {service} before planting (security exit {status})")

    def plant(self, service, account):
        self.planted.append((service, account))
        status = self.security_status("add-generic-password", "-s", service, "-a", account)
        if status != 0:
            raise Broken(f"could not plant a control item (security exit {status})")

    def remove_planted(self):
        failures = []
        for service, account in self.planted:
            try:
                status = self.security_status("delete-generic-password", "-s", service, "-a", account)
            except (Broken, OSError) as error:
                failures.append(str(error) if isinstance(error, Broken) else "could not remove a control item")
                continue
            if status not in (0, NOT_FOUND):
                failures.append(f"could not remove the control {service} (security exit {status})")
        self.planted = []
        return failures

    def item_reachable(self, service, account):
        status = self.security_status("find-generic-password", "-s", service, "-a", account)
        if status == 0:
            return True
        if status == NOT_FOUND:
            return False
        if status < 0:
            raise Broken(f"security find-generic-password ended on signal {-status}")
        raise Broken(f"security find-generic-password exited {status}, neither found nor not found")

    def identities(self):
        argv = [self.security, "find-identity", "-p", "codesigning", self.keychain]
        status, text = run_listing(argv, self.timeout)
        if status is None:
            raise Broken(f"security find-identity did not finish within {self.timeout:g} s or listed too much")
        if status != 0:
            raise Broken(f"security find-identity exited {status}, so the codesigning inventory is unknown")
        return parse_identities(text)

    def control_certificates(self):
        """Returns the SHA-1 hashes of every certificate in the keychain whose name holds the control prefix.
        Only the hash lines of the listing are read; a certificate is public and holds no key."""
        # Without -a, find-certificate exits 44 when nothing matches; with -a it exits 0 either way.
        argv = [self.security, "find-certificate", "-a", "-Z", "-c", CONTROL_PREFIX, self.keychain]
        status, text = run_listing(argv, self.timeout)
        if status is None:
            raise Broken(f"security find-certificate did not finish within {self.timeout:g} s or listed too much")
        if status == NOT_FOUND:
            return set()
        if status != 0:
            raise Broken(f"security find-certificate exited {status}, neither found nor not found")
        hashes = set()
        for line in text.splitlines():
            found = CERTIFICATE_HASH_LINE.match(line.strip())
            if found:
                hashes.add(found.group(1))
        return hashes

    def codesigns(self, digest):
        with tempfile.TemporaryDirectory(prefix="key-reach-codesign-") as tmp:
            copy = pathlib.Path(tmp) / FIXTURE.name
            shutil.copyfile(FIXTURE, copy)
            status = run_quiet([self.codesign, "--keychain", self.keychain, "-s", digest, "-f", str(copy)],
                               self.timeout)
        if status is None:
            raise Broken(f"codesign did not finish within {self.timeout:g} s (a timeout or a prompt that waits)")
        if status < 0:
            raise Broken(f"codesign ended on signal {-status}")
        return status

    def signs(self, account):
        with tempfile.TemporaryDirectory(prefix="key-reach-sign-") as tmp:
            copy = pathlib.Path(tmp) / FIXTURE.name
            shutil.copyfile(FIXTURE, copy)
            status = run_quiet([self.signer, "--account", account, str(copy)], self.timeout)
        if status is None:
            raise Broken(f"the signer did not finish within {self.timeout:g} s (a timeout or a prompt that waits)")
        if status == 0:
            return True
        if status == 1:
            return False
        if status < 0:
            raise Broken(f"the signer ended on signal {-status}")
        raise Broken(f"the signer exited {status}, neither signed nor refused")


def path_reachable(path):
    try:
        os.lstat(path)
    except FileNotFoundError:
        return False
    except OSError as error:
        if error.errno in (errno.EACCES, errno.EPERM):  # a folder this account cannot search: the key is out of reach
            return False
        raise Broken(f"lstat failed on a named path: {error.strerror}") from None
    return os.access(path, os.R_OK)


def tried(probe, identities, listed_hashes):
    """The identities worth a signing attempt: every release identity and every listed one. The rest are noted on
    the probe's skipped lines and never count as reachable."""
    chosen = []
    for digest, name in identities:
        if name.startswith(RELEASE_PREFIXES) or digest in listed_hashes:
            chosen.append((digest, name))
        else:
            probe.skipped.append(f"skipped identity {digest} {name} (not a release identity and not listed)")
    return chosen


def check_identities(probe, listed_hashes=frozenset()):
    """Returns the reachable identity lines. Raises Broken when the codesign probe cannot be trusted."""
    listed = probe.identities()
    if probe.control_certificates() - {digest for digest, _name in listed}:
        raise Broken("a control certificate is in the keychain without a usable private key")
    controls = [(digest, name) for digest, name in listed if name.startswith(CONTROL_PREFIX)]
    others = tried(probe, [(digest, name) for digest, name in listed if not name.startswith(CONTROL_PREFIX)],
                   listed_hashes)
    if not controls:
        raise Broken(f"no {CONTROL_PREFIX} identity is listed, so the codesign probe is blind; the owner sets up "
                     "the control identity once in this keychain")
    for digest, _name in controls:
        status = probe.codesigns(digest)
        if status != 0:
            raise Broken(f"the control identity did not sign (codesign exit {status}), so the codesign probe is blind; "
                         "the owner sets up the control identity once in this keychain")
    found = []
    for digest, name in others:
        status = probe.codesigns(digest)
        if status == 0:
            found.append(f"reachable identity {digest} {name}")
        elif status != 1:
            raise Broken(f"codesign exited {status} for identity {digest}, neither signed nor refused")
    return found


def check(args, probe, entries):
    """Returns the reachable lines. Raises Broken when an instrument cannot be trusted."""
    probe.require_keychain()
    control_item = (CONTROL_ITEM, CONTROL_ITEM)
    control_eddsa = CONTROL_EDDSA
    for service, account in (control_item, (CONTROL_EDDSA, CONTROL_EDDSA)):
        probe.clear(service, account)  # what a killed run left, before this run plants its own
    probe.plant(*control_item)
    probe.plant(CONTROL_EDDSA, control_eddsa)
    if not probe.item_reachable(*control_item):
        raise Broken("the control item read as unreachable, so the lookup is blind")
    if not probe.signs(control_eddsa):
        raise Broken("the control EdDSA account did not sign, so the signing probe is blind")
    found = check_identities(probe, {digest for (digest,) in entries["identity"]})
    for service, account in entries["item"]:
        if probe.item_reachable(service, account):
            found.append(f"reachable item service {service} account {account}")
    for (account,) in entries["eddsa"]:
        if probe.signs(account):
            found.append(f"reachable eddsa account {account}")
    for (path,) in entries["path"]:
        if path_reachable(path):
            found.append(f"reachable path {path}")
    return found


def plant(probe):
    """--plant: the two controls, planted and proven reachable. Raises Broken when either reads as unreachable."""
    probe.require_keychain()
    for service in (CONTROL_ITEM, CONTROL_EDDSA):
        probe.clear(service, service)  # what a killed run left, before this run plants its own
    probe.plant(CONTROL_ITEM, CONTROL_ITEM)
    probe.plant(CONTROL_EDDSA, CONTROL_EDDSA)
    if not probe.item_reachable(CONTROL_ITEM, CONTROL_ITEM):
        raise Broken("the planted control item read as unreachable, so the lookup is blind")
    if not probe.signs(CONTROL_EDDSA):
        raise Broken("the planted control EdDSA account did not sign, so the signing probe is blind")


def remove(probe):
    """--remove: both controls deleted; absent counts as removed."""
    probe.require_keychain()
    for service in (CONTROL_ITEM, CONTROL_EDDSA):
        probe.clear(service, service)


def probe_only(probe, entries):
    """--probe-only: every probe, nothing written. Returns the reachable lines."""
    try:
        os.stat(probe.keychain)
    except OSError as error:
        if error.errno not in (errno.EACCES, errno.EPERM):  # gone, or some other fault: never read as out of reach
            raise Broken(f"cannot look at --keychain: {error.strerror}") from None
        # this account may not even look at it, which is the confined session's case
    else:
        probe.require_keychain()  # read-only; a file that is not a keychain would read as empty
    found = []
    if probe.item_reachable(CONTROL_ITEM, CONTROL_ITEM):
        found.append(f"reachable item service {CONTROL_ITEM} account {CONTROL_ITEM}")
    if probe.signs(CONTROL_EDDSA):
        found.append(f"reachable eddsa account {CONTROL_EDDSA}")
    listed_hashes = {digest for (digest,) in entries["identity"]}
    identities = probe.identities()
    chosen = [(d, n) for d, n in identities if n.startswith(CONTROL_PREFIX)]
    chosen += tried(probe, [(d, n) for d, n in identities if not n.startswith(CONTROL_PREFIX)], listed_hashes)
    for digest, name in chosen:
        status = probe.codesigns(digest)
        if status == 0:
            found.append(f"reachable identity {digest} {name}")
        elif status != 1:
            raise Broken(f"codesign exited {status} for identity {digest}, neither signed nor refused")
    for service, account in entries["item"]:
        if probe.item_reachable(service, account):
            found.append(f"reachable item service {service} account {account}")
    for (account,) in entries["eddsa"]:
        if probe.signs(account):
            found.append(f"reachable eddsa account {account}")
    for (path,) in entries["path"]:
        if path_reachable(path):
            found.append(f"reachable path {path}")
    return found


def keychain_present(keychain, mode):
    """Whether --keychain may be used. The default run and the writing modes need a file. --probe-only also takes
    one this account may not look at, since inside a confined session the keychain itself is what is out of reach;
    a path that does not exist is broken in every mode, or a typo would read as unreachable."""
    try:
        details = os.stat(keychain)
    except FileNotFoundError:
        return False
    except OSError as error:
        return mode == "probe-only" and error.errno in (errno.EACCES, errno.EPERM)
    return stat.S_ISREG(details.st_mode)


def main(argv):
    try:
        return run(argv)
    except Exception as error:  # an uncaught exception exits 1, which this tool defines as "something reachable"
        say(f"broken: an unexpected {type(error).__name__} ended the run")
        return 2
    except KeyboardInterrupt:  # before the stop handler is in place, or after it is gone: the same exit 1 otherwise
        say("broken: interrupted before the check finished")
        return 2


def run(argv):
    parser = argparse.ArgumentParser(prog="key-reach-check", add_help=True)
    parser.add_argument("--keychain", required=True)
    parser.add_argument("--names", required=True)
    parser.add_argument("--signer", required=True)
    parser.add_argument("--timeout", type=float, default=DEFAULT_TIMEOUT)
    modes = parser.add_mutually_exclusive_group()
    modes.add_argument("--plant", dest="mode", action="store_const", const="plant")
    modes.add_argument("--probe-only", dest="mode", action="store_const", const="probe-only")
    modes.add_argument("--remove", dest="mode", action="store_const", const="remove")
    try:
        args = parser.parse_args(argv)
    except SystemExit:
        say("broken: usage: key-reach-check [--plant | --probe-only | --remove] --keychain <path> --names <file> "
            "--signer <path> [--timeout <seconds>]")
        return 2
    if not (math.isfinite(args.timeout) and 0 < args.timeout <= MAX_TIMEOUT):
        say(f"broken: --timeout must be a number of seconds above 0 and at most {MAX_TIMEOUT:g}")
        return 2
    try:
        entries = read_names(args.names)
    except Broken as error:
        say(f"broken: {error}")
        return 2
    if not os.access(SECURITY, os.X_OK):
        say("broken: /usr/bin/security is not an executable file")
        return 2
    if not os.access(args.signer, os.X_OK):
        say("broken: the signer is not an executable file")
        return 2
    if not os.access(CODESIGN, os.X_OK):
        say("broken: /usr/bin/codesign is not an executable file")
        return 2
    if not keychain_present(args.keychain, args.mode):
        say("broken: the --keychain path is not a file, and security would list it as empty")
        return 2
    if not FIXTURE.is_file():
        say("broken: the signing fixture is missing")
        return 2
    lock = None  # --probe-only writes nothing, so it takes no lock and leaves no lock file
    if args.mode != "probe-only":
        try:
            lock = hold_keychain(args.keychain)
        except OSError:
            say("broken: another key-reach-check run holds this keychain, and the fixed control names cannot be "
                "shared")
            return 2
    probe = Probe(SECURITY, args.keychain, args.signer, CODESIGN, args.timeout)
    previous = {number: signal.getsignal(number) for number in SIGNALS}  # all noted before any is changed
    problems = []
    found = []
    planted_and_proven = False
    held = None  # the launcher's mask, given back at the very end
    try:
        # Held while the handlers change, so none reaches a handler not yet replaced. Then unblocked for the run even
        # if the launcher had blocked one, so a pending signal meets stop instead of waiting out the check.
        held = signal.pthread_sigmask(signal.SIG_BLOCK, SIGNALS)
        for number in SIGNALS:
            signal.signal(number, stop)
        # Only once every handler is in place; if one failed, the signals stay blocked until the cleanup.
        signal.pthread_sigmask(signal.SIG_SETMASK, set(held).difference(SIGNALS))
        if args.mode == "plant":
            plant(probe)
            planted_and_proven = True
        elif args.mode == "remove":
            remove(probe)
        elif args.mode == "probe-only":
            found = probe_only(probe, entries)
        else:
            found = check(args, probe, entries)
    except (Broken, Stopped) as error:
        problems.append(str(error))
    except OSError as error:
        problems.append(f"an operating system call failed: {error.strerror}")
    except Exception as error:  # nothing unexpected may escape: an uncaught exception exits 1, which means reachable
        problems.append(f"an unexpected {type(error).__name__} ended the run")
    finally:
        try:
            ignore_signals()
        except Stopped as error:  # it landed before the line above took effect; stop ignored all three first
            problems.append(str(error))
            ignore_signals()
        if planted_and_proven and not problems:
            probe.planted = []  # proven, and nothing went wrong after: they stay for the session's probe
        problems += probe.remove_planted()
        # Every previous handler comes back under a block, then the launcher's mask in one call, so no handled signal
        # meets a half-restored table, and one the launcher had blocked keeps waiting for the launcher.
        before = signal.pthread_sigmask(signal.SIG_BLOCK, SIGNALS)
        for number, handler in previous.items():
            if handler is not None:  # one set outside Python cannot be put back from Python; the run is ending
                signal.signal(number, handler)
        signal.pthread_sigmask(signal.SIG_SETMASK, held if held is not None else before)
    if problems:
        for problem in problems:
            say(f"broken: {problem}")
        return 2
    for line in probe.skipped:
        say(line)
    for line in found:
        say(line)
    return 1 if found else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
