#!/bin/sh
# Leak guard before every push: check every commit being pushed, its whole tree and its message.
# When git config shellborne.privateFolder is set, also run the private comparison from that folder.
# Plan-Step: P0.20.5
top=$(git rev-parse --show-toplevel) || exit 1
guard="$top/tools/gates/leak-guard"
if [ ! -x "$guard" ]; then
    echo "leak-guard: refused: the guard is missing at tools/gates/leak-guard" >&2
    exit 1
fi
private=$(git config --get shellborne.privateFolder)
if [ -n "$private" ] && [ ! -x "$private/tools/gates/leak-guard-private" ]; then
    echo "leak-guard: refused: shellborne.privateFolder is set but its guard is missing" >&2
    exit 1
fi
remote_name="$1"
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
    if expr "$local_sha" : '0*$' >/dev/null; then
        continue  # deleting a remote branch pushes no content
    fi
    if expr "$remote_sha" : '0*$' >/dev/null; then
        range="$local_sha"  # new branch: check its whole history
    else
        range="$remote_sha..$local_sha"
    fi
    "$guard" commits "$top" "$range" || status=1
    "$top/tools/gates/secrets" commits "$top" "$range" || status=1
    if [ -n "$private" ]; then
        "$private/tools/gates/leak-guard-private" commits "$top" "$range" --private "$private" || status=1
        # The plan check (P0.5.9): every commit not yet on the remote's main cites a step that may start now.
        if [ ! -x "$private/tools/sb-plan" ]; then
            echo "leak-guard: refused: shellborne.privateFolder is set but sb-plan is missing" >&2
            status=1
        else
            # Measure against the main of the remote being pushed to ($1), not a fixed name.
            base=$(git -C "$top" merge-base "$local_sha" "refs/remotes/$remote_name/main" 2>/dev/null || true)
            if [ -n "$base" ]; then
                plan_range="$base..$local_sha"
            else
                plan_range="$range"
            fi
            "$private/tools/sb-plan" check --root "$private" --clone "$top" --range "$plan_range" --branch "$local_ref" || status=1
        fi
    fi
done
exit $status
